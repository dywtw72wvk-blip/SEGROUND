              <CustomName>Programmable Block [Fleet Core]</CustomName>
              <Program>// FLEET SYSTEM 0.3.0-phase3 — HubCore
// Generated by tools/build.py from src/. Paste this whole file into the programmable block.

// ============================================================================
// FLEET SYSTEM — HUB CORE (phase 3)
// Runs on the carrier or base. Registry, Carrier/Base/Auto modes, reference
// frame broadcast, reliable orders, dock manager, formations, provisioning.
// Phase 2 defense: alert levels from the hub's own turrets/sensors and drone
// reports; automatic screen size per alert, launch/recall/charge rotation,
// patrol orbit, engage/disengage of drones' vanilla combat blocks, SAFE switch.
//
// Phase 3 logistics: drone stock target for the Factory PB, [Repair] welders and
// [Rearm] sorters run while drones need them, launch readiness (charge, ammo,
// hull), power-aware charging, carrier jump interlock.
//
// Logistics commands:
//   jump &lt;prep|force|cancel|toggle&gt;   stock &lt;n&gt;   build &lt;n&gt; (forwarded to Factory)
//
// Defense commands:
//   auto &lt;target&gt;   manual &lt;target&gt;   defense &lt;on|off|toggle&gt;
//   alert &lt;auto|green|yellow|red&gt;     safe &lt;on|off|toggle&gt;
//   scramble (launch everything, alert RED)     recall (defense off, all dock)
//
// Commands (toolbar / button panel / Hub UI):
//   escort|follow|launch &lt;target&gt;   hold &lt;target&gt;      goto &lt;target&gt; [GPS:...]
//   dock|rtb|recall &lt;target&gt;        undock &lt;target&gt;    stop &lt;target&gt;
//   formation &lt;name|next&gt;           spacing &lt;m&gt;        mode &lt;auto|carrier|base|next&gt;
//   autortb &lt;on|off|toggle&gt;         waypoint GPS:...   provision
//   forget &lt;callsign&gt;               refresh
// &lt;target&gt; = all | callsign | drone grid name
// ============================================================================
const string SEC = "Hub";

Net net;
Cfg cfg;
readonly Perf perf = new Perf();
IMyBroadcastListener helloL, cmdL;
IMyUnicastListener uni;
IMyShipController refCtl;
IMyTerminalBlock refBlk;

readonly List&lt;IMyTerminalBlock&gt; tmp = new List&lt;IMyTerminalBlock&gt;();
readonly List&lt;IMyShipConnector&gt; dockConns = new List&lt;IMyShipConnector&gt;();
readonly List&lt;IMyShipConnector&gt; allConns = new List&lt;IMyShipConnector&gt;();
readonly List&lt;IMyLandingGear&gt; gears = new List&lt;IMyLandingGear&gt;();
readonly List&lt;IMyProgrammableBlock&gt; pbs = new List&lt;IMyProgrammableBlock&gt;();
readonly List&lt;IMyLargeTurretBase&gt; hubTurrets = new List&lt;IMyLargeTurretBase&gt;();
readonly List&lt;IMySensorBlock&gt; alertSensors = new List&lt;IMySensorBlock&gt;();
readonly List&lt;MyDetectedEntityInfo&gt; sensed = new List&lt;MyDetectedEntityInfo&gt;();
readonly List&lt;Drone&gt; mOut = new List&lt;Drone&gt;(), mReady = new List&lt;Drone&gt;(), mIdle = new List&lt;Drone&gt;();
readonly Dictionary&lt;long, Drone&gt; reg = new Dictionary&lt;long, Drone&gt;();
readonly List&lt;Drone&gt; sorted = new List&lt;Drone&gt;();
readonly Docks docks = new Docks();
readonly List&lt;string&gt; evText = new List&lt;string&gt;();
readonly List&lt;double&gt; evT = new List&lt;double&gt;();
readonly StringBuilder sb = new StringBuilder();

// --- config (Custom Data)
int netId, cfgMode;
string key = "", dockTag = "", ctlTag = "", perfMode = "NORMAL", formC = "WEDGE", formB = "RING";
double spacing, koCfg, rtbBatt, rtbInteg, lostAfter;
bool autoRtb, autoProv, hasWp;
// defense config
bool defense;
int screenG, screenY, screenR, engageAlert;
double leash, launchBatt, rotateBatt, launchInterval, alertCooldown, patrolBase, patrolCarrier;
string alertTag = "[Alert]";
string[] defenseRoles = { "BUSTER", "DRONE" };
Vector3D wp;

// --- persistent runtime (Storage)
int epoch, callCtr;
int alertOverride = -1;   // -1 = automatic
bool safe;
int jumpState = Proto.JUMP_NONE;
long ctr;

// --- runtime
double T, nextNav, nextTask, nextSnap, nextScan, nextProv, nextEcho, nextMode, lastModeT, anchoredFor;
double nextManage, lastRed = -1e9, phase, rate;
int alert = Proto.ALERT_GREEN;
// phase 3 runtime
readonly List&lt;IMyFunctionalBlock&gt; repairBlocks = new List&lt;IMyFunctionalBlock&gt;(), rearmBlocks = new List&lt;IMyFunctionalBlock&gt;();
readonly List&lt;IMyJumpDrive&gt; jumpDrives = new List&lt;IMyJumpDrive&gt;();
readonly List&lt;IMyBatteryBlock&gt; hubBats = new List&lt;IMyBatteryBlock&gt;(), otherBats = new List&lt;IMyBatteryBlock&gt;();
readonly List&lt;Drone&gt; chargeOrder = new List&lt;Drone&gt;();
IMyBroadcastListener facL;
int targetStock, maxChargeC, maxChargeB, facSt = -1, facProg = -1, facBuilt, facDemand, charging, liveStock;
double launchInteg, launchAmmo, rtbAmmo, repairTimeout, powerReserve, nextFac, nextPower, facT = -1e9;
bool factoryInCarrier, repairOn, rearmOn, powerLimited, havePrev;
float hubReserve = -1;
string repairTag = "[Repair]", rearmTag = "[Rearm]", facMsg = "";
Vector3D prevPos;
int mode = Proto.MODE_CARRIER;
bool havePos, moving;
Vector3D lastPos, vel, angVel;
MatrixD M = MatrixD.Identity;
string echo = "", warn = "";

public Program()
{
    net = new Net(IGC);
    uni = IGC.UnicastListener;
    LoadConfig();
    Load();
    Scan();
    UpdateFrame(0);
    mode = Me.CubeGrid.IsStatic || cfgMode == Proto.MODE_BASE ? Proto.MODE_BASE : Proto.MODE_CARRIER;
    Runtime.UpdateFrequency = UpdateFrequency.Update1;
    Log("Hub online, mode " + Proto.ModeName(mode));
}

public void Save()
{
    var ini = new MyIni();
    ini.Set("hub", "epoch", epoch); ini.Set("hub", "ctr", ctr); ini.Set("hub", "calls", callCtr);
    ini.Set("hub", "alertOv", alertOverride); ini.Set("hub", "safe", safe); ini.Set("hub", "jump", jumpState);
    foreach (var d in reg.Values)
    {
        string s = "d" + d.Addr;
        ini.Set(s, "call", d.Call); ini.Set(s, "role", d.Role); ini.Set(s, "grid", d.Grid);
        ini.Set(s, "dir", d.Dir); ini.Set(s, "id", d.Id); ini.Set(s, "conn", d.Conn); ini.Set(s, "man", d.Managed);
        SetV(ini, s, "a", d.A); SetV(ini, s, "b", d.B); SetV(ini, s, "c", d.C);
    }
    Storage = ini.ToString();
}

void Load()
{
    var ini = new MyIni();
    if (!string.IsNullOrEmpty(Storage) &amp;&amp; ini.TryParse(Storage))
    {
        epoch = ini.Get("hub", "epoch").ToInt32(); ctr = ini.Get("hub", "ctr").ToInt64(); callCtr = ini.Get("hub", "calls").ToInt32();
        alertOverride = ini.Get("hub", "alertOv").ToInt32(-1); safe = ini.Get("hub", "safe").ToBoolean();
        jumpState = ini.Get("hub", "jump").ToInt32();
        var secs = new List&lt;string&gt;();
        ini.GetSections(secs);
        foreach (var s in secs)
        {
            long addr;
            if (s.Length &lt; 2 || s[0] != 'd' || !long.TryParse(s.Substring(1), out addr)) continue;
            var d = new Drone { Addr = addr, Restored = true };
            d.Call = ini.Get(s, "call").ToString(""); d.Role = ini.Get(s, "role").ToString(""); d.Grid = ini.Get(s, "grid").ToString("");
            d.Dir = ini.Get(s, "dir").ToInt32(); d.Id = ini.Get(s, "id").ToInt64(); d.Conn = ini.Get(s, "conn").ToInt64();
            d.Managed = ini.Get(s, "man").ToBoolean(IsDefense(d.Role));
            d.A = GetV(ini, s, "a"); d.B = GetV(ini, s, "b"); d.C = GetV(ini, s, "c");
            if (d.Conn != 0) docks.Res[d.Conn] = d.Addr;
            reg[addr] = d;
        }
    }
    if (epoch &lt;= 0) epoch = new Random().Next(1, int.MaxValue);
}

static void SetV(MyIni ini, string s, string k, Vector3D v) { ini.Set(s, k + "x", v.X); ini.Set(s, k + "y", v.Y); ini.Set(s, k + "z", v.Z); }
static Vector3D GetV(MyIni ini, string s, string k) { return new Vector3D(ini.Get(s, k + "x").ToDouble(), ini.Get(s, k + "y").ToDouble(), ini.Get(s, k + "z").ToDouble()); }

void LoadConfig()
{
    cfg = new Cfg(Me, SEC);
    netId = cfg.I("NetId", 1);
    key = cfg.S("Key", "change-me");
    string m = cfg.S("Mode", "Auto").ToUpper();
    cfgMode = m == "CARRIER" ? Proto.MODE_CARRIER : m == "BASE" ? Proto.MODE_BASE : Proto.MODE_AUTO;
    formC = cfg.S("CarrierFormation", "WEDGE").ToUpper();
    formB = cfg.S("BaseFormation", "RING").ToUpper();
    if (!Formation.Valid(formC)) formC = "WEDGE";
    if (!Formation.Valid(formB)) formB = "RING";
    spacing = Math.Max(5, cfg.D("Spacing", 40));
    koCfg = cfg.D("KeepOutRadius", 0);
    dockTag = cfg.S("DockTag", "[Dock]");
    ctlTag = cfg.S("ControllerTag", "");
    autoRtb = cfg.B("AutoRTB", true);
    rtbBatt = cfg.D("RtbBattery", 0.25);
    rtbInteg = cfg.D("RtbIntegrity", 0.6);
    lostAfter = cfg.D("LostAfter", 10);
    autoProv = cfg.B("AutoProvision", true);
    defense = cfg.B("Defense", true);
    defenseRoles = cfg.S("DefenseRoles", "Buster,Drone").ToUpper().Split(new[] { ',', ' ' }, StringSplitOptions.RemoveEmptyEntries);
    screenG = cfg.I("ScreenGreen", 2);
    screenY = cfg.I("ScreenYellow", 4);
    screenR = cfg.I("ScreenRed", -1);
    string ea = cfg.S("EngageAlert", "RED").ToUpper();
    engageAlert = ea == "YELLOW" ? Proto.ALERT_YELLOW : ea == "NEVER" ? 99 : Proto.ALERT_RED;
    leash = cfg.D("Leash", 600);
    launchBatt = cfg.D("LaunchBattery", 0.8);
    rotateBatt = cfg.D("RotateBattery", 0.4);
    launchInterval = Math.Max(0.5, cfg.D("LaunchInterval", 1.0));
    alertCooldown = cfg.D("AlertCooldown", 60);
    alertTag = cfg.S("AlertSensorTag", "[Alert]");
    patrolBase = cfg.D("BasePatrolSpeed", 8);
    patrolCarrier = cfg.D("CarrierPatrolSpeed", 0);
    targetStock = cfg.I("TargetStock", 0);
    factoryInCarrier = cfg.B("FactoryInCarrier", false);
    repairTag = cfg.S("RepairTag", "[Repair]");
    rearmTag = cfg.S("RearmTag", "[Rearm]");
    launchInteg = cfg.D("LaunchIntegrity", 0.95);
    launchAmmo = cfg.D("LaunchAmmo", 0.5);
    rtbAmmo = cfg.D("RtbAmmo", 0.1);
    repairTimeout = cfg.D("RepairTimeout", 180);
    maxChargeC = cfg.I("CarrierMaxCharging", 2);
    maxChargeB = cfg.I("BaseMaxCharging", 0);
    powerReserve = cfg.D("PowerReserve", 0.3);
    perfMode = cfg.S("Perf", "Normal").ToUpper();
    string wps = cfg.S("Waypoint", "");
    string nm;
    hasWp = Util.ParseGps(wps, out wp, out nm);
    cfg.Save();

    net.Configure(netId, key);
    if (helloL != null) IGC.DisableBroadcastListener(helloL);
    if (cmdL != null) IGC.DisableBroadcastListener(cmdL);
    helloL = IGC.RegisterBroadcastListener(net.THello);
    cmdL = IGC.RegisterBroadcastListener(net.TCmd);
    if (facL != null) IGC.DisableBroadcastListener(facL);
    facL = IGC.RegisterBroadcastListener(net.TFacSt);
}

void Scan()
{
    tmp.Clear();
    GridTerminalSystem.GetBlocksOfType(tmp, b =&gt; b.IsSameConstructAs(Me));
    dockConns.Clear(); allConns.Clear(); gears.Clear(); hubTurrets.Clear(); alertSensors.Clear();
    repairBlocks.Clear(); rearmBlocks.Clear(); jumpDrives.Clear(); hubBats.Clear();
    refCtl = null;
    IMyShipController any = null, main = null;
    bool antennaOk = false;
    foreach (var b in tmp)
    {
        var c = b as IMyShipConnector;
        if (c != null) { allConns.Add(c); if (b.CustomName.Contains(dockTag)) dockConns.Add(c); continue; }
        var s = b as IMyShipController;
        if (s != null)
        {
            if (ctlTag.Length &gt; 0 &amp;&amp; b.CustomName.Contains(ctlTag)) refCtl = s;
            if (s.IsMainCockpit) main = s;
            if (any == null) any = s;
            continue;
        }
        var g = b as IMyLandingGear; if (g != null) { gears.Add(g); continue; }
        var tu = b as IMyLargeTurretBase; if (tu != null) { hubTurrets.Add(tu); continue; }
        var se = b as IMySensorBlock; if (se != null) { if (b.CustomName.Contains(alertTag)) alertSensors.Add(se); continue; }
        var jd = b as IMyJumpDrive; if (jd != null) { jumpDrives.Add(jd); continue; }
        var bt = b as IMyBatteryBlock; if (bt != null) { hubBats.Add(bt); continue; }
        var fb = b as IMyFunctionalBlock;
        if (fb != null) { if (b.CustomName.Contains(repairTag)) repairBlocks.Add(fb); else if (b.CustomName.Contains(rearmTag)) rearmBlocks.Add(fb); }
        var a = b as IMyRadioAntenna; if (a != null &amp;&amp; a.IsWorking &amp;&amp; a.EnableBroadcasting) antennaOk = true;
    }
    if (refCtl == null) refCtl = main ?? any;
    refBlk = refCtl != null ? (IMyTerminalBlock)refCtl : Me;
    docks.Bind(dockConns);

    var w = new StringBuilder();
    if (cfg.Error.Length &gt; 0) w.Append(cfg.Error).Append('\n');
    if (refCtl == null) w.Append("WARN: no cockpit/remote: hub frame uses this PB's orientation.\n");
    if (dockConns.Count == 0) w.Append("WARN: no connectors named with " + dockTag + ": docking disabled.\n");
    if (!antennaOk) w.Append("WARN: no working broadcasting antenna: drones cannot hear the hub.\n");
    if (key == "change-me") w.Append("NOTE: change Key in Custom Data before multiplayer.\n");
    warn = w.ToString();
}

public void Main(string arg, UpdateType src)
{
    double dt = Runtime.TimeSinceLastRun.TotalSeconds;
    T += dt;
    perf.Tick(Runtime.LastRunTimeMs, T);
    if (!string.IsNullOrEmpty(arg)) Command(arg.Trim());
    if ((src &amp; (UpdateType.Update1 | UpdateType.Update10 | UpdateType.Update100)) != 0) Tick(dt);
    Echo(echo);
}

void Tick(double dt)
{
    if (T &gt;= nextScan) { Scan(); nextScan = T + 15; }
    UpdateFrame(dt);
    double ps = mode == Proto.MODE_BASE ? patrolBase : patrolCarrier;
    rate = ps &gt; 0 ? ps / Math.Max(10, KeepOutRadius() + spacing) : 0;
    phase = (phase + rate * dt) % (2 * Math.PI);
    if (T &gt;= nextMode) { ResolveMode(T - lastModeT); lastModeT = T; nextMode = T + 0.25; }
    Receive();
    if (T &gt;= nextNav) { SendNav(); nextNav = T + NavPeriod(); }
    if (T &gt;= nextTask) { Tasking(); nextTask = T + 0.5; }
    if (T &gt;= nextSnap) { SendSnapshot(); nextSnap = T + 0.3; }
    if (autoProv &amp;&amp; T &gt;= nextProv) { Provision(false); nextProv = T + 10; }
    if (T &gt;= nextFac) { FactoryLink(); nextFac = T + 2; }
    if (T &gt;= nextPower) { ManagePower(); nextPower = T + 5; }
    if (T &gt;= nextEcho) { BuildEcho(); nextEcho = T + 1; }
    SetFreq();
}

// ---------------------------------------------------------------- frame &amp; mode
void UpdateFrame(double dt)
{
    M = refBlk.WorldMatrix;
    if (refCtl != null)
    {
        var v = refCtl.GetShipVelocities();
        vel = v.LinearVelocity; angVel = v.AngularVelocity;
    }
    else
    {
        Vector3D p = M.Translation;
        if (havePos &amp;&amp; dt &gt; 0) vel = (p - lastPos) / dt;
        lastPos = p; havePos = true; angVel = Vector3D.Zero;
    }
    moving = vel.LengthSquared() &gt; 0.25 || angVel.LengthSquared() &gt; 1e-4;

    // a jump shows up as a &gt;1 km position change between ticks
    if (havePrev &amp;&amp; (M.Translation - prevPos).LengthSquared() &gt; 1e6)
    {
        Log("Jump detected");
        if (jumpState != Proto.JUMP_NONE) { jumpState = Proto.JUMP_NONE; SetJumpDrives(true); nextManage = T + 5; Log("Jump complete: defense resumes"); }
    }
    prevPos = M.Translation; havePrev = true;
}

void ResolveMode(double dt)
{
    bool st = Me.CubeGrid.IsStatic;
    bool anchoredNow = vel.Length() &lt; 0.1 &amp;&amp; (GearLocked() || DockedToStatic());
    anchoredFor = anchoredNow ? anchoredFor + dt : 0;

    int want;
    if (cfgMode == Proto.MODE_CARRIER) want = st ? Proto.MODE_BASE : Proto.MODE_CARRIER;
    else if (cfgMode == Proto.MODE_BASE) want = Proto.MODE_BASE;
    else want = (st || anchoredFor &gt; 30) ? Proto.MODE_BASE : Proto.MODE_CARRIER;

    if (want != mode)
    {
        mode = want;
        Log("Mode -&gt; " + Proto.ModeName(mode) + (cfgMode == Proto.MODE_CARRIER &amp;&amp; st ? " (grid is static)" : ""));
        foreach (var d in reg.Values) if (d.Dir == Proto.O_ESCORT) d.SlotOk = false;
        nextTask = T;
    }
}

bool GearLocked() { foreach (var g in gears) if (g.IsLocked) return true; return false; }

bool DockedToStatic()
{
    foreach (var c in allConns)
        if (c.Status == MyShipConnectorStatus.Connected &amp;&amp; c.OtherConnector != null &amp;&amp; c.OtherConnector.CubeGrid.IsStatic) return true;
    return false;
}

double KeepOutRadius() { return koCfg &gt; 0 ? koCfg : Me.CubeGrid.WorldVolume.Radius; }

double NavPeriod()
{
    if (mode == Proto.MODE_BASE &amp;&amp; !moving) return 1.0;
    return perfMode == "HIGH" ? 0.05 : perfMode == "LOW" ? 0.16 : 0.1;
}

void SetFreq()
{
    UpdateFrequency want = perfMode == "HIGH" ? UpdateFrequency.Update1
                         : perfMode == "LOW" ? UpdateFrequency.Update10
                         : (mode == Proto.MODE_CARRIER || moving ? UpdateFrequency.Update1 : UpdateFrequency.Update10);
    if (Runtime.UpdateFrequency != want) Runtime.UpdateFrequency = want;
}

void SendNav()
{
    net.SendNav(M.Translation, vel, M.Forward, M.Up, angVel, Me.CubeGrid.WorldVolume.Center, KeepOutRadius(), mode, alert, phase, rate);
}

// ---------------------------------------------------------------- messages
void Receive()
{
    while (helloL.HasPendingMessage)
    {
        var m = helloL.AcceptMessage();
        string role, grid; long caps; double acc, spd;
        if (!net.ReadHello(m, out role, out caps, out acc, out spd, out grid)) continue;
        var d = GetOrAdd(m.Source, role);
        d.Caps = caps; d.MaxAccel = acc; d.MaxSpeed = spd; d.Grid = grid;
        Register(d);
    }

    while (uni.HasPendingMessage)
    {
        var m = uni.AcceptMessage();
        MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt; s;
        if (!net.ReadStatus(m, out s)) continue;

        Drone d;
        if (!reg.TryGetValue(m.Source, out d))
        {
            d = GetOrAdd(m.Source, s.Item2.Item1);
            Register(d);
        }
        bool wasDocked = d.Docked;
        d.Role = s.Item2.Item1; d.State = s.Item2.Item2; d.Task = s.Item2.Item3; d.Ack = s.Item2.Item4; d.DockId = s.Item2.Item5;
        d.Pos = s.Item3.Item1; d.Vel = s.Item3.Item2;
        d.Batt = s.Item4.Item1; d.H2 = s.Item4.Item2; d.Cargo = s.Item4.Item3; d.Integ = s.Item4.Item4; d.Ammo = s.Item4.Item5; d.Flags = s.Item4.Item6;
        d.Seen = T;

        if (d.LostFlag)
        {
            d.LostFlag = false;
            if (d.Restored) { d.Restored = false; Log(d.Call + " reconnected"); Reissue(d); }
            else Log(d.Call + " link restored");
        }
        if (!wasDocked &amp;&amp; d.Docked) { Log(d.Call + " docked"); nextProv = T + 1; d.DockedSince = T; nextPower = T + 1; }
        if (wasDocked &amp;&amp; !d.Docked) Log(d.Call + " undocked");
        if (d.Acked) { d.Tries = 0; d.Unresp = false; }
    }

    while (cmdL.HasPendingMessage)
    {
        var s = cmdL.AcceptMessage().Data as string;
        if (s != null) Command(s);
    }
}

Drone GetOrAdd(long addr, string role)
{
    Drone d;
    if (reg.TryGetValue(addr, out d)) return d;
    d = new Drone { Addr = addr, Role = role, Call = NewCall(role), Seen = T, LostFlag = false, Managed = IsDefense(role) };
    reg[addr] = d;
    Log("New drone " + d.Call);
    return d;
}

string NewCall(string role)
{
    callCtr++;
    string r = (role ?? "DRONE").ToUpper();
    if (r.Length &gt; 6) r = r.Substring(0, 6);
    return r + "-" + callCtr.ToString("00");
}

// ---------------------------------------------------------------- orders
long NextSeq() { ctr++; return ((long)epoch &lt;&lt; 32) | (ctr &amp; 0xFFFFFFFFL); }

void Register(Drone d)
{
    net.SendOrder(d.Addr, NextSeq(), Proto.O_REGISTER, Vector3D.Zero, Vector3D.Zero, Vector3D.Zero, 0, d.Call);
    Reissue(d);   // directive needs a newer seq than the REGISTER
}

void Issue(Drone d, int dir, Vector3D a, Vector3D b, Vector3D c, long id)
{
    d.Dir = dir; d.A = a; d.B = b; d.C = c; d.Id = id;
    d.Seq = NextSeq(); d.Tries = 0;
    SendOrd(d);
}

void Reissue(Drone d)
{
    if (d.Dir == Proto.O_NONE) return;
    if (d.Dir == Proto.O_ESCORT &amp;&amp; !d.SlotOk) { nextTask = T; return; }
    if (d.Dir == Proto.O_DOCK &amp;&amp; d.Conn == 0) { nextTask = T; return; }
    d.Seq = NextSeq(); d.Tries = 0;
    SendOrd(d);
}

void SendOrd(Drone d)
{
    net.SendOrder(d.Addr, d.Seq, d.Dir, d.A, d.B, d.C, d.Id, "");
    d.Sent = T; d.Tries++;
}

void OrderEscort(Drone d) { d.Dir = Proto.O_ESCORT; d.SlotOk = false; d.Seq = 0; nextTask = T; }

void OrderDock(Drone d)
{
    d.Dir = Proto.O_DOCK; d.SlotOk = false; d.Seq = 0;
    var c = docks.Reserve(d);
    if (c != null) SendDock(d, c);
    else Log(d.Call + " waiting for a free dock");
}

void SendDock(Drone d, IMyShipConnector c)
{
    MatrixD cm = c.WorldMatrix;
    Issue(d, Proto.O_DOCK, HubFrame.ToLocal(M, cm.Translation), HubFrame.DirToLocal(M, cm.Forward), HubFrame.DirToLocal(M, cm.Up), c.EntityId);
}

// ---------------------------------------------------------------- tasking (2 Hz)
void Tasking()
{
    sorted.Clear();
    foreach (var d in reg.Values) sorted.Add(d);
    sorted.Sort((x, y) =&gt; string.Compare(x.Call, y.Call, StringComparison.Ordinal));

    foreach (var d in sorted)
    {
        // lost detection
        if (!d.LostFlag &amp;&amp; T - d.Seen &gt; lostAfter) { d.LostFlag = true; Log(d.Call + " LOST"); }
        if (d.LostFlag)
        {
            if (d.Conn != 0 &amp;&amp; T - d.Seen &gt; 60) docks.Release(d);
            continue;
        }

        // retries with backoff
        if (!d.Acked &amp;&amp; T - d.Sent &gt; Math.Min(8, 0.75 * (1 &lt;&lt; Math.Min(d.Tries, 4))))
        {
            SendOrd(d);
            if (d.Tries &gt; 6 &amp;&amp; !d.Unresp) { d.Unresp = true; Log(d.Call + " not acknowledging orders"); }
        }

        // keep reservations in sync with reality
        if (d.Docked &amp;&amp; d.DockId != 0 &amp;&amp; docks.Get(d.DockId) != null) docks.Claim(d, d.DockId);
        else if (d.Dir != Proto.O_DOCK &amp;&amp; d.Conn != 0 &amp;&amp; !d.Docked) docks.Release(d);

        // auto RTB
        if (autoRtb &amp;&amp; d.Dir != Proto.O_DOCK &amp;&amp; !d.Docked &amp;&amp; docks.List.Count &gt; 0)
        {
            string why = null;
            if (d.Batt &gt;= 0 &amp;&amp; d.Batt &lt; rtbBatt) why = "battery " + Util.Pct(d.Batt);
            else if (d.Integ &lt; rtbInteg) why = "damage, hull " + Util.Pct(d.Integ);
            else if (d.Ammo &gt;= 0 &amp;&amp; d.Ammo &lt; rtbAmmo) why = "ammo " + Util.Pct(d.Ammo);
            else if ((d.Flags &amp; Proto.F_WANT_RTB) != 0) why = "drone request";
            if (why != null) { Log(d.Call + " auto-RTB (" + why + ")"); OrderDock(d); }
        }

        // dock queue
        if (d.Dir == Proto.O_DOCK &amp;&amp; (d.Conn == 0 || docks.Get(d.Conn) == null))
        {
            var c = docks.Reserve(d);
            if (c != null) SendDock(d, c);
        }
    }

    UpdateAlert();
    Logistics();
    Manage();

    // formation slots (c = engage flag, leash, patrol flag)
    string form = mode == Proto.MODE_BASE ? formB : formC;
    double R = KeepOutRadius();
    Vector3D lc = HubFrame.ToLocal(M, Me.CubeGrid.WorldVolume.Center);
    int n = 0;
    foreach (var d in sorted) if (d.Dir == Proto.O_ESCORT &amp;&amp; !d.LostFlag) n++;
    int i = 0;
    foreach (var d in sorted)
    {
        if (d.Dir != Proto.O_ESCORT || d.LostFlag) continue;
        Vector3D pat = Formation.Offset(form, i++, n, spacing, R);
        Vector3D off = lc + pat;
        Vector3D face = mode == Proto.MODE_BASE ? Formation.Outward(pat) : new Vector3D(0, 0, -1);
        bool engage = !safe &amp;&amp; IsDefense(d.Role) &amp;&amp; alert &gt;= engageAlert;
        Vector3D c = new Vector3D(engage ? 1 : 0, leash, rate &gt; 0 ? 1 : 0);
        if (!d.SlotOk || (off - d.A).LengthSquared() &gt; 0.25 || (face - d.B).LengthSquared() &gt; 0.01 || (c - d.C).LengthSquared() &gt; 0.01)
        {
            Issue(d, Proto.O_ESCORT, off, face, c, 0);
            d.SlotOk = true;
        }
    }
}

// ---------------------------------------------------------------- defense
bool IsDefense(string role) { return Array.IndexOf(defenseRoles, (role ?? "").ToUpper()) &gt;= 0; }

Action&lt;Drone&gt; Manual(Action&lt;Drone&gt; act) { return d =&gt; { d.Managed = false; act(d); }; }

// GREEN: quiet. YELLOW: [Alert] sensor sees an enemy, or RED in the last AlertCooldown s.
// RED: a hub turret has a target, or a drone reports its turrets have one.
void UpdateAlert()
{
    bool red = false, yellow = false;
    foreach (var t in hubTurrets) if (!t.Closed &amp;&amp; t.IsWorking &amp;&amp; t.HasTarget) { red = true; break; }
    if (!red) foreach (var d in reg.Values) if (!d.LostFlag &amp;&amp; (d.Flags &amp; Proto.F_CONTACT) != 0) { red = true; break; }
    foreach (var s in alertSensors)
    {
        if (yellow || s.Closed || !s.IsWorking) continue;
        sensed.Clear();
        s.DetectedEntities(sensed);
        foreach (var e in sensed) if (e.Relationship == MyRelationsBetweenPlayerAndBlock.Enemies) { yellow = true; break; }
    }
    if (red) lastRed = T;
    int a = red ? Proto.ALERT_RED : (yellow || T - lastRed &lt; alertCooldown) ? Proto.ALERT_YELLOW : Proto.ALERT_GREEN;
    if (alertOverride &gt;= 0) a = alertOverride;
    if (a != alert)
    {
        Log("ALERT " + Proto.AlertName(a) + (alertOverride &gt;= 0 ? " (forced)" : ""));
        alert = a; nextManage = T;
    }
}

// Keeps the right number of managed drones on screen for the alert level,
// launches the best-charged, recalls surplus, rotates low-battery drones out.
// One action per LaunchInterval so departures from the docks are staggered.
void Manage()
{
    if (!defense || jumpState != Proto.JUMP_NONE || T &lt; nextManage) return;
    mOut.Clear(); mReady.Clear(); mIdle.Clear();
    int total = 0;
    foreach (var d in sorted)
    {
        if (!d.Managed || d.LostFlag) continue;
        total++;
        if (d.Dir == Proto.O_ESCORT) mOut.Add(d);
        else if (d.Docked) { if (LaunchReady(d)) mReady.Add(d); }
        else if (d.Dir != Proto.O_DOCK) mIdle.Add(d);
    }
    int target = alert == Proto.ALERT_RED ? screenR : alert == Proto.ALERT_YELLOW ? screenY : screenG;
    if (target &lt; 0 || target &gt; total) target = total;
    double interval = alertOverride == Proto.ALERT_RED ? 0.5 : launchInterval;
    bool canDock = docks.List.Count &gt; 0;

    if (mOut.Count &lt; target)
    {
        Drone pick = mIdle.Count &gt; 0 ? mIdle[0] : Best(mReady, true);
        if (pick != null) { OrderEscort(pick); Log("Launch " + pick.Call + " (" + Proto.AlertName(alert) + ")"); nextManage = T + interval; return; }
    }
    else if (mIdle.Count &gt; 0 &amp;&amp; canDock)
    {
        OrderDock(mIdle[0]); nextManage = T + interval; return;
    }
    if (mOut.Count &gt; target &amp;&amp; canDock)
    {
        Drone pick = Best(mOut, false);
        OrderDock(pick); Log("Stand down " + pick.Call); nextManage = T + interval; return;
    }
    if (mReady.Count &gt; 0 &amp;&amp; canDock)
    {
        Drone low = Best(mOut, false);
        if (low != null &amp;&amp; low.Batt &gt;= 0 &amp;&amp; low.Batt &lt; rotateBatt)
        {
            Drone fresh = Best(mReady, true);
            OrderEscort(fresh); OrderDock(low);
            Log("Rotate: " + fresh.Call + " out, " + low.Call + " in to charge");
            nextManage = T + interval;
        }
    }
}

// Highest (or lowest) battery drone in a list
static Drone Best(List&lt;Drone&gt; l, bool highest)
{
    Drone b = null;
    foreach (var d in l) if (b == null || (highest ? d.Batt &gt; b.Batt : d.Batt &lt; b.Batt)) b = d;
    return b;
}

// ---------------------------------------------------------------- logistics (phase 3)
bool LaunchReady(Drone d)
{
    if (d.Batt &gt;= 0 &amp;&amp; d.Batt &lt; launchBatt) return false;
    bool waited = T - d.DockedSince &gt; repairTimeout;   // never strand a drone that can't be fully fixed
    if (d.Integ &lt; launchInteg &amp;&amp; repairBlocks.Count &gt; 0 &amp;&amp; !waited) return false;
    if (d.Ammo &gt;= 0 &amp;&amp; d.Ammo &lt; launchAmmo &amp;&amp; rearmBlocks.Count &gt; 0 &amp;&amp; !waited) return false;
    return true;
}

void SetAll(List&lt;IMyFunctionalBlock&gt; l, bool on) { foreach (var b in l) if (!b.Closed &amp;&amp; b.Enabled != on) b.Enabled = on; }

void SetJumpDrives(bool on) { foreach (var j in jumpDrives) if (!j.Closed &amp;&amp; j.Enabled != on) j.Enabled = on; }

// repair/rearm on demand + jump interlock (2 Hz from Tasking)
void Logistics()
{
    // Right after a paste/load, lock any dock that has a drone sitting in range
    // (pre-docked blueprints). Only during start-up, so undocking drones are never re-grabbed.
    if (T &lt; 30) foreach (var c in docks.List) if (!c.Closed &amp;&amp; c.Status == MyShipConnectorStatus.Connectable) c.Connect();

    bool dmg = false, any = false, allDocked = true;
    foreach (var d in reg.Values)
    {
        if (d.LostFlag) continue;
        if (d.Docked) { any = true; if (d.Integ &lt; 0.995) dmg = true; }
        else allDocked = false;
    }
    if (dmg != repairOn) { repairOn = dmg; if (repairBlocks.Count &gt; 0) Log(dmg ? "Repair bay ON" : "Repair bay idle"); }
    rearmOn = any;
    SetAll(repairBlocks, repairOn);
    SetAll(rearmBlocks, rearmOn);

    if (jumpState == Proto.JUMP_PREP)
    {
        SetJumpDrives(false);
        if (allDocked) { jumpState = Proto.JUMP_READY; SetJumpDrives(true); Log("JUMP READY: all drones docked"); }
    }
}

// Tell the Factory PB how many drones to build; read its status
void FactoryLink()
{
    liveStock = 0;
    foreach (var d in reg.Values) if (IsDefense(d.Role) &amp;&amp; (!d.LostFlag || T - d.Seen &lt; 120)) liveStock++;
    bool allowed = targetStock &gt; 0 &amp;&amp; (mode == Proto.MODE_BASE || factoryInCarrier) &amp;&amp; jumpState == Proto.JUMP_NONE &amp;&amp; T &gt; 30;
    IGC.SendBroadcastMessage(net.TFac, allowed ? Math.Max(0, targetStock - liveStock) : 0, TransmissionDistance.CurrentConstruct);

    while (facL.HasPendingMessage)
    {
        var st = facL.AcceptMessage().Data as string;
        if (st == null) continue;
        var f = st.Split('|');
        if (f.Length &lt; 5) continue;
        int v;
        facSt = int.TryParse(f[0], out v) ? v : -1; facProg = int.TryParse(f[1], out v) ? v : -1;
        facBuilt = int.TryParse(f[2], out v) ? v : 0; facDemand = int.TryParse(f[3], out v) ? v : 0;
        if (f[4] != facMsg &amp;&amp; f[4].Length &gt; 0) Log("Factory: " + f[4]);
        facMsg = f[4]; facT = T;
    }
}

// Limit how many docked drones charge at once (carrier power budget) and stop
// charging entirely while the hub's own batteries are below PowerReserve.
// Held drones get their batteries switched off and run on hub power; drones
// re-enable their batteries themselves before undocking.
void ManagePower()
{
    double cur = 0, max = 0;
    foreach (var b in hubBats) if (!b.Closed &amp;&amp; b.IsFunctional) { cur += b.CurrentStoredPower; max += b.MaxStoredPower; }
    hubReserve = max &gt; 0 ? (float)(cur / max) : -1;
    bool low = hubReserve &gt;= 0 &amp;&amp; hubReserve &lt; powerReserve;
    int maxC = mode == Proto.MODE_BASE ? maxChargeB : maxChargeC;
    if (maxC &lt;= 0 &amp;&amp; !low &amp;&amp; !powerLimited) { charging = -1; return; }

    otherBats.Clear();
    GridTerminalSystem.GetBlocksOfType(otherBats, b =&gt; !b.IsSameConstructAs(Me));
    chargeOrder.Clear();
    foreach (var d in reg.Values) if (!d.LostFlag &amp;&amp; d.Docked &amp;&amp; d.DockId != 0) chargeOrder.Add(d);
    chargeOrder.Sort((x, y) =&gt; y.Batt.CompareTo(x.Batt));   // fullest first: gets drones ready soonest
    int allowed = low ? 0 : (maxC &lt;= 0 ? int.MaxValue : maxC);
    charging = 0;
    bool limited = false;
    foreach (var d in chargeOrder)
    {
        IMyCubeGrid g = null;
        foreach (var c in allConns)
            if (c.EntityId == d.DockId &amp;&amp; c.Status == MyShipConnectorStatus.Connected &amp;&amp; c.OtherConnector != null) { g = c.OtherConnector.CubeGrid; break; }
        if (g == null) continue;
        bool full = d.Batt &lt; 0 || d.Batt &gt;= 0.99f;
        bool on = full || charging &lt; allowed;
        if (!full &amp;&amp; on) charging++;
        if (!on) limited = true;
        foreach (var b in otherBats)
        {
            if (b.CubeGrid != g || b.Closed) continue;
            if (b.Enabled != on) b.Enabled = on;
            if (on &amp;&amp; b.ChargeMode != ChargeMode.Recharge) b.ChargeMode = ChargeMode.Recharge;
        }
    }
    if (limited != powerLimited) Log(limited ? (low ? "Hub power low: drone charging paused" : "Charging limited to " + allowed + " drone(s)") : "Drone charging unrestricted");
    powerLimited = limited;
}

// ---------------------------------------------------------------- commands
void Command(string raw)
{
    string[] t = raw.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    if (t.Length == 0) return;
    string v = t[0].ToLower();
    string tgt = t.Length &gt; 1 ? t[1] : "all";
    switch (v)
    {
        case "escort": case "follow": case "launch":
            ForTargets(tgt, Manual(OrderEscort));
            break;
        case "hold":
            ForTargets(tgt, Manual(d =&gt; Issue(d, Proto.O_HOLD, Vector3D.Zero, Vector3D.Zero, Vector3D.Zero, 0)));
            break;
        case "goto":
            {
                Vector3D p; string nm;
                if (!Util.ParseGps(raw, out p, out nm))
                {
                    if (!hasWp) { Log("goto: give GPS:... or set a waypoint first"); break; }
                    p = wp;
                }
                if (tgt.StartsWith("GPS:")) tgt = "all";
                ForTargets(tgt, Manual(d =&gt; Issue(d, Proto.O_GOTO, p, Vector3D.Zero, Vector3D.Zero, 0)));
            }
            break;
        case "dock": case "rtb":
            if (docks.List.Count == 0) { Log("No docks tagged " + dockTag); break; }
            ForTargets(tgt, Manual(OrderDock));
            break;
        case "undock":
            ForTargets(tgt, Manual(d =&gt; Issue(d, Proto.O_UNDOCK, Vector3D.Zero, Vector3D.Zero, Vector3D.Zero, 0)));
            break;
        case "stop":
            ForTargets(tgt, Manual(d =&gt; Issue(d, Proto.O_STOP, Vector3D.Zero, Vector3D.Zero, Vector3D.Zero, 0)));
            break;
        case "recall":
            defense = false; cfg.Set("Defense", "false"); alertOverride = -1;
            Log("RECALL: defense paused, all drones docking");
            if (docks.List.Count &gt; 0) ForTargets("all", OrderDock);
            break;
        case "scramble":
            defense = true; cfg.Set("Defense", "true"); alertOverride = Proto.ALERT_RED;
            foreach (var d in reg.Values) if (IsDefense(d.Role)) d.Managed = true;
            Log("SCRAMBLE: launching all defense drones (alert RED until 'alert auto')");
            nextManage = T; nextTask = T;
            break;
        case "auto":
            ForTargets(tgt, d =&gt; d.Managed = true);
            Log("Automatic defense control: " + tgt); nextManage = T;
            break;
        case "manual":
            ForTargets(tgt, d =&gt; d.Managed = false);
            Log("Manual control: " + tgt);
            break;
        case "defense":
            {
                string a = tgt.ToLower();
                defense = a == "on" ? true : a == "off" ? false : !defense;
                cfg.Set("Defense", defense ? "true" : "false");
                Log("Defense manager " + (defense ? "ON" : "OFF")); nextManage = T;
            }
            break;
        case "alert":
            {
                string a = tgt.ToUpper();
                int ov = a == "GREEN" ? 0 : a == "YELLOW" ? 1 : a == "RED" ? 2 : a == "AUTO" || a == "ALL" ? -1 : a == "NEXT" ? (alertOverride + 2) % 4 - 1 : -2;
                if (ov == -2) { Log("alert: auto | green | yellow | red | next"); break; }
                alertOverride = ov;
                Log("Alert " + (ov &lt; 0 ? "automatic" : "forced " + Proto.AlertName(ov)));
                nextTask = T;
            }
            break;
        case "jump":
            {
                string a = tgt.ToLower();
                if (a == "toggle" || a == "all") a = jumpState == Proto.JUMP_NONE ? "prep" : "cancel";
                if (a == "prep")
                {
                    jumpState = Proto.JUMP_PREP; SetJumpDrives(false);
                    Log("JUMP PREP: recalling all drones, jump drives locked");
                    if (docks.List.Count &gt; 0) foreach (var d in reg.Values) if (!d.LostFlag &amp;&amp; !d.Docked) OrderDock(d);
                    nextTask = T;
                }
                else if (a == "force") { jumpState = Proto.JUMP_READY; SetJumpDrives(true); Log("JUMP FORCED: drives unlocked, undocked drones will be left behind"); }
                else if (a == "cancel" || a == "off") { jumpState = Proto.JUMP_NONE; SetJumpDrives(true); Log("Jump prep cancelled"); nextManage = T; }
                else Log("jump: prep | force | cancel | toggle");
            }
            break;
        case "stock":
            {
                int n;
                if (t.Length &gt; 1 &amp;&amp; int.TryParse(t[1], out n) &amp;&amp; n &gt;= 0) { targetStock = n; cfg.Set("TargetStock", n.ToString()); Log("Target stock " + n + (n == 0 ? " (factory off)" : "")); }
                else Log("stock: number of defense drones to keep (0 = off)");
            }
            break;
        case "build":
            IGC.SendBroadcastMessage(net.TFac + "cmd", raw, TransmissionDistance.CurrentConstruct);
            Log("Factory: " + Util.Clean(raw));
            break;
        case "safe":
            {
                string a = tgt.ToLower();
                safe = a == "on" ? true : a == "off" ? false : !safe;
                Log(safe ? "SAFE: all combat blocks standing down" : "SAFE off: engagement allowed");
                nextTask = T;
            }
            break;
        case "formation":
            {
                string cur = mode == Proto.MODE_BASE ? formB : formC;
                string f = t.Length &gt; 1 ? t[1].ToUpper() : "NEXT";
                if (f == "NEXT") f = Formation.Next(cur);
                if (!Formation.Valid(f)) { Log("Formations: " + string.Join(", ", Formation.Names)); break; }
                if (mode == Proto.MODE_BASE) { formB = f; cfg.Set("BaseFormation", f); }
                else { formC = f; cfg.Set("CarrierFormation", f); }
                Log(Proto.ModeName(mode) + " formation " + f);
                nextTask = T;
            }
            break;
        case "spacing":
            {
                double s;
                if (t.Length &gt; 1 &amp;&amp; Util.ParseD(t[1], out s) &amp;&amp; s &gt;= 5) { spacing = s; cfg.Set("Spacing", Util.Num(s)); Log("Spacing " + (int)s + "m"); nextTask = T; }
                else Log("spacing: number &gt;= 5");
            }
            break;
        case "mode":
            {
                string m = tgt.ToUpper();
                int nm = m == "CARRIER" ? 1 : m == "BASE" ? 2 : m == "AUTO" ? 0 : m == "NEXT" || m == "ALL" ? (cfgMode + 1) % 3 : -1;
                if (nm &lt; 0) { Log("mode: auto | carrier | base | next"); break; }
                cfgMode = nm; anchoredFor = 0;
                cfg.Set("Mode", Proto.ModeName(cfgMode));
                Log("Mode setting " + Proto.ModeName(cfgMode));
            }
            break;
        case "autortb":
            {
                string a = tgt.ToLower();
                autoRtb = a == "on" ? true : a == "off" ? false : !autoRtb;
                cfg.Set("AutoRTB", autoRtb ? "true" : "false");
                Log("Auto-RTB " + (autoRtb ? "ON" : "OFF"));
            }
            break;
        case "waypoint":
            {
                Vector3D p; string nm;
                if (Util.ParseGps(raw, out p, out nm)) { wp = p; hasWp = true; cfg.Set("Waypoint", Util.Gps(nm, p)); Log("Waypoint set: " + Util.Clean(nm)); }
                else Log("waypoint: paste a GPS:... string");
            }
            break;
        case "provision":
            Provision(true);
            break;
        case "forget":
            {
                Drone hit = null;
                foreach (var d in reg.Values) if (d.Call.Equals(tgt, StringComparison.OrdinalIgnoreCase)) hit = d;
                if (hit == null) { Log("forget: no drone " + tgt); break; }
                docks.Release(hit); reg.Remove(hit.Addr); Log("Forgot " + hit.Call);
            }
            break;
        case "refresh": case "reload":
            LoadConfig(); Scan(); Log("Config reloaded");
            break;
        default:
            Log("Unknown command: " + Util.Clean(raw));
            break;
    }
}

void ForTargets(string tgt, Action&lt;Drone&gt; act)
{
    bool all = tgt.Equals("all", StringComparison.OrdinalIgnoreCase);
    int n = 0;
    foreach (var d in reg.Values)
    {
        bool hit = all ? !d.LostFlag
                       : d.Call.Equals(tgt, StringComparison.OrdinalIgnoreCase) || d.Grid.Equals(tgt, StringComparison.OrdinalIgnoreCase);
        if (hit) { act(d); n++; }
    }
    if (n == 0) Log(all ? "No drones online" : "No drone matches '" + Util.Clean(tgt) + "'");
}

// Push NetId/Key into connected (docked or merged) drone PBs and restart their config
void Provision(bool verbose)
{
    pbs.Clear();
    GridTerminalSystem.GetBlocksOfType(pbs, b =&gt; !b.IsSameConstructAs(Me) &amp;&amp; b.CustomData.Contains("[Drone]"));
    int n = 0;
    foreach (var pb in pbs)
    {
        var ini = new MyIni();
        if (!ini.TryParse(pb.CustomData)) continue;
        if (ini.Get("Drone", "NetId").ToInt32(0) == netId &amp;&amp; ini.Get("Drone", "Key").ToString("") == key) continue;
        ini.Set("Drone", "NetId", netId);
        ini.Set("Drone", "Key", key);
        pb.CustomData = ini.ToString();
        pb.TryRun("provision");
        n++;
        Log("Provisioned " + Util.Clean(pb.CubeGrid.CustomName));
    }
    if (verbose &amp;&amp; n == 0) Log("Provision: nothing to update (" + pbs.Count + " drone PBs connected)");
}

// ---------------------------------------------------------------- UI snapshot &amp; echo
// Integers only, so no locale issues. Format documented in Hub UI.
void SendSnapshot()
{
    sb.Clear();
    int online = 0;
    foreach (var d in sorted) if (!d.LostFlag) online++;
    sb.Append("H|").Append(mode).Append('|').Append(cfgMode).Append('|').Append(mode == Proto.MODE_BASE ? formB : formC)
      .Append('|').Append((int)spacing).Append('|').Append(autoRtb ? 1 : 0).Append('|').Append(docks.Free()).Append('|').Append(docks.List.Count)
      .Append('|').Append(hasWp ? 1 : 0).Append('|').Append((int)(perf.Avg * 1000)).Append('|').Append(online)
      .Append('|').Append(Util.Clean(Me.CubeGrid.CustomName))
      .Append('|').Append(alert).Append('|').Append(alertOverride &gt;= 0 ? 1 : 0).Append('|').Append(safe ? 1 : 0).Append('|').Append(defense ? 1 : 0)
      .Append('|').Append(jumpState)
      .Append('\n');
    foreach (var d in sorted)
    {
        Vector3D lp = HubFrame.ToLocal(M, d.Pos);
        sb.Append("D|").Append(d.Call).Append('|').Append(Util.Clean(d.Role)).Append('|').Append(d.State).Append('|').Append(d.Dir)
          .Append('|').Append(Util.Milli(d.Batt)).Append('|').Append(Util.Milli(d.Integ)).Append('|').Append(Util.Milli(d.Cargo)).Append('|').Append(Util.Milli(d.H2))
          .Append('|').Append((long)lp.Length()).Append('|').Append((int)(d.Vel - vel).Length()).Append('|').Append(d.Flags)
          .Append('|').Append(d.LostFlag ? (int)Math.Min(99999, Math.Max(0, T - d.Seen)) : -1).Append('|').Append(d.Unresp ? 1 : 0)
          .Append('|').Append(d.Dir == Proto.O_DOCK &amp;&amp; d.Conn == 0 ? 1 : 0).Append('|').Append(d.Acked ? 1 : 0)
          .Append('|').Append((long)lp.X).Append('|').Append((long)lp.Y).Append('|').Append((long)lp.Z)
          .Append('|').Append(d.Managed ? 1 : 0).Append('|').Append(Util.Milli(d.Ammo)).Append('\n');
    }
    // hangar: docks, factory, logistics
    foreach (var c in docks.List)
    {
        if (c.Closed) continue;
        Drone occ = null, res = null;
        foreach (var d in sorted) { if (d.Docked &amp;&amp; d.DockId == c.EntityId) occ = d; if (d.Conn == c.EntityId) res = d; }
        int st = occ != null || c.Status == MyShipConnectorStatus.Connected ? 2 : res != null ? 1 : 0;
        Drone who = occ ?? res;
        sb.Append("K|").Append(Util.Clean(c.CustomName)).Append('|').Append(st).Append('|').Append(who != null ? who.Call : "")
          .Append('|').Append(who != null ? Util.Milli(who.Batt) : -1).Append('|').Append(who != null ? Util.Milli(who.Integ) : -1).Append('\n');
    }
    if (T - facT &lt; 10)
        sb.Append("F|").Append(facSt).Append('|').Append(facProg).Append('|').Append(facBuilt).Append('|').Append(facDemand).Append('|').Append(facMsg).Append('\n');
    sb.Append("P|").Append(repairOn ? 1 : 0).Append('|').Append(rearmOn ? 1 : 0).Append('|').Append(charging)
      .Append('|').Append(mode == Proto.MODE_BASE ? maxChargeB : maxChargeC).Append('|').Append(Util.Milli(hubReserve))
      .Append('|').Append(targetStock).Append('|').Append(liveStock).Append('|').Append(repairBlocks.Count).Append('|').Append(rearmBlocks.Count).Append('\n');
    for (int i = 0; i &lt; evText.Count; i++) sb.Append("E|").Append((int)(T - evT[i])).Append('|').Append(evText[i]).Append('\n');
    IGC.SendBroadcastMessage(net.TSnap, sb.ToString(), TransmissionDistance.CurrentConstruct);
}

void Log(string s)
{
    evText.Add(Util.Clean(s)); evT.Add(T);
    if (evText.Count &gt; 8) { evText.RemoveAt(0); evT.RemoveAt(0); }
}

void BuildEcho()
{
    int online = 0;
    foreach (var d in reg.Values) if (!d.LostFlag) online++;
    var e = new StringBuilder();
    e.Append("FLEET HUB CORE  net ").Append(netId).Append('\n');
    e.Append("Mode: ").Append(Proto.ModeName(mode)).Append(" (setting ").Append(Proto.ModeName(cfgMode)).Append(")\n");
    e.Append("Drones: ").Append(online).Append(" online / ").Append(reg.Count).Append("   Docks free: ").Append(docks.Free()).Append('/').Append(docks.List.Count).Append('\n');
    e.Append("Formation: ").Append(mode == Proto.MODE_BASE ? formB : formC).Append(' ').Append((int)spacing).Append("m   Auto-RTB: ").Append(autoRtb ? "on" : "off").Append('\n');
    if (jumpState != Proto.JUMP_NONE) e.Append(jumpState == Proto.JUMP_PREP ? "JUMP PREP: waiting for drones to dock\n" : "JUMP READY\n");
    if (targetStock &gt; 0) e.Append("Stock ").Append(liveStock).Append('/').Append(targetStock).Append("   Factory: ").Append(T - facT &lt; 10 ? Proto.FactoryName(facSt) : "no link").Append('\n');
    e.Append("Alert: ").Append(Proto.AlertName(alert)).Append(alertOverride &gt;= 0 ? " (forced)" : " (auto)")
     .Append("   Defense: ").Append(defense ? "on" : "off").Append(safe ? "   SAFE" : "")
     .Append("   Turrets: ").Append(hubTurrets.Count).Append("  Alert sensors: ").Append(alertSensors.Count).Append('\n');
    e.Append(perf.Text()).Append('\n');
    e.Append(warn);
    for (int i = evText.Count - 1; i &gt;= Math.Max(0, evText.Count - 5); i--) e.Append(Util.Age((int)(T - evT[i]))).Append("  ").Append(evText[i]).Append('\n');
    echo = e.ToString();
}

// ============================================================================
// Hub Core: registry record for one drone
// ============================================================================
class Drone
{
    public long Addr;
    public string Call = "", Role = "", Grid = "";
    public long Caps;
    public double MaxAccel, MaxSpeed;

    // last reported status
    public int State, Task, Flags;
    public long Ack, DockId;
    public Vector3D Pos, Vel;
    public float Batt = -1, H2 = -1, Cargo = -1, Integ = 1, Ammo = -1;
    public double DockedSince;
    public double Seen = -1e9;
    public bool LostFlag = true, Restored;

    // hub directive (what we want this drone doing)
    public int Dir;
    public Vector3D A, B, C;
    public long Id;
    public bool SlotOk;          // escort slot computed &amp; sent

    // reliable delivery
    public long Seq;             // seq of outstanding directive (0 = nothing to deliver)
    public double Sent;
    public int Tries;
    public bool Unresp;

    public long Conn;            // reserved dock connector
    public bool Managed;         // under automatic defense control

    public bool Docked { get { return (Flags &amp; Proto.F_DOCKED) != 0; } }
    public bool Acked { get { return Seq == 0 || Ack == Seq; } }
}

// ============================================================================
// Hub Core: dock (connector) reservations
// ============================================================================
class Docks
{
    public readonly List&lt;IMyShipConnector&gt; List = new List&lt;IMyShipConnector&gt;();
    public readonly Dictionary&lt;long, long&gt; Res = new Dictionary&lt;long, long&gt;();   // connector id -&gt; drone addr

    public void Bind(List&lt;IMyShipConnector&gt; l) { List.Clear(); List.AddRange(l); }

    public IMyShipConnector Get(long id)
    {
        foreach (var c in List) if (c.EntityId == id &amp;&amp; !c.Closed) return c;
        return null;
    }

    public IMyShipConnector Reserve(Drone d)
    {
        if (d.Conn != 0)
        {
            var e = Get(d.Conn);
            if (e != null &amp;&amp; e.IsFunctional) { Res[e.EntityId] = d.Addr; return e; }
            Release(d);
        }
        foreach (var c in List)
        {
            if (c.Closed || !c.IsFunctional || !c.Enabled) continue;
            long who;
            if (Res.TryGetValue(c.EntityId, out who) &amp;&amp; who != d.Addr) continue;
            if (c.Status == MyShipConnectorStatus.Connected) continue;
            Res[c.EntityId] = d.Addr;
            d.Conn = c.EntityId;
            return c;
        }
        return null;
    }

    public void Claim(Drone d, long connId)
    {
        if (d.Conn == connId || Get(connId) == null) return;
        Release(d);
        Res[connId] = d.Addr;
        d.Conn = connId;
    }

    public void Release(Drone d)
    {
        if (d.Conn == 0) return;
        long who;
        if (Res.TryGetValue(d.Conn, out who) &amp;&amp; who == d.Addr) Res.Remove(d.Conn);
        d.Conn = 0;
    }

    public int Free()
    {
        int n = 0;
        foreach (var c in List)
            if (!c.Closed &amp;&amp; c.IsFunctional &amp;&amp; c.Status != MyShipConnectorStatus.Connected &amp;&amp; !Res.ContainsKey(c.EntityId)) n++;
        return n;
    }

    public string NameOf(long id)
    {
        var c = Get(id);
        return c != null ? c.CustomName : "-";
    }
}

// ============================================================================
// Hub Core: formation / station patterns in the hub frame
// (+X right, +Y up, +Z back). Offsets are relative to the keep-out centre.
// R = keep-out radius, s = spacing.
// ============================================================================
static class Formation
{
    public static readonly string[] Names = { "WEDGE", "LINE", "COLUMN", "RING", "SPHERE" };

    public static bool Valid(string f) { return Array.IndexOf(Names, f) &gt;= 0; }

    public static string Next(string f)
    {
        int i = Array.IndexOf(Names, f);
        return Names[(i + 1) % Names.Length];
    }

    public static Vector3D Offset(string f, int i, int n, double s, double R)
    {
        int r = i / 2 + 1;
        double side = (i % 2 == 0) ? -1 : 1;
        switch (f)
        {
            case "LINE":      // abreast, alternating left/right outside the hull
                return new Vector3D(side * (R + s * (i / 2 + 0.5)), 0, 0);
            case "COLUMN":    // trailing behind
                return new Vector3D(0, 0, R + s * (i + 1));
            case "RING":      // horizontal ring, first slot dead ahead
                {
                    double a = 2 * Math.PI * i / Math.Max(1, n), rr = R + s;
                    return new Vector3D(rr * Math.Sin(a), 0, -rr * Math.Cos(a));
                }
            case "SPHERE":    // Fibonacci sphere: even all-round screen
                {
                    double rr = R + s, k = (i + 0.5) / Math.Max(1, n);
                    double y = 1 - 2 * k, rad = Math.Sqrt(Math.Max(0, 1 - y * y)), phi = i * 2.399963229728653;
                    return new Vector3D(Math.Cos(phi) * rad * rr, y * rr, Math.Sin(phi) * rad * rr);
                }
            default:          // WEDGE: V trailing from the stern
                return new Vector3D(side * r * s, 0, R + r * s * 0.8);
        }
    }

    // Facing for base stations: look outward (horizontal)
    public static Vector3D Outward(Vector3D off)
    {
        var h = new Vector3D(off.X, 0, off.Z);
        return h.LengthSquared() &gt; 1e-6 ? Util.Norm(h) : new Vector3D(0, 0, -1);
    }
}

// ============================================================================
// Shared: protocol constants (must be identical in every Fleet System script)
// ============================================================================
static class Proto
{
    public const int Version = 3;   // v3: status carries ammo (v2: NAV patrol phase/rate; ESCORT engage/leash/patrol)

    // Message types (header Item4)
    public const int M_NAV = 1, M_HELLO = 2, M_STS = 3, M_ORD = 4;

    // Orders / hub directives
    public const int O_NONE = 0, O_REGISTER = 1, O_ESCORT = 2, O_HOLD = 3, O_GOTO = 4,
                     O_DOCK = 5, O_UNDOCK = 6, O_STOP = 7;

    // Hub modes (MODE_AUTO is a setting only; the active mode is CARRIER or BASE)
    public const int MODE_AUTO = 0, MODE_CARRIER = 1, MODE_BASE = 2;

    // Drone states
    public const int S_BOOT = 0, S_UNPROV = 1, S_REGISTERING = 2, S_IDLE = 3, S_HOLD = 4,
                     S_ESCORT = 5, S_GOTO = 6, S_APPROACH = 7, S_FINAL = 8, S_DOCKED = 9,
                     S_UNDOCKING = 10, S_LINKLOST = 11, S_ERROR = 12, S_PATROL = 13, S_ENGAGED = 14;

    // Drone status flags
    public const int F_DOCKED = 1, F_WANT_RTB = 2, F_LINKLOST = 4, F_NO_THRUST = 8, F_ARRIVED = 16,
                     F_ENGAGED = 32,   // combat blocks active
                     F_CONTACT = 64;   // drone's own turrets report a target (feeds hub alert)

    // Hub alert levels
    public const int ALERT_GREEN = 0, ALERT_YELLOW = 1, ALERT_RED = 2;

    // Carrier jump interlock
    public const int JUMP_NONE = 0, JUMP_PREP = 1, JUMP_READY = 2;

    // Factory states
    public const int FAC_IDLE = 0, FAC_BUILDING = 1, FAC_SECURE = 2, FAC_RELEASE = 3, FAC_BAYBUSY = 4,
                     FAC_STALLED = 5, FAC_ERROR = 6, FAC_OFF = 7;
    static readonly string[] facs = { "IDLE", "BUILDING", "SECURING", "RELEASING", "BAY BUSY", "WAITING PARTS", "ERROR", "OFF" };
    public static string FactoryName(int s) { return s &gt;= 0 &amp;&amp; s &lt; facs.Length ? facs[s] : "?"; }

    static readonly string[] states = { "BOOT", "UNPROV", "REGISTER", "IDLE", "HOLD", "ESCORT", "GOTO",
                                        "APPROACH", "FINAL", "DOCKED", "UNDOCK", "NO LINK", "ERROR", "PATROL", "ENGAGED" };
    static readonly string[] orders = { "-", "REG", "ESCORT", "HOLD", "GOTO", "DOCK", "UNDOCK", "STOP" };
    static readonly string[] modes = { "AUTO", "CARRIER", "BASE" };
    static readonly string[] alerts = { "GREEN", "YELLOW", "RED" };

    public static string StateName(int s) { return s &gt;= 0 &amp;&amp; s &lt; states.Length ? states[s] : "?"; }
    public static string OrderName(int o) { return o &gt;= 0 &amp;&amp; o &lt; orders.Length ? orders[o] : "?"; }
    public static string ModeName(int m) { return m &gt;= 0 &amp;&amp; m &lt; modes.Length ? modes[m] : "?"; }
    public static string AlertName(int a) { return a &gt;= 0 &amp;&amp; a &lt; alerts.Length ? alerts[a] : "?"; }
}

// ============================================================================
// Shared: utilities (culture-independent parsing, formatting, vector helpers)
// ============================================================================
static class Util
{
    // FNV-1a: stable across machines (string.GetHashCode is not guaranteed to be)
    public static int Hash(string s)
    {
        unchecked
        {
            uint h = 2166136261;
            for (int i = 0; i &lt; s.Length; i++) { h ^= s[i]; h *= 16777619; }
            return (int)h;
        }
    }

    public static double Clamp(double v, double lo, double hi) { return v &lt; lo ? lo : (v &gt; hi ? hi : v); }

    public static Vector3D Norm(Vector3D v)
    {
        double l = v.Length();
        return l &gt; 1e-9 ? v / l : Vector3D.Zero;
    }

    public static Vector3D Perp(Vector3D v)
    {
        Vector3D p = Vector3D.Cross(v, Vector3D.Up);
        if (p.LengthSquared() &lt; 1e-6) p = Vector3D.Cross(v, Vector3D.Right);
        return Norm(p);
    }

    public static double Angle(Vector3D a, Vector3D b)
    {
        return Math.Acos(Clamp(Vector3D.Dot(Norm(a), Norm(b)), -1, 1));
    }

    // Parses "123", "-45.67". Always '.' as decimal separator, regardless of game locale.
    public static bool ParseD(string s, out double v)
    {
        v = 0;
        if (s == null) return false;
        s = s.Trim();
        if (s.Length == 0) return false;
        int i = 0; bool neg = false;
        if (s[0] == '-' || s[0] == '+') { neg = s[0] == '-'; i++; }
        double ip = 0, fp = 0, scale = 1; bool digits = false, dot = false;
        for (; i &lt; s.Length; i++)
        {
            char c = s[i];
            if (c &gt;= '0' &amp;&amp; c &lt;= '9')
            {
                digits = true;
                if (dot) { scale *= 0.1; fp += (c - '0') * scale; }
                else ip = ip * 10 + (c - '0');
            }
            else if (c == '.' &amp;&amp; !dot) dot = true;
            else return false;
        }
        if (!digits) return false;
        v = neg ? -(ip + fp) : ip + fp;
        return true;
    }

    // "GPS:Name:X:Y:Z:" (optionally followed by colour) anywhere inside s
    public static bool ParseGps(string s, out Vector3D p, out string name)
    {
        p = Vector3D.Zero; name = "";
        int i = s.IndexOf("GPS:");
        if (i &lt; 0) return false;
        string[] parts = s.Substring(i).Split(':');
        if (parts.Length &lt; 5) return false;
        double x, y, z;
        if (!ParseD(parts[2], out x) || !ParseD(parts[3], out y) || !ParseD(parts[4], out z)) return false;
        name = parts[1];
        p = new Vector3D(x, y, z);
        return true;
    }

    public static string Gps(string name, Vector3D p)
    {
        return "GPS:" + name + ":" + Num(p.X) + ":" + Num(p.Y) + ":" + Num(p.Z) + ":";
    }

    // Integer-based number formatting: immune to decimal-comma locales
    public static string Num(double v)
    {
        long cents = (long)Math.Round(v * 100);
        string sign = cents &lt; 0 ? "-" : "";
        cents = Math.Abs(cents);
        return sign + (cents / 100) + "." + (cents % 100).ToString("00");
    }

    public static string Pct(float f) { return f &lt; 0 ? "--" : ((int)Math.Round(f * 100)) + "%"; }
    public static string PctM(int milli) { return milli &lt; 0 ? "--" : ((milli + 5) / 10) + "%"; }

    public static string Dist(double m)
    {
        if (m &lt; 1000) return ((int)m) + "m";
        if (m &lt; 100000) return ((int)(m / 1000)) + "." + ((int)(m / 100) % 10) + "km";
        return ((int)(m / 1000)) + "km";
    }

    public static string Age(int s)
    {
        if (s &lt; 60) return s + "s";
        if (s &lt; 3600) return (s / 60) + "m";
        return (s / 3600) + "h";
    }

    public static string Clean(string s) { return s == null ? "" : s.Replace('|', '/').Replace('\n', ' ').Replace('\r', ' '); }

    public static int Milli(float f) { return f &lt; 0 ? -1 : (int)Math.Round(f * 1000); }
}

// Rolling runtime average for server-budget monitoring (target &lt;= 0.3 ms avg)
class Perf
{
    public double Avg, Peak;
    double peakT;

    public void Tick(double ms, double now)
    {
        Avg += (ms - Avg) * 0.02;
        if (ms &gt; Peak || now - peakT &gt; 10) { Peak = ms; peakT = now; }
    }

    public string Text()
    {
        return "Runtime avg " + Util.Num(Avg) + " ms (peak " + Util.Num(Peak) + ")" + (Avg &gt; 0.3 ? "  OVER BUDGET" : "");
    }
}

// ============================================================================
// Shared: Custom Data config via MyIni. Missing keys are written back with
// their defaults so every option is visible to the player.
// ============================================================================
class Cfg
{
    readonly MyIni ini = new MyIni();
    readonly IMyTerminalBlock blk;
    readonly string sec;
    bool dirty;
    public string Error = "";

    public Cfg(IMyTerminalBlock b, string section)
    {
        blk = b; sec = section;
        MyIniParseResult r;
        if (!ini.TryParse(b.CustomData, out r))
            Error = "Custom Data error (line " + r.LineNo + "): " + r.Error + ". Fix it, then recompile.";
    }

    public string S(string k, string d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToString(d);
    }

    public double D(string k, double d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToDouble(d);
    }

    public int I(string k, int d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToInt32(d);
    }

    public bool B(string k, bool d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToBoolean(d);
    }

    // Writes a single key, re-reading Custom Data first so player edits are not lost.
    public void Set(string k, string v)
    {
        MyIni fresh = new MyIni();
        if (!fresh.TryParse(blk.CustomData)) return;
        fresh.Set(sec, k, v);
        blk.CustomData = fresh.ToString();
        ini.Set(sec, k, v);
    }

    public void Save()
    {
        if (dirty &amp;&amp; Error.Length == 0) { blk.CustomData = ini.ToString(); dirty = false; }
    }
}

// ============================================================================
// Shared: IGC network layer. All wire formats live here so hub and drones can
// never disagree on tuple layouts. Payloads use MyTuple/Vector3D/primitives only
// (no string-encoded numbers, so no locale bugs).
//
// Header: (version, netId, keyHash, msgType, seq)
// seq for orders = (hubEpoch &lt;&lt; 32) | counter   -&gt; drones detect hub restarts
// ============================================================================
class Net
{
    public readonly IMyIntergridCommunicationSystem IGC;
    public int NetId, KeyHash;
    public string TNav = "", THello = "", TSts = "", TOrd = "", TCmd = "", TSnap = "", TFac = "", TFacSt = "";

    public Net(IMyIntergridCommunicationSystem igc) { IGC = igc; }

    public void Configure(int netId, string key)
    {
        NetId = netId;
        KeyHash = Util.Hash(key ?? "");
        string p = "FS" + netId + "/";
        TNav = p + "nav"; THello = p + "hello"; TSts = p + "sts"; TOrd = p + "ord";
        TCmd = p + "cmd"; TSnap = p + "snap"; TFac = p + "fac"; TFacSt = p + "facst";
    }

    MyTuple&lt;int, int, int, int, long&gt; Hdr(int type, long seq)
    {
        return new MyTuple&lt;int, int, int, int, long&gt;(Proto.Version, NetId, KeyHash, type, seq);
    }

    bool Ok(MyTuple&lt;int, int, int, int, long&gt; h, int type)
    {
        return h.Item1 == Proto.Version &amp;&amp; h.Item2 == NetId &amp;&amp; h.Item3 == KeyHash &amp;&amp; h.Item4 == type;
    }

    // ---------------- NAV (hub -&gt; all, broadcast) ----------------
    // phase/rate: shared patrol rotation (radians, rad/s) so all drones orbit in step
    public void SendNav(Vector3D pos, Vector3D vel, Vector3D fwd, Vector3D up, Vector3D ang,
                        Vector3D koc, double kor, int mode, int alert, double phase, double rate)
    {
        IGC.SendBroadcastMessage(TNav,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;&gt;(
                Hdr(Proto.M_NAV, 0),
                new MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;(pos, vel, fwd, up, ang),
                new MyTuple&lt;Vector3D, double, int, int, double, double&gt;(koc, kor, mode, alert, phase, rate)));
    }

    public bool ReadNav(MyIGCMessage m, HubFrame f)
    {
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;&gt;)) return false;
        var n = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;&gt;)m.Data;
        if (!Ok(n.Item1, Proto.M_NAV)) return false;
        f.Pos = n.Item2.Item1; f.Vel = n.Item2.Item2; f.Fwd = n.Item2.Item3; f.Up = n.Item2.Item4; f.AngVel = n.Item2.Item5;
        f.KoC = n.Item3.Item1; f.KoR = n.Item3.Item2; f.Mode = n.Item3.Item3; f.Alert = n.Item3.Item4;
        f.Phase = n.Item3.Item5; f.Rate = n.Item3.Item6;
        f.Valid = true;
        return true;
    }

    // ---------------- HELLO (drone -&gt; hubs, broadcast) ----------------
    public void SendHello(string role, long caps, double maxAccel, double maxSpeed, string grid)
    {
        IGC.SendBroadcastMessage(THello,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;(
                Hdr(Proto.M_HELLO, 0),
                new MyTuple&lt;string, long, double, double, string&gt;(role, caps, maxAccel, maxSpeed, grid)));
    }

    public bool ReadHello(MyIGCMessage m, out string role, out long caps, out double maxAccel, out double maxSpeed, out string grid)
    {
        role = grid = ""; caps = 0; maxAccel = maxSpeed = 0;
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;)) return false;
        var h = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;)m.Data;
        if (!Ok(h.Item1, Proto.M_HELLO)) return false;
        role = h.Item2.Item1; caps = h.Item2.Item2; maxAccel = h.Item2.Item3; maxSpeed = h.Item2.Item4; grid = h.Item2.Item5;
        return true;
    }

    // ---------------- STATUS (drone -&gt; its hub, unicast) ----------------
    // (role, state, task, ackSeq, dockId) (pos, vel) (battery, h2, cargo, integrity, ammo, flags)
    public bool SendStatus(long hub, string role, int state, int task, long ack, long dockId,
                           Vector3D pos, Vector3D vel, float batt, float h2, float cargo, float integ, float ammo, int flags)
    {
        return IGC.SendUnicastMessage(hub, TSts,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;(
                Hdr(Proto.M_STS, 0),
                new MyTuple&lt;string, int, int, long, long&gt;(role, state, task, ack, dockId),
                new MyTuple&lt;Vector3D, Vector3D&gt;(pos, vel),
                new MyTuple&lt;float, float, float, float, float, int&gt;(batt, h2, cargo, integ, ammo, flags)));
    }

    public bool ReadStatus(MyIGCMessage m, out MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt; s)
    {
        s = default(MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;);
        if (m.Tag != TSts) return false;
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;)) return false;
        s = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;)m.Data;
        return Ok(s.Item1, Proto.M_STS);
    }

    // ---------------- ORDER (hub -&gt; drone, unicast) ----------------
    // (code, a, b, c, id, text)
    public bool SendOrder(long to, long seq, int code, Vector3D a, Vector3D b, Vector3D c, long id, string text)
    {
        return IGC.SendUnicastMessage(to, TOrd,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;(
                Hdr(Proto.M_ORD, seq),
                new MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;(code, a, b, c, id, text ?? "")));
    }

    public bool ReadOrder(MyIGCMessage m, out long seq, out int code, out Vector3D a, out Vector3D b, out Vector3D c, out long id, out string text)
    {
        seq = 0; code = 0; a = b = c = Vector3D.Zero; id = 0; text = "";
        if (m.Tag != TOrd) return false;
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;)) return false;
        var o = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;)m.Data;
        if (!Ok(o.Item1, Proto.M_ORD)) return false;
        seq = o.Item1.Item5; code = o.Item2.Item1; a = o.Item2.Item2; b = o.Item2.Item3; c = o.Item2.Item4;
        id = o.Item2.Item5; text = o.Item2.Item6;
        return true;
    }
}

// ============================================================================
// Shared: hub reference frame. The hub always broadcasts its live frame; a
// base simply has zero velocity. Drone orders are expressed in this frame.
// Local axes follow SE convention: +X right, +Y up, +Z backward (forward = -Z).
// ============================================================================
class HubFrame
{
    public Vector3D Pos, Vel, Fwd = Vector3D.Forward, Up = Vector3D.Up, AngVel, KoC;
    public double KoR, Phase, Rate;
    public int Mode, Alert;
    public double T = -1e9;     // local time the frame was received
    public bool Valid;

    // Frame extrapolated to 'now' (translation only; rotation is covered by VelAt feed-forward)
    public MatrixD Matrix(double now)
    {
        double dt = Util.Clamp(now - T, 0, 2);
        return MatrixD.CreateWorld(Pos + Vel * dt, Fwd, Up);
    }

    public Vector3D KeepOut(double now)
    {
        return KoC + Vel * Util.Clamp(now - T, 0, 2);
    }

    // Shared patrol rotation angle, extrapolated
    public double PhaseAt(double now) { return Phase + Rate * Util.Clamp(now - T, 0, 2); }

    // Rotate a hub-local vector about the local +Y (up) axis, right-handed
    public static Vector3D RotY(Vector3D v, double a)
    {
        double c = Math.Cos(a), s = Math.Sin(a);
        return new Vector3D(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c);
    }

    // Velocity of a point rigidly attached to the hub
    public Vector3D VelAt(Vector3D world, MatrixD m)
    {
        return Vel + Vector3D.Cross(AngVel, world - m.Translation);
    }

    public static Vector3D ToWorld(MatrixD m, Vector3D local) { return m.Translation + Vector3D.TransformNormal(local, m); }
    public static Vector3D ToLocal(MatrixD m, Vector3D world) { return Vector3D.TransformNormal(world - m.Translation, MatrixD.Transpose(m)); }
    public static Vector3D DirToWorld(MatrixD m, Vector3D d) { return Vector3D.TransformNormal(d, m); }
    public static Vector3D DirToLocal(MatrixD m, Vector3D d) { return Vector3D.TransformNormal(d, MatrixD.Transpose(m)); }
}
</Program>
            </MyObjectBuilder_CubeBlock>
            <MyObjectBuilder_CubeBlock xsi:type="MyObjectBuilder_MyProgrammableBlock">
              <SubtypeName>LargeProgrammableBlock</SubtypeName>
              <EntityId>319155202096808996</EntityId>
              <Min x="5" y="2" z="11" />
              <BlockOrientation Forward="Forward" Up="Up" />
              <ColorMaskHSV x="0.58" y="-0.55" z="-0.1" />
              <CustomName>Programmable Block [Fleet UI]</CustomName>
              <Program>// FLEET SYSTEM 0.3.0-phase3 — HubUI
// Generated by tools/build.py from src/. Paste this whole file into the programmable block.

// ============================================================================
// FLEET SYSTEM — HUB UI (phase 3)
// Renders the fleet list on LCDs / cockpit screens tagged [FS:Fleet], the
// tactical map on [FS:Map] and the hangar on [FS:Hangar] (add :1 etc. for a
// cockpit surface index), and
// turns button presses into commands for Hub Core (same construct, local IGC).
//
// Arguments: up | down | left | right | apply | back
//            anything else is forwarded to Hub Core; the word "sel" is replaced
//            by the selected drone (or "all"), e.g. "dock sel", "goto sel GPS:..."
// ============================================================================
const string SEC = "HubUI";

Net net;
Cfg cfg;
readonly Perf perf = new Perf();
IMyBroadcastListener snapL;
readonly List&lt;IMyTextSurface&gt; fleetSurf = new List&lt;IMyTextSurface&gt;();
readonly List&lt;IMyTextSurface&gt; mapSurf = new List&lt;IMyTextSurface&gt;();
readonly List&lt;IMyTextSurface&gt; hangarSurf = new List&lt;IMyTextSurface&gt;();
readonly List&lt;IMyTerminalBlock&gt; tmp = new List&lt;IMyTerminalBlock&gt;();
string fleetTag = "FS:Fleet", mapTag = "FS:Map", hangarTag = "FS:Hangar";
double T, snapT = -1e9, nextScan;
bool flip;

// snapshot from Hub Core
int hMode, hCfgMode, hSpacing, hFree, hDocks, hOnline, hPerfUs, hAlert, hJump;
// hangar
readonly List&lt;DockRow&gt; dockRows = new List&lt;DockRow&gt;();
bool facOk, pRepair, pRearm;
int facSt, facProg, facBuilt, facDemand, pCharging, pMaxC, pReserve, pStock, pLive, pRepairN, pRearmN;
string facMsg = "";
bool hAutoRtb, hWp, hAlertForced, hSafe, hDefense;
string hForm = "", hName = "";
readonly List&lt;Row&gt; rows = new List&lt;Row&gt;();
readonly List&lt;string&gt; evts = new List&lt;string&gt;();

// selection
string selCall = "";
int scroll, action;
// Row 1 acts on the selected drone (or ALL); row 2 is fleet-wide.
const int TargetedActions = 7;
static readonly string[] Actions = { "ESCORT", "HOLD", "GOTO", "DOCK", "UNDOCK", "STOP", "AUTO",
                                     "SCRAMBLE", "RECALL", "ALERT", "SAFE", "FORM", "MODE", "JUMP" };
static readonly string[] ActionCmd = { "escort", "hold", "goto", "dock", "undock", "stop", "auto",
                                       "scramble", "recall", "alert next", "safe toggle", "formation next", "mode next", "jump toggle" };

class DockRow { public string Name = "", Call = ""; public int State, Batt, Integ; }

class Row
{
    public string Call = "", Role = "";
    public int State, Dir, Batt, Integ, Cargo, H2, Speed, Flags, LostS, Ammo;
    public long Dist, LX, LY, LZ;
    public bool Unresp, Queued, Acked, Managed;
}

public Program()
{
    net = new Net(IGC);
    LoadConfig();
    Scan();
    Runtime.UpdateFrequency = UpdateFrequency.Update10;
}

void LoadConfig()
{
    cfg = new Cfg(Me, SEC);
    int netId = cfg.I("NetId", 1);
    fleetTag = cfg.S("FleetTag", "FS:Fleet");
    mapTag = cfg.S("MapTag", "FS:Map");
    hangarTag = cfg.S("HangarTag", "FS:Hangar");
    cfg.Save();
    net.Configure(netId, "");
    if (snapL != null) IGC.DisableBroadcastListener(snapL);
    snapL = IGC.RegisterBroadcastListener(net.TSnap);
}

void Scan()
{
    Collect(fleetTag, fleetSurf);
    Collect(mapTag, mapSurf);
    Collect(hangarTag, hangarSurf);
}

void Collect(string tag, List&lt;IMyTextSurface&gt; into)
{
    into.Clear();
    tmp.Clear();
    string open = "[" + tag;
    GridTerminalSystem.GetBlocksOfType(tmp, b =&gt; b.IsSameConstructAs(Me) &amp;&amp; b is IMyTextSurfaceProvider &amp;&amp; b.CustomName.Contains(open));
    foreach (var b in tmp)
    {
        var p = (IMyTextSurfaceProvider)b;
        int idx = TagIndex(b.CustomName, tag);
        if (idx &lt; p.SurfaceCount) into.Add(p.GetSurface(idx));
    }
}

static int TagIndex(string name, string tag)
{
    int i = name.IndexOf("[" + tag);
    int j = i + tag.Length + 1;
    if (i &gt;= 0 &amp;&amp; j &lt; name.Length &amp;&amp; name[j] == ':')
    {
        int e = name.IndexOf(']', j);
        int v;
        if (e &gt; j + 1 &amp;&amp; int.TryParse(name.Substring(j + 1, e - j - 1), out v)) return v;
    }
    return 0;
}

public void Main(string arg, UpdateType src)
{
    T += Runtime.TimeSinceLastRun.TotalSeconds;
    perf.Tick(Runtime.LastRunTimeMs, T);
    while (snapL.HasPendingMessage)
    {
        var s = snapL.AcceptMessage().Data as string;
        if (s != null) { Parse(s); snapT = T; }
    }
    bool input = !string.IsNullOrEmpty(arg);
    if (input) Input(arg.Trim());
    if (T &gt;= nextScan) { Scan(); nextScan = T + 10; }
    if (input || (src &amp; UpdateType.Update10) != 0) Render();
    Echo("FLEET HUB UI\nScreens: " + fleetSurf.Count + " [" + fleetTag + "], " + mapSurf.Count + " [" + mapTag + "], " + hangarSurf.Count + " [" + hangarTag + "]\nCore link: " +
         (Linked() ? "OK" : "NONE (is Hub Core running with the same NetId?)") + "\n" + perf.Text());
}

bool Linked() { return T - snapT &lt; 3; }

// ---------------------------------------------------------------- input
void Input(string arg)
{
    int n = rows.Count + 1, cur = Cursor();
    switch (arg.ToLower())
    {
        case "up": SetCursor((cur - 1 + n) % n); break;
        case "down": SetCursor((cur + 1) % n); break;
        case "left": action = (action - 1 + Actions.Length) % Actions.Length; break;
        case "right": action = (action + 1) % Actions.Length; break;
        case "apply": case "select":
            {
                string c = ActionCmd[action];
                if (action &lt; TargetedActions) c += " " + Target();
                Send(c);
            }
            break;
        case "back": selCall = ""; break;
        default: Send(ReplaceSel(arg)); break;
    }
}

string Target() { return selCall.Length &gt; 0 ? selCall : "all"; }

string ReplaceSel(string arg)
{
    var parts = arg.Split(' ');
    for (int i = 0; i &lt; parts.Length; i++) if (parts[i].ToLower() == "sel") parts[i] = Target();
    return string.Join(" ", parts);
}

void Send(string cmd) { IGC.SendBroadcastMessage(net.TCmd, cmd, TransmissionDistance.CurrentConstruct); }

int Cursor()
{
    if (selCall.Length == 0) return 0;
    for (int i = 0; i &lt; rows.Count; i++) if (rows[i].Call == selCall) return i + 1;
    selCall = "";
    return 0;
}

void SetCursor(int i) { selCall = i == 0 ? "" : rows[i - 1].Call; }

// ---------------------------------------------------------------- snapshot
static int I(string[] f, int i) { int v; return i &lt; f.Length &amp;&amp; int.TryParse(f[i], out v) ? v : 0; }
static long L(string[] f, int i) { long v; return i &lt; f.Length &amp;&amp; long.TryParse(f[i], out v) ? v : 0; }

void Parse(string s)
{
    int ri = 0, ki = 0;
    evts.Clear();
    facOk = false;
    foreach (var line in s.Split('\n'))
    {
        if (line.Length &lt; 3) continue;
        var f = line.Split('|');
        switch (f[0])
        {
            case "H":
                hMode = I(f, 1); hCfgMode = I(f, 2); hForm = f.Length &gt; 3 ? f[3] : ""; hSpacing = I(f, 4); hAutoRtb = I(f, 5) == 1;
                hFree = I(f, 6); hDocks = I(f, 7); hWp = I(f, 8) == 1; hPerfUs = I(f, 9); hOnline = I(f, 10); hName = f.Length &gt; 11 ? f[11] : "";
                hAlert = I(f, 12); hAlertForced = I(f, 13) == 1; hSafe = I(f, 14) == 1; hDefense = I(f, 15) == 1; hJump = I(f, 16);
                break;
            case "D":
                {
                    if (ri &gt;= rows.Count) rows.Add(new Row());
                    var r = rows[ri++];
                    r.Call = f[1]; r.Role = f.Length &gt; 2 ? f[2] : ""; r.State = I(f, 3); r.Dir = I(f, 4);
                    r.Batt = I(f, 5); r.Integ = I(f, 6); r.Cargo = I(f, 7); r.H2 = I(f, 8);
                    r.Dist = L(f, 9); r.Speed = I(f, 10); r.Flags = I(f, 11); r.LostS = I(f, 12);
                    r.Unresp = I(f, 13) == 1; r.Queued = I(f, 14) == 1; r.Acked = I(f, 15) == 1;
                    r.LX = L(f, 16); r.LY = L(f, 17); r.LZ = L(f, 18); r.Managed = I(f, 19) == 1; r.Ammo = f.Length &gt; 20 ? I(f, 20) : -1;
                }
                break;
            case "K":
                {
                    if (ki &gt;= dockRows.Count) dockRows.Add(new DockRow());
                    var k = dockRows[ki++];
                    k.Name = f[1]; k.State = I(f, 2); k.Call = f.Length &gt; 3 ? f[3] : ""; k.Batt = I(f, 4); k.Integ = I(f, 5);
                }
                break;
            case "F":
                facOk = true; facSt = I(f, 1); facProg = I(f, 2); facBuilt = I(f, 3); facDemand = I(f, 4); facMsg = f.Length &gt; 5 ? f[5] : "";
                break;
            case "P":
                pRepair = I(f, 1) == 1; pRearm = I(f, 2) == 1; pCharging = I(f, 3); pMaxC = I(f, 4); pReserve = I(f, 5);
                pStock = I(f, 6); pLive = I(f, 7); pRepairN = I(f, 8); pRearmN = I(f, 9);
                break;
            case "E":
                if (f.Length &gt; 2) evts.Add(Util.Age(I(f, 1)) + "  " + f[2]);
                break;
        }
    }
    if (rows.Count &gt; ri) rows.RemoveRange(ri, rows.Count - ri);
    if (dockRows.Count &gt; ki) dockRows.RemoveRange(ki, dockRows.Count - ki);
}

void Render()
{
    flip = !flip;
    foreach (var s in fleetSurf) DrawFleet(s);
    foreach (var s in mapSurf) DrawMap(s);
    foreach (var s in hangarSurf) DrawHangar(s);
}

// ============================================================================
// Hub UI: sprite rendering. Layout is designed on a 512 px reference and
// scaled with k = min(width, height) / 512, so square and wide LCDs both work.
// ============================================================================
static readonly Color C_BG = new Color(4, 10, 18), C_PANEL = new Color(14, 30, 46), C_TRACK = new Color(26, 40, 56),
                      C_ACC = new Color(0, 170, 255), C_TXT = new Color(220, 235, 245), C_DIM = new Color(110, 130, 150),
                      C_SEL = new Color(0, 64, 104), C_GOOD = new Color(60, 220, 110), C_WARN = new Color(255, 190, 40),
                      C_BAD = new Color(255, 70, 60), C_DOCK = new Color(90, 140, 255), C_VIO = new Color(190, 120, 255),
                      C_ORANGE = new Color(255, 130, 40);

static void Box(ref MySpriteDrawFrame f, float x, float y, float w, float h, Color c)
{
    f.Add(new MySprite(SpriteType.TEXTURE, "SquareSimple", new Vector2(x + w / 2, y + h / 2), new Vector2(w, h), c));
}

static void Txt(ref MySpriteDrawFrame f, string s, float x, float y, float scale, Color c, TextAlignment al = TextAlignment.LEFT)
{
    var sp = MySprite.CreateText(s, "White", c, scale, al);
    sp.Position = new Vector2(x, y);
    f.Add(sp);
}

static void Bar(ref MySpriteDrawFrame f, float x, float y, float w, float h, int milli, Color c)
{
    Box(ref f, x, y, w, h, C_TRACK);
    if (milli &gt; 0) Box(ref f, x, y, w * Math.Min(1000, milli) / 1000f, h, c);
}

static Color LevelColor(int milli) { return milli &lt; 0 ? C_DIM : milli &gt; 500 ? C_GOOD : milli &gt; 250 ? C_WARN : C_BAD; }

static Color StateColor(Row r)
{
    if (r.LostS &gt;= 0) return C_BAD;
    switch (r.State)
    {
        case Proto.S_ESCORT: case Proto.S_PATROL: return (r.Flags &amp; Proto.F_ENGAGED) != 0 ? C_ORANGE : C_GOOD;
        case Proto.S_ENGAGED: return C_BAD;
        case Proto.S_HOLD: return C_WARN;
        case Proto.S_GOTO: return C_ACC;
        case Proto.S_APPROACH: case Proto.S_FINAL: case Proto.S_UNDOCKING: return C_VIO;
        case Proto.S_DOCKED: return C_DOCK;
        case Proto.S_LINKLOST: return C_ORANGE;
        case Proto.S_ERROR: return C_BAD;
        default: return C_DIM;
    }
}

static string OrderText(Row r)
{
    string o = r.Queued ? "DOCK (queue)" : Proto.OrderName(r.Dir) + (r.Acked ? "" : " ...");
    return (r.Managed ? "A " : "") + o;
}

static string StateText(Row r)
{
    if (r.LostS &gt;= 0) return "LOST " + Util.Age(r.LostS);
    return Proto.StateName(r.State) + ((r.Flags &amp; Proto.F_ENGAGED) != 0 &amp;&amp; r.State != Proto.S_ENGAGED ? " +W" : "");
}

static Color AlertColor(int a) { return a == Proto.ALERT_RED ? C_BAD : a == Proto.ALERT_YELLOW ? C_WARN : C_GOOD; }

// Alert badge at the top-right of a screen
void AlertBadge(ref MySpriteDrawFrame f, float right, float top, float k)
{
    string t = Proto.AlertName(hAlert) + (hAlertForced ? "*" : "") + (hSafe ? " SAFE" : "");
    float w = (hSafe ? 120 : 76) * k, h = 24 * k;
    Box(ref f, right - w, top, w, h, AlertColor(hAlert));
    Txt(ref f, t, right - w / 2, top + 3 * k, 0.5f * k, C_BG, TextAlignment.CENTER);
}

void Prepare(IMyTextSurface s)
{
    if (s.ContentType != ContentType.SCRIPT) s.ContentType = ContentType.SCRIPT;
    if (s.Script != "") s.Script = "";
    if (s.ScriptBackgroundColor != C_BG) s.ScriptBackgroundColor = C_BG;
}

void DrawFleet(IMyTextSurface s)
{
    Prepare(s);
    Vector2 sz = s.SurfaceSize;
    Vector2 o = (s.TextureSize - sz) / 2f;
    float W = sz.X, H = sz.Y, k = Math.Min(W, H) / 512f;
    float x0 = o.X, y0 = o.Y;

    var f = s.DrawFrame();
    if (flip) f.Add(new MySprite());   // forces a resend so late-joining clients don't keep a stale cached screen
    Box(ref f, x0, y0, W, H, C_BG);

    // ---------------- header
    bool linked = Linked();
    Box(ref f, x0, y0, W, 64 * k, C_PANEL);
    Box(ref f, x0, y0 + 62 * k, W, 2 * k, C_ACC);
    Txt(ref f, "FLEET COMMAND", x0 + 10 * k, y0 + 6 * k, 0.8f * k, C_ACC);
    if (linked) AlertBadge(ref f, x0 + W - 8 * k, y0 + 8 * k, k);
    string info = linked
        ? Proto.ModeName(hMode) + (hCfgMode == Proto.MODE_AUTO ? " (auto)" : "") + "  " + hForm + " " + hSpacing + "m  DOCKS " + hFree + "/" + hDocks
          + "  DEF " + (hDefense ? "ON" : "OFF") + "  RTB " + (hAutoRtb ? "AUTO" : "MAN")
        : "NO LINK TO HUB CORE";
    Txt(ref f, info, x0 + 10 * k, y0 + 38 * k, 0.5f * k, linked ? C_TXT : C_BAD);

    if (linked &amp;&amp; hJump != Proto.JUMP_NONE)
    {
        bool ready = hJump == Proto.JUMP_READY;
        int docked = 0; foreach (var r in rows) if (r.LostS &lt; 0 &amp;&amp; r.State == Proto.S_DOCKED) docked++;
        int live = 0; foreach (var r in rows) if (r.LostS &lt; 0) live++;
        Box(ref f, x0 + W * 0.25f, y0 + 66 * k, W * 0.5f, 22 * k, ready ? C_GOOD : C_WARN);
        Txt(ref f, ready ? "JUMP READY" : "JUMP PREP  " + docked + "/" + live + " docked", x0 + W / 2, y0 + 68 * k, 0.5f * k, C_BG, TextAlignment.CENTER);
    }

    // ---------------- column headings
    float[] cx = { x0 + 0.04f * W, x0 + 0.30f * W, x0 + 0.47f * W, x0 + 0.63f * W, x0 + 0.80f * W, x0 + 0.97f * W };
    float colY = y0 + 72 * k, hs = 0.4f * k;
    Txt(ref f, "CALLSIGN", cx[0], colY, hs, C_DIM); Txt(ref f, "STATE", cx[1], colY, hs, C_DIM);
    Txt(ref f, "ORDER", cx[2], colY, hs, C_DIM); Txt(ref f, "BATT", cx[3], colY, hs, C_DIM);
    Txt(ref f, "HULL", cx[4], colY, hs, C_DIM); Txt(ref f, "DIST", cx[5], colY, hs, C_DIM, TextAlignment.RIGHT);

    // ---------------- rows
    float rowH = 28 * k, rowsTop = colY + 20 * k, footer = 208 * k;
    int maxRows = Math.Max(1, (int)((y0 + H - footer - rowsTop) / rowH));
    int total = rows.Count + 1, cur = Cursor();
    if (cur &lt; scroll) scroll = cur;
    if (cur &gt;= scroll + maxRows) scroll = cur - maxRows + 1;
    scroll = Math.Max(0, Math.Min(scroll, total - maxRows));
    float ts = 0.52f * k;
    for (int i = scroll; i &lt; Math.Min(total, scroll + maxRows); i++)
    {
        float ry = rowsTop + (i - scroll) * rowH, ty = ry + 4 * k;
        if (i == cur) Box(ref f, x0 + 4 * k, ry, W - 8 * k, rowH - 2 * k, C_SEL);
        if (i == 0)
        {
            Txt(ref f, "ALL DRONES", cx[0], ty, ts, C_ACC);
            Txt(ref f, hOnline + " online / " + rows.Count + " known", cx[1], ty, ts, C_TXT);
            continue;
        }
        var r = rows[i - 1];
        Color sc = StateColor(r);
        Box(ref f, x0 + 8 * k, ry + 5 * k, 4 * k, rowH - 12 * k, sc);
        Txt(ref f, r.Call, cx[0], ty, ts, C_TXT);
        Txt(ref f, StateText(r), cx[1], ty, ts, sc);
        Txt(ref f, OrderText(r), cx[2], ty, ts, r.Unresp ? C_BAD : r.Acked ? C_DIM : C_WARN);
        Bar(ref f, cx[3], ry + 9 * k, 0.14f * W, 9 * k, r.Batt, LevelColor(r.Batt));
        Bar(ref f, cx[4], ry + 9 * k, 0.10f * W, 9 * k, r.Integ, LevelColor(r.Integ));
        Txt(ref f, Util.Dist(r.Dist), cx[5], ty, ts, C_TXT, TextAlignment.RIGHT);
    }
    if (scroll &gt; 0) Txt(ref f, "more above", x0 + W - 10 * k, colY, hs, C_DIM, TextAlignment.RIGHT);
    if (scroll + maxRows &lt; total) Txt(ref f, "more below", x0 + W - 10 * k, rowsTop + maxRows * rowH - 4 * k, hs, C_DIM, TextAlignment.RIGHT);

    // ---------------- detail panel
    float py = y0 + H - footer;
    Box(ref f, x0, py, W, 2 * k, C_PANEL);
    float ds = 0.46f * k;
    if (cur == 0)
    {
        int esc = 0, hold = 0, dock = 0, lost = 0, other = 0;
        foreach (var r in rows)
        {
            if (r.LostS &gt;= 0) lost++;
            else if (r.State == Proto.S_ESCORT || r.State == Proto.S_PATROL || r.State == Proto.S_ENGAGED) esc++;
            else if (r.State == Proto.S_HOLD || r.State == Proto.S_GOTO) hold++;
            else if (r.State == Proto.S_DOCKED) dock++;
            else other++;
        }
        Txt(ref f, "OUT " + esc + "   HOLD/GOTO " + hold + "   DOCKED " + dock + "   OTHER " + other + "   LOST " + lost, x0 + 10 * k, py + 8 * k, ds, C_TXT);
        Txt(ref f, "Waypoint: " + (hWp ? "set" : "none") + "    Core " + Util.Num(hPerfUs / 1000.0) + " ms", x0 + 10 * k, py + 30 * k, ds, C_DIM);
    }
    else
    {
        var r = rows[cur - 1];
        Txt(ref f, r.Call + " [" + r.Role + "]   BATT " + Util.PctM(r.Batt) + "  AMMO " + Util.PctM(r.Ammo) + "  HULL " + Util.PctM(r.Integ) + "  H2 " + Util.PctM(r.H2),
            x0 + 10 * k, py + 8 * k, ds, C_TXT);
        string ackTxt = r.Unresp ? "NOT ACKNOWLEDGING" : r.Acked ? "order acknowledged" : "awaiting ack";
        string flags = ((r.Flags &amp; Proto.F_WANT_RTB) != 0 ? "  LOW POWER" : "") + ((r.Flags &amp; Proto.F_NO_THRUST) != 0 ? "  NO THRUST" : "");
        Txt(ref f, "Rel speed " + r.Speed + " m/s   " + ackTxt + flags, x0 + 10 * k, py + 30 * k, ds, r.Unresp ? C_BAD : C_DIM);
    }

    // ---------------- action bar (row 1: selected drone, row 2: fleet-wide)
    float ah = 30 * k;
    Txt(ref f, "TARGET: " + (selCall.Length &gt; 0 ? selCall : "ALL") + "   (up/down select, left/right action, apply)", x0 + 10 * k, py + 54 * k, 0.4f * k, C_ACC);
    for (int i = 0; i &lt; Actions.Length; i++)
    {
        bool row2 = i &gt;= TargetedActions;
        int n = row2 ? Actions.Length - TargetedActions : TargetedActions, j = row2 ? i - TargetedActions : i;
        float aw = (W - 8 * k) / n, ax = x0 + 4 * k + j * aw, ay = y0 + H - (row2 ? 90 : 126) * k;
        bool on = i == action;
        Box(ref f, ax + 2 * k, ay, aw - 4 * k, ah, on ? C_ACC : (row2 ? C_TRACK : C_PANEL));
        Txt(ref f, Actions[i], ax + aw / 2, ay + 7 * k, 0.38f * k, on ? C_BG : C_TXT, TextAlignment.CENTER);
    }

    // ---------------- event log
    float ey = y0 + H - 52 * k;
    for (int i = 0; i &lt; 2 &amp;&amp; i &lt; evts.Count; i++)
        Txt(ref f, evts[evts.Count - 1 - i], x0 + 10 * k, ey + i * 22 * k, 0.42f * k, i == 0 ? C_TXT : C_DIM);

    f.Dispose();
}

// ============================================================================
// Tactical map: top-down in the hub frame (hub forward = up on screen).
// Elevation is drawn as a stem from the ground point (pseudo-3D radar).
// ============================================================================
static double NiceRange(double v)
{
    double p = Math.Pow(10, Math.Floor(Math.Log10(Math.Max(1, v))));
    foreach (var m in new[] { 1.0, 2.0, 2.5, 5.0, 10.0 }) if (m * p &gt;= v) return m * p;
    return 10 * p;
}

void DrawMap(IMyTextSurface s)
{
    Prepare(s);
    Vector2 sz = s.SurfaceSize;
    Vector2 o = (s.TextureSize - sz) / 2f;
    float W = sz.X, H = sz.Y, k = Math.Min(W, H) / 512f;
    float x0 = o.X, y0 = o.Y;
    bool linked = Linked();
    Color ac = linked ? AlertColor(hAlert) : C_DIM;

    var f = s.DrawFrame();
    if (flip) f.Add(new MySprite());
    Box(ref f, x0, y0, W, H, C_BG);
    float bt = 3 * k;   // alert border
    Box(ref f, x0, y0, W, bt, ac); Box(ref f, x0, y0 + H - bt, W, bt, ac);
    Box(ref f, x0, y0, bt, H, ac); Box(ref f, x0 + W - bt, y0, bt, H, ac);

    Txt(ref f, "TACTICAL  " + (linked ? Proto.ModeName(hMode) : "NO LINK"), x0 + 12 * k, y0 + 10 * k, 0.6f * k, C_ACC);
    if (linked) AlertBadge(ref f, x0 + W - 12 * k, y0 + 10 * k, k);

    float cx = x0 + W / 2, cy = y0 + H / 2 + 12 * k, R = Math.Min(W, H - 90 * k) / 2 - 16 * k;
    double maxD = 100;
    foreach (var r in rows) if (r.LostS &lt; 0) maxD = Math.Max(maxD, Math.Sqrt((double)r.LX * r.LX + (double)r.LZ * r.LZ));
    double range = NiceRange(maxD * 1.15);
    float sc = (float)(R / range);

    // rings + cross
    f.Add(new MySprite(SpriteType.TEXTURE, "CircleHollow", new Vector2(cx, cy), new Vector2(2 * R, 2 * R), C_TRACK));
    f.Add(new MySprite(SpriteType.TEXTURE, "CircleHollow", new Vector2(cx, cy), new Vector2(R, R), C_TRACK));
    Box(ref f, cx - R, cy - 0.5f * k, 2 * R, 1 * k, C_TRACK);
    Box(ref f, cx - 0.5f * k, cy - R, 1 * k, 2 * R, C_TRACK);
    Txt(ref f, Util.Dist(range), cx + R * 0.71f, cy - R * 0.71f - 14 * k, 0.4f * k, C_DIM);
    Txt(ref f, Util.Dist(range / 2), cx + R * 0.355f, cy - R * 0.355f - 14 * k, 0.4f * k, C_DIM);

    // hub (triangle points to hub forward)
    f.Add(new MySprite(SpriteType.TEXTURE, "Triangle", new Vector2(cx, cy), new Vector2(16 * k, 20 * k), C_ACC));

    int engaged = 0, outN = 0, docked = 0, lost = 0;
    bool labels = rows.Count &lt;= 8;
    foreach (var r in rows)
    {
        if (r.LostS &gt;= 0) { lost++; continue; }
        if (r.State == Proto.S_DOCKED) { docked++; continue; }
        outN++;
        if ((r.Flags &amp; Proto.F_ENGAGED) != 0) engaged++;
        float px = r.LX * sc, py = r.LZ * sc;
        float d = (float)Math.Sqrt(px * px + py * py);
        if (d &gt; R) { px *= R / d; py *= R / d; }
        px += cx; py += cy;
        float elev = Math.Max(-R / 2, Math.Min(R / 2, r.LY * sc * 0.5f));
        Color c = StateColor(r);
        if (Math.Abs(elev) &gt; 2 * k) Box(ref f, px - 1 * k, Math.Min(py, py - elev), 2 * k, Math.Abs(elev), C_DIM);
        f.Add(new MySprite(SpriteType.TEXTURE, "Circle", new Vector2(px, py), new Vector2(4 * k, 4 * k), C_DIM));
        Vector2 b = new Vector2(px, py - elev);
        f.Add(new MySprite(SpriteType.TEXTURE, "Circle", b, new Vector2(10 * k, 10 * k), c));
        if ((r.Flags &amp; Proto.F_ENGAGED) != 0) f.Add(new MySprite(SpriteType.TEXTURE, "CircleHollow", b, new Vector2(18 * k, 18 * k), C_BAD));
        bool sel = r.Call == selCall;
        if (sel) f.Add(new MySprite(SpriteType.TEXTURE, "CircleHollow", b, new Vector2(24 * k, 24 * k), C_TXT));
        if (labels || sel) Txt(ref f, r.Call, b.X + 9 * k, b.Y - 8 * k, 0.38f * k, sel ? C_TXT : C_DIM);
    }

    Txt(ref f, "OUT " + outN + "   ENGAGED " + engaged + "   DOCKED " + docked + "   LOST " + lost + "   DEF " + (hDefense ? "ON" : "OFF"),
        x0 + 12 * k, y0 + H - 30 * k, 0.45f * k, C_TXT);
    f.Dispose();
}

// ============================================================================
// Hangar: docks, factory, repair/rearm/charging, jump interlock
// ============================================================================
void DrawHangar(IMyTextSurface s)
{
    Prepare(s);
    Vector2 sz = s.SurfaceSize;
    Vector2 o = (s.TextureSize - sz) / 2f;
    float W = sz.X, H = sz.Y, k = Math.Min(W, H) / 512f;
    float x0 = o.X, y0 = o.Y;
    bool linked = Linked();

    var f = s.DrawFrame();
    if (flip) f.Add(new MySprite());
    Box(ref f, x0, y0, W, H, C_BG);
    Box(ref f, x0, y0, W, 44 * k, C_PANEL);
    Box(ref f, x0, y0 + 42 * k, W, 2 * k, C_ACC);
    Txt(ref f, "HANGAR", x0 + 10 * k, y0 + 7 * k, 0.8f * k, C_ACC);
    if (linked) AlertBadge(ref f, x0 + W - 8 * k, y0 + 10 * k, k);
    if (!linked) { Txt(ref f, "NO LINK TO HUB CORE", x0 + W / 2, y0 + H / 2, 0.7f * k, C_BAD, TextAlignment.CENTER); f.Dispose(); return; }

    float y = y0 + 54 * k, ts = 0.48f * k;

    // jump interlock
    if (hJump != Proto.JUMP_NONE)
    {
        bool ready = hJump == Proto.JUMP_READY;
        Box(ref f, x0 + 8 * k, y, W - 16 * k, 26 * k, ready ? C_GOOD : C_WARN);
        Txt(ref f, ready ? "JUMP READY: drives unlocked" : "JUMP PREP: drives locked until all drones dock", x0 + W / 2, y + 4 * k, 0.48f * k, C_BG, TextAlignment.CENTER);
        y += 34 * k;
    }

    // factory
    if (facOk || pStock &gt; 0)
    {
        Txt(ref f, "FACTORY", x0 + 10 * k, y, 0.42f * k, C_DIM);
        Txt(ref f, "stock " + pLive + "/" + pStock + "   built " + facBuilt, x0 + W - 10 * k, y, 0.42f * k, C_DIM, TextAlignment.RIGHT);
        y += 20 * k;
        string fs = facOk ? Proto.FactoryName(facSt) : "NO FACTORY LINK";
        Color fc = !facOk || facSt == Proto.FAC_ERROR ? C_BAD : facSt == Proto.FAC_STALLED ? C_WARN : facSt == Proto.FAC_IDLE ? C_DIM : C_GOOD;
        Txt(ref f, fs, x0 + 10 * k, y, ts, fc);
        if (facProg &gt;= 0) Bar(ref f, x0 + W * 0.42f, y + 6 * k, W * 0.5f, 10 * k, facProg, C_ACC);
        y += 24 * k;
        if (facOk &amp;&amp; facMsg.Length &gt; 0) { Txt(ref f, facMsg, x0 + 10 * k, y, 0.4f * k, C_DIM); y += 20 * k; }
        y += 6 * k;
    }

    // docks
    Txt(ref f, "DOCKS", x0 + 10 * k, y, 0.42f * k, C_DIM);
    Txt(ref f, "BATT", x0 + W * 0.62f, y, 0.42f * k, C_DIM);
    Txt(ref f, "HULL", x0 + W * 0.82f, y, 0.42f * k, C_DIM);
    y += 20 * k;
    float rowH = 26 * k, bottom = y0 + H - 70 * k;
    int shown = 0;
    foreach (var d in dockRows)
    {
        if (y + rowH &gt; bottom) { Txt(ref f, "+" + (dockRows.Count - shown) + " more", x0 + 10 * k, y, 0.4f * k, C_DIM); break; }
        Color c = d.State == 2 ? C_DOCK : d.State == 1 ? C_WARN : C_DIM;
        Box(ref f, x0 + 8 * k, y + 4 * k, 4 * k, rowH - 10 * k, c);
        string label = d.Name.Length &gt; 22 ? d.Name.Substring(0, 22) : d.Name;
        Txt(ref f, label, x0 + 18 * k, y + 2 * k, 0.44f * k, C_TXT);
        Txt(ref f, d.State == 2 ? (d.Call.Length &gt; 0 ? d.Call : "occupied") : d.State == 1 ? d.Call + " inbound" : "free", x0 + W * 0.40f, y + 2 * k, 0.44f * k, c);
        if (d.State == 2 &amp;&amp; d.Call.Length &gt; 0)
        {
            Bar(ref f, x0 + W * 0.62f, y + 8 * k, W * 0.16f, 9 * k, d.Batt, LevelColor(d.Batt));
            Bar(ref f, x0 + W * 0.82f, y + 8 * k, W * 0.12f, 9 * k, d.Integ, LevelColor(d.Integ));
        }
        y += rowH; shown++;
    }
    if (dockRows.Count == 0) Txt(ref f, "no connectors tagged [Dock]", x0 + 18 * k, y, 0.44f * k, C_DIM);

    // logistics footer
    float fy = y0 + H - 62 * k;
    Box(ref f, x0, fy - 6 * k, W, 2 * k, C_PANEL);
    string rep = pRepairN &gt; 0 ? (pRepair ? "REPAIR ON" : "repair idle") : "no [Repair]";
    string rea = pRearmN &gt; 0 ? (pRearm ? "REARM ON" : "rearm idle") : "no [Rearm]";
    Txt(ref f, rep + "    " + rea, x0 + 10 * k, fy, ts, pRepair || pRearm ? C_GOOD : C_DIM);
    string chg = pCharging &lt; 0 ? "charging: unrestricted" : "charging " + pCharging + (pMaxC &gt; 0 ? "/" + pMaxC : "") + " drones";
    string res = pReserve &gt;= 0 ? "   hub battery " + Util.PctM(pReserve) : "";
    Txt(ref f, chg + res, x0 + 10 * k, fy + 24 * k, ts, C_TXT);
    f.Dispose();
}

// ============================================================================
// Shared: protocol constants (must be identical in every Fleet System script)
// ============================================================================
static class Proto
{
    public const int Version = 3;   // v3: status carries ammo (v2: NAV patrol phase/rate; ESCORT engage/leash/patrol)

    // Message types (header Item4)
    public const int M_NAV = 1, M_HELLO = 2, M_STS = 3, M_ORD = 4;

    // Orders / hub directives
    public const int O_NONE = 0, O_REGISTER = 1, O_ESCORT = 2, O_HOLD = 3, O_GOTO = 4,
                     O_DOCK = 5, O_UNDOCK = 6, O_STOP = 7;

    // Hub modes (MODE_AUTO is a setting only; the active mode is CARRIER or BASE)
    public const int MODE_AUTO = 0, MODE_CARRIER = 1, MODE_BASE = 2;

    // Drone states
    public const int S_BOOT = 0, S_UNPROV = 1, S_REGISTERING = 2, S_IDLE = 3, S_HOLD = 4,
                     S_ESCORT = 5, S_GOTO = 6, S_APPROACH = 7, S_FINAL = 8, S_DOCKED = 9,
                     S_UNDOCKING = 10, S_LINKLOST = 11, S_ERROR = 12, S_PATROL = 13, S_ENGAGED = 14;

    // Drone status flags
    public const int F_DOCKED = 1, F_WANT_RTB = 2, F_LINKLOST = 4, F_NO_THRUST = 8, F_ARRIVED = 16,
                     F_ENGAGED = 32,   // combat blocks active
                     F_CONTACT = 64;   // drone's own turrets report a target (feeds hub alert)

    // Hub alert levels
    public const int ALERT_GREEN = 0, ALERT_YELLOW = 1, ALERT_RED = 2;

    // Carrier jump interlock
    public const int JUMP_NONE = 0, JUMP_PREP = 1, JUMP_READY = 2;

    // Factory states
    public const int FAC_IDLE = 0, FAC_BUILDING = 1, FAC_SECURE = 2, FAC_RELEASE = 3, FAC_BAYBUSY = 4,
                     FAC_STALLED = 5, FAC_ERROR = 6, FAC_OFF = 7;
    static readonly string[] facs = { "IDLE", "BUILDING", "SECURING", "RELEASING", "BAY BUSY", "WAITING PARTS", "ERROR", "OFF" };
    public static string FactoryName(int s) { return s &gt;= 0 &amp;&amp; s &lt; facs.Length ? facs[s] : "?"; }

    static readonly string[] states = { "BOOT", "UNPROV", "REGISTER", "IDLE", "HOLD", "ESCORT", "GOTO",
                                        "APPROACH", "FINAL", "DOCKED", "UNDOCK", "NO LINK", "ERROR", "PATROL", "ENGAGED" };
    static readonly string[] orders = { "-", "REG", "ESCORT", "HOLD", "GOTO", "DOCK", "UNDOCK", "STOP" };
    static readonly string[] modes = { "AUTO", "CARRIER", "BASE" };
    static readonly string[] alerts = { "GREEN", "YELLOW", "RED" };

    public static string StateName(int s) { return s &gt;= 0 &amp;&amp; s &lt; states.Length ? states[s] : "?"; }
    public static string OrderName(int o) { return o &gt;= 0 &amp;&amp; o &lt; orders.Length ? orders[o] : "?"; }
    public static string ModeName(int m) { return m &gt;= 0 &amp;&amp; m &lt; modes.Length ? modes[m] : "?"; }
    public static string AlertName(int a) { return a &gt;= 0 &amp;&amp; a &lt; alerts.Length ? alerts[a] : "?"; }
}

// ============================================================================
// Shared: utilities (culture-independent parsing, formatting, vector helpers)
// ============================================================================
static class Util
{
    // FNV-1a: stable across machines (string.GetHashCode is not guaranteed to be)
    public static int Hash(string s)
    {
        unchecked
        {
            uint h = 2166136261;
            for (int i = 0; i &lt; s.Length; i++) { h ^= s[i]; h *= 16777619; }
            return (int)h;
        }
    }

    public static double Clamp(double v, double lo, double hi) { return v &lt; lo ? lo : (v &gt; hi ? hi : v); }

    public static Vector3D Norm(Vector3D v)
    {
        double l = v.Length();
        return l &gt; 1e-9 ? v / l : Vector3D.Zero;
    }

    public static Vector3D Perp(Vector3D v)
    {
        Vector3D p = Vector3D.Cross(v, Vector3D.Up);
        if (p.LengthSquared() &lt; 1e-6) p = Vector3D.Cross(v, Vector3D.Right);
        return Norm(p);
    }

    public static double Angle(Vector3D a, Vector3D b)
    {
        return Math.Acos(Clamp(Vector3D.Dot(Norm(a), Norm(b)), -1, 1));
    }

    // Parses "123", "-45.67". Always '.' as decimal separator, regardless of game locale.
    public static bool ParseD(string s, out double v)
    {
        v = 0;
        if (s == null) return false;
        s = s.Trim();
        if (s.Length == 0) return false;
        int i = 0; bool neg = false;
        if (s[0] == '-' || s[0] == '+') { neg = s[0] == '-'; i++; }
        double ip = 0, fp = 0, scale = 1; bool digits = false, dot = false;
        for (; i &lt; s.Length; i++)
        {
            char c = s[i];
            if (c &gt;= '0' &amp;&amp; c &lt;= '9')
            {
                digits = true;
                if (dot) { scale *= 0.1; fp += (c - '0') * scale; }
                else ip = ip * 10 + (c - '0');
            }
            else if (c == '.' &amp;&amp; !dot) dot = true;
            else return false;
        }
        if (!digits) return false;
        v = neg ? -(ip + fp) : ip + fp;
        return true;
    }

    // "GPS:Name:X:Y:Z:" (optionally followed by colour) anywhere inside s
    public static bool ParseGps(string s, out Vector3D p, out string name)
    {
        p = Vector3D.Zero; name = "";
        int i = s.IndexOf("GPS:");
        if (i &lt; 0) return false;
        string[] parts = s.Substring(i).Split(':');
        if (parts.Length &lt; 5) return false;
        double x, y, z;
        if (!ParseD(parts[2], out x) || !ParseD(parts[3], out y) || !ParseD(parts[4], out z)) return false;
        name = parts[1];
        p = new Vector3D(x, y, z);
        return true;
    }

    public static string Gps(string name, Vector3D p)
    {
        return "GPS:" + name + ":" + Num(p.X) + ":" + Num(p.Y) + ":" + Num(p.Z) + ":";
    }

    // Integer-based number formatting: immune to decimal-comma locales
    public static string Num(double v)
    {
        long cents = (long)Math.Round(v * 100);
        string sign = cents &lt; 0 ? "-" : "";
        cents = Math.Abs(cents);
        return sign + (cents / 100) + "." + (cents % 100).ToString("00");
    }

    public static string Pct(float f) { return f &lt; 0 ? "--" : ((int)Math.Round(f * 100)) + "%"; }
    public static string PctM(int milli) { return milli &lt; 0 ? "--" : ((milli + 5) / 10) + "%"; }

    public static string Dist(double m)
    {
        if (m &lt; 1000) return ((int)m) + "m";
        if (m &lt; 100000) return ((int)(m / 1000)) + "." + ((int)(m / 100) % 10) + "km";
        return ((int)(m / 1000)) + "km";
    }

    public static string Age(int s)
    {
        if (s &lt; 60) return s + "s";
        if (s &lt; 3600) return (s / 60) + "m";
        return (s / 3600) + "h";
    }

    public static string Clean(string s) { return s == null ? "" : s.Replace('|', '/').Replace('\n', ' ').Replace('\r', ' '); }

    public static int Milli(float f) { return f &lt; 0 ? -1 : (int)Math.Round(f * 1000); }
}

// Rolling runtime average for server-budget monitoring (target &lt;= 0.3 ms avg)
class Perf
{
    public double Avg, Peak;
    double peakT;

    public void Tick(double ms, double now)
    {
        Avg += (ms - Avg) * 0.02;
        if (ms &gt; Peak || now - peakT &gt; 10) { Peak = ms; peakT = now; }
    }

    public string Text()
    {
        return "Runtime avg " + Util.Num(Avg) + " ms (peak " + Util.Num(Peak) + ")" + (Avg &gt; 0.3 ? "  OVER BUDGET" : "");
    }
}

// ============================================================================
// Shared: Custom Data config via MyIni. Missing keys are written back with
// their defaults so every option is visible to the player.
// ============================================================================
class Cfg
{
    readonly MyIni ini = new MyIni();
    readonly IMyTerminalBlock blk;
    readonly string sec;
    bool dirty;
    public string Error = "";

    public Cfg(IMyTerminalBlock b, string section)
    {
        blk = b; sec = section;
        MyIniParseResult r;
        if (!ini.TryParse(b.CustomData, out r))
            Error = "Custom Data error (line " + r.LineNo + "): " + r.Error + ". Fix it, then recompile.";
    }

    public string S(string k, string d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToString(d);
    }

    public double D(string k, double d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToDouble(d);
    }

    public int I(string k, int d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToInt32(d);
    }

    public bool B(string k, bool d)
    {
        if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
        return ini.Get(sec, k).ToBoolean(d);
    }

    // Writes a single key, re-reading Custom Data first so player edits are not lost.
    public void Set(string k, string v)
    {
        MyIni fresh = new MyIni();
        if (!fresh.TryParse(blk.CustomData)) return;
        fresh.Set(sec, k, v);
        blk.CustomData = fresh.ToString();
        ini.Set(sec, k, v);
    }

    public void Save()
    {
        if (dirty &amp;&amp; Error.Length == 0) { blk.CustomData = ini.ToString(); dirty = false; }
    }
}

// ============================================================================
// Shared: IGC network layer. All wire formats live here so hub and drones can
// never disagree on tuple layouts. Payloads use MyTuple/Vector3D/primitives only
// (no string-encoded numbers, so no locale bugs).
//
// Header: (version, netId, keyHash, msgType, seq)
// seq for orders = (hubEpoch &lt;&lt; 32) | counter   -&gt; drones detect hub restarts
// ============================================================================
class Net
{
    public readonly IMyIntergridCommunicationSystem IGC;
    public int NetId, KeyHash;
    public string TNav = "", THello = "", TSts = "", TOrd = "", TCmd = "", TSnap = "", TFac = "", TFacSt = "";

    public Net(IMyIntergridCommunicationSystem igc) { IGC = igc; }

    public void Configure(int netId, string key)
    {
        NetId = netId;
        KeyHash = Util.Hash(key ?? "");
        string p = "FS" + netId + "/";
        TNav = p + "nav"; THello = p + "hello"; TSts = p + "sts"; TOrd = p + "ord";
        TCmd = p + "cmd"; TSnap = p + "snap"; TFac = p + "fac"; TFacSt = p + "facst";
    }

    MyTuple&lt;int, int, int, int, long&gt; Hdr(int type, long seq)
    {
        return new MyTuple&lt;int, int, int, int, long&gt;(Proto.Version, NetId, KeyHash, type, seq);
    }

    bool Ok(MyTuple&lt;int, int, int, int, long&gt; h, int type)
    {
        return h.Item1 == Proto.Version &amp;&amp; h.Item2 == NetId &amp;&amp; h.Item3 == KeyHash &amp;&amp; h.Item4 == type;
    }

    // ---------------- NAV (hub -&gt; all, broadcast) ----------------
    // phase/rate: shared patrol rotation (radians, rad/s) so all drones orbit in step
    public void SendNav(Vector3D pos, Vector3D vel, Vector3D fwd, Vector3D up, Vector3D ang,
                        Vector3D koc, double kor, int mode, int alert, double phase, double rate)
    {
        IGC.SendBroadcastMessage(TNav,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;&gt;(
                Hdr(Proto.M_NAV, 0),
                new MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;(pos, vel, fwd, up, ang),
                new MyTuple&lt;Vector3D, double, int, int, double, double&gt;(koc, kor, mode, alert, phase, rate)));
    }

    public bool ReadNav(MyIGCMessage m, HubFrame f)
    {
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;&gt;)) return false;
        var n = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;&gt;)m.Data;
        if (!Ok(n.Item1, Proto.M_NAV)) return false;
        f.Pos = n.Item2.Item1; f.Vel = n.Item2.Item2; f.Fwd = n.Item2.Item3; f.Up = n.Item2.Item4; f.AngVel = n.Item2.Item5;
        f.KoC = n.Item3.Item1; f.KoR = n.Item3.Item2; f.Mode = n.Item3.Item3; f.Alert = n.Item3.Item4;
        f.Phase = n.Item3.Item5; f.Rate = n.Item3.Item6;
        f.Valid = true;
        return true;
    }

    // ---------------- HELLO (drone -&gt; hubs, broadcast) ----------------
    public void SendHello(string role, long caps, double maxAccel, double maxSpeed, string grid)
    {
        IGC.SendBroadcastMessage(THello,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;(
                Hdr(Proto.M_HELLO, 0),
                new MyTuple&lt;string, long, double, double, string&gt;(role, caps, maxAccel, maxSpeed, grid)));
    }

    public bool ReadHello(MyIGCMessage m, out string role, out long caps, out double maxAccel, out double maxSpeed, out string grid)
    {
        role = grid = ""; caps = 0; maxAccel = maxSpeed = 0;
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;)) return false;
        var h = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;)m.Data;
        if (!Ok(h.Item1, Proto.M_HELLO)) return false;
        role = h.Item2.Item1; caps = h.Item2.Item2; maxAccel = h.Item2.Item3; maxSpeed = h.Item2.Item4; grid = h.Item2.Item5;
        return true;
    }

    // ---------------- STATUS (drone -&gt; its hub, unicast) ----------------
    // (role, state, task, ackSeq, dockId) (pos, vel) (battery, h2, cargo, integrity, ammo, flags)
    public bool SendStatus(long hub, string role, int state, int task, long ack, long dockId,
                           Vector3D pos, Vector3D vel, float batt, float h2, float cargo, float integ, float ammo, int flags)
    {
        return IGC.SendUnicastMessage(hub, TSts,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;(
                Hdr(Proto.M_STS, 0),
                new MyTuple&lt;string, int, int, long, long&gt;(role, state, task, ack, dockId),
                new MyTuple&lt;Vector3D, Vector3D&gt;(pos, vel),
                new MyTuple&lt;float, float, float, float, float, int&gt;(batt, h2, cargo, integ, ammo, flags)));
    }

    public bool ReadStatus(MyIGCMessage m, out MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt; s)
    {
        s = default(MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;);
        if (m.Tag != TSts) return false;
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;)) return false;
        s = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;)m.Data;
        return Ok(s.Item1, Proto.M_STS);
    }

    // ---------------- ORDER (hub -&gt; drone, unicast) ----------------
    // (code, a, b, c, id, text)
    public bool SendOrder(long to, long seq, int code, Vector3D a, Vector3D b, Vector3D c, long id, string text)
    {
        return IGC.SendUnicastMessage(to, TOrd,
            new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;(
                Hdr(Proto.M_ORD, seq),
                new MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;(code, a, b, c, id, text ?? "")));
    }

    public bool ReadOrder(MyIGCMessage m, out long seq, out int code, out Vector3D a, out Vector3D b, out Vector3D c, out long id, out string text)
    {
        seq = 0; code = 0; a = b = c = Vector3D.Zero; id = 0; text = "";
        if (m.Tag != TOrd) return false;
        if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;)) return false;
        var o = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;)m.Data;
        if (!Ok(o.Item1, Proto.M_ORD)) return false;
        seq = o.Item1.Item5; code = o.Item2.Item1; a = o.Item2.Item2; b = o.Item2.Item3; c = o.Item2.Item4;
        id = o.Item2.Item5; text = o.Item2.Item6;
        return true;
    }
}

// ============================================================================
// Shared: hub reference frame. The hub always broadcasts its live frame; a
// base simply has zero velocity. Drone orders are expressed in this frame.
// Local axes follow SE convention: +X right, +Y up, +Z backward (forward = -Z).
// ============================================================================
class HubFrame
{
    public Vector3D Pos, Vel, Fwd = Vector3D.Forward, Up = Vector3D.Up, AngVel, KoC;
    public double KoR, Phase, Rate;
    public int Mode, Alert;
    public double T = -1e9;     // local time the frame was received
    public bool Valid;

    // Frame extrapolated to 'now' (translation only; rotation is covered by VelAt feed-forward)
    public MatrixD Matrix(double now)
    {
        double dt = Util.Clamp(now - T, 0, 2);
        return MatrixD.CreateWorld(Pos + Vel * dt, Fwd, Up);
    }

    public Vector3D KeepOut(double now)
    {
        return KoC + Vel * Util.Clamp(now - T, 0, 2);
    }

    // Shared patrol rotation angle, extrapolated
    public double PhaseAt(double now) { return Phase + Rate * Util.Clamp(now - T, 0, 2); }

    // Rotate a hub-local vector about the local +Y (up) axis, right-handed
    public static Vector3D RotY(Vector3D v, double a)
    {
        double c = Math.Cos(a), s = Math.Sin(a);
        return new Vector3D(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c);
    }

    // Velocity of a point rigidly attached to the hub
    public Vector3D VelAt(Vector3D world, MatrixD m)
    {
        return Vel + Vector3D.Cross(AngVel, world - m.Translation);
    }

    public static Vector3D ToWorld(MatrixD m, Vector3D local) { return m.Translation + Vector3D.TransformNormal(local, m); }
    public static Vector3D ToLocal(MatrixD m, Vector3D world) { return Vector3D.TransformNormal(world - m.Translation, MatrixD.Transpose(m)); }
    public static Vector3D DirToWorld(MatrixD m, Vector3D d) { return Vector3D.TransformNormal(d, m); }
    public static Vector3D DirToLocal(MatrixD m, Vector3D d) { return Vector3D.TransformNormal(d, MatrixD.Transpose(m)); }
}
