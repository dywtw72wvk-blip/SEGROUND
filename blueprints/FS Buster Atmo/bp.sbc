              <Owner>144115188075855897</Owner>
              <ShareMode>Faction</ShareMode>
              <CustomName>Programmable Block [Fleet Drone]</CustomName>
              <Program>// FLEET SYSTEM 0.3.0-phase3 — Drone
// Generated by tools/build.py from src/ (comments stripped). Paste this whole file into the programmable block.
const string SEC = "Drone";
Net net;
Cfg cfg;
readonly Flight fl = new Flight();
readonly Telemetry tel = new Telemetry();
readonly Perf perf = new Perf();
IMyShipController ctl;
IMyShipConnector conn;
IMyRadioAntenna ant;
IMyBroadcastListener navL;
IMyUnicastListener uni;
readonly List&lt;IMyTerminalBlock&gt; blocks = new List&lt;IMyTerminalBlock&gt;();
readonly List&lt;IMyThrust&gt; thr = new List&lt;IMyThrust&gt;();
readonly List&lt;IMyGyro&gt; gyr = new List&lt;IMyGyro&gt;();
readonly List&lt;IMyShipConnector&gt; conns = new List&lt;IMyShipConnector&gt;();
readonly List&lt;IMyFunctionalBlock&gt; combat = new List&lt;IMyFunctionalBlock&gt;();
readonly List&lt;IMyTimerBlock&gt; tEng = new List&lt;IMyTimerBlock&gt;(), tDis = new List&lt;IMyTimerBlock&gt;();
readonly List&lt;IMyLargeTurretBase&gt; turrets = new List&lt;IMyLargeTurretBase&gt;();
readonly List&lt;IMyCameraBlock&gt; cams = new List&lt;IMyCameraBlock&gt;();
readonly List&lt;IMyWarhead&gt; heads = new List&lt;IMyWarhead&gt;();
readonly List&lt;IMyOffensiveCombatBlock&gt; aiOff = new List&lt;IMyOffensiveCombatBlock&gt;();
readonly List&lt;IMyFlightMovementBlock&gt; aiFly = new List&lt;IMyFlightMovementBlock&gt;();
readonly Wc wc = new Wc();
int netId;
string key = "", role = "Buster", perfMode = "NORMAL", connTag = "", ctlTag = "";
string engageMode = "STATION", combatTag = "[Combat]", engTag = "[Engage]", disTag = "[Disengage]";
double maxSpeed, dockSpeed, approach, rtbBatt, linkTimeout, clearance, reconSpeed, minAlt, standoff,
lidarRange, armDist, fuse, cone, weave, lidarStep, lidarSwath, lidarRate, rays, ringRate, handoff, ringT0;
bool provisioned, combatIdleOff = true, inFactory, targetNeutral;
double T, lastFlightT, nextSts, nextHello, nextTel, nextScan, nextEcho, stateT, navT = -1e9, lostSince, atkT, nextCon;
int wp, scanI;
MyDetectedEntityInfo det; double detT = -1e9, detSize;
MyDetectedEntityInfo held; double heldSize; int heldN;
bool reconBack;
long atkId; bool handed;
Vector3D atkAz;
int state = Proto.S_BOOT, prevState = Proto.S_IDLE;
bool registered, controlling, arrived, combatOn, leashBreak;
long hubAddr;
string call = "";
readonly HubFrame hub = new HubFrame();
int task; Vector3D tA, tB, tC; long tId;
int pTask; Vector3D pA, pB, pC; long pId;
long epoch = -1, lastN = -1, ack;
Vector3D holdPos, holdFwd = Vector3D.Forward, holdUp = Vector3D.Up;
Vector3D uP, uF; bool uLocal;
string warn = "", echo = "";
public Program()
{
net = new Net(IGC);
uni = IGC.UnicastListener;
LoadConfig();
Scan();
Load();
Resume();
Runtime.UpdateFrequency = UpdateFrequency.Update10;
}
public void Save()
{
var ini = new MyIni();
ini.Set("s", "reg", registered); ini.Set("s", "hub", hubAddr); ini.Set("s", "call", call);
ini.Set("s", "task", task); ini.Set("s", "tId", tId); ini.Set("s", "pTask", pTask); ini.Set("s", "pId", pId);
ini.Set("s", "epoch", epoch); ini.Set("s", "lastN", lastN); ini.Set("s", "ack", ack);
ini.Set("s", "base", tel.Baseline); ini.Set("s", "uLocal", uLocal);
SetV(ini, "tA", tA); SetV(ini, "tB", tB); SetV(ini, "tC", tC);
SetV(ini, "pA", pA); SetV(ini, "pB", pB); SetV(ini, "pC", pC);
SetV(ini, "hold", holdPos); SetV(ini, "hf", holdFwd); SetV(ini, "hu", holdUp);
SetV(ini, "uP", uP); SetV(ini, "uF", uF);
Storage = ini.ToString();
}
void Load()
{
var ini = new MyIni();
if (string.IsNullOrEmpty(Storage) || !ini.TryParse(Storage)) return;
registered = ini.Get("s", "reg").ToBoolean(); hubAddr = ini.Get("s", "hub").ToInt64(); call = ini.Get("s", "call").ToString("");
task = ini.Get("s", "task").ToInt32(); tId = ini.Get("s", "tId").ToInt64();
pTask = ini.Get("s", "pTask").ToInt32(); pId = ini.Get("s", "pId").ToInt64();
epoch = ini.Get("s", "epoch").ToInt64(-1); lastN = ini.Get("s", "lastN").ToInt64(-1); ack = ini.Get("s", "ack").ToInt64();
tel.Baseline = Math.Max(tel.Baseline, ini.Get("s", "base").ToInt32()); uLocal = ini.Get("s", "uLocal").ToBoolean();
tA = GetV(ini, "tA"); tB = GetV(ini, "tB"); tC = GetV(ini, "tC");
pA = GetV(ini, "pA"); pB = GetV(ini, "pB"); pC = GetV(ini, "pC");
holdPos = GetV(ini, "hold"); holdFwd = GetV(ini, "hf"); holdUp = GetV(ini, "hu");
uP = GetV(ini, "uP"); uF = GetV(ini, "uF");
}
static void SetV(MyIni ini, string k, Vector3D v) { ini.Set("v", k + "x", v.X); ini.Set("v", k + "y", v.Y); ini.Set("v", k + "z", v.Z); }
static Vector3D GetV(MyIni ini, string k) { return new Vector3D(ini.Get("v", k + "x").ToDouble(), ini.Get("v", k + "y").ToDouble(), ini.Get("v", k + "z").ToDouble()); }
void LoadConfig()
{
cfg = new Cfg(Me, SEC);
netId = cfg.I("NetId", 0);
key = cfg.S("Key", "");
bool spot = Me.CustomName.Contains("Spotter") || Me.CubeGrid.CustomName.Contains("Spotter");
role = cfg.S("Role", spot ? "Spotter" : "Buster");
perfMode = cfg.S("Perf", "Normal").ToUpper();
maxSpeed = cfg.D("MaxSpeed", 100);
dockSpeed = cfg.D("DockSpeed", 1.5);
approach = cfg.D("ApproachDistance", 25);
clearance = cfg.D("Clearance", 15);
reconSpeed = cfg.D("ReconSpeed", spot ? 35 : 60);
minAlt = cfg.D("MinAltitude", 150);
standoff = cfg.D("RingDistance", 2800);
cone = cfg.D("RingCone", 20);
ringRate = cfg.D("RingRate", 2);
handoff = cfg.D("AiHandoff", 600);
weave = cfg.D("Weave", 30);
lidarRange = cfg.D("LidarRange", 3000);
lidarStep = Math.Max(5, cfg.D("LidarStep", spot ? 40 : 50));
lidarRate = Math.Max(1, cfg.D("LidarRate", spot ? 12 : 10));
lidarSwath = cfg.D("LidarSwath", 1100);
armDist = cfg.D("ArmDistance", 300);
fuse = cfg.D("Fuse", 8);
targetNeutral = cfg.B("TargetNeutral", false);
rtbBatt = cfg.D("RtbBattery", 0.2);
linkTimeout = cfg.D("LinkTimeout", 5);
connTag = cfg.S("ConnectorTag", "");
ctlTag = cfg.S("ControllerTag", "");
engageMode = cfg.S("EngageMode", "Station").ToUpper();
combatTag = cfg.S("CombatTag", "[Combat]");
engTag = cfg.S("EngageTimerTag", "[Engage]");
disTag = cfg.S("DisengageTimerTag", "[Disengage]");
combatIdleOff = cfg.B("CombatOffWhenIdle", true);
fl.UseObserver = cfg.B("DisturbanceComp", true);
fl.Kp = cfg.D("PositionGain", 0.8);
fl.Kv = cfg.D("VelocityGain", 2.5);
fl.GyroGain = cfg.D("GyroGain", 3);
fl.GyroMax = cfg.D("GyroMaxRate", 3);
fl.GyroSign = cfg.B("GyroInvert", false) ? 1 : -1;
fl.SpeedCap = maxSpeed;
cfg.Save();
provisioned = netId != 0 &amp;&amp; key.Length &gt; 0 &amp;&amp; cfg.Error.Length == 0;
if (navL != null) IGC.DisableBroadcastListener(navL);
net.Configure(netId, key);
navL = IGC.RegisterBroadcastListener(net.TNav);
}
void Scan()
{
blocks.Clear();
GridTerminalSystem.GetBlocksOfType(blocks, b =&gt; b.IsSameConstructAs(Me));
thr.Clear(); gyr.Clear(); conns.Clear(); combat.Clear(); tEng.Clear(); tDis.Clear(); turrets.Clear(); cams.Clear(); heads.Clear(); aiOff.Clear(); aiFly.Clear();
if (!wc.Ok) wc.Init(Me);
ctl = null; conn = null; ant = null;
IMyShipController anyCtl = null;
foreach (var b in blocks)
{
var fb = b as IMyFunctionalBlock;
if (fb != null &amp;&amp; combatTag.Length &gt; 0 &amp;&amp; b.CustomName.Contains(combatTag)) combat.Add(fb);
var tm = b as IMyTimerBlock;
if (tm != null) { if (b.CustomName.Contains(engTag)) tEng.Add(tm); else if (b.CustomName.Contains(disTag)) tDis.Add(tm); }
var tu = b as IMyLargeTurretBase; if (tu != null) turrets.Add(tu);
var cm = b as IMyCameraBlock; if (cm != null) { cams.Add(cm); if (!cm.EnableRaycast) cm.EnableRaycast = true; }
var wh = b as IMyWarhead; if (wh != null) heads.Add(wh);
var ao = b as IMyOffensiveCombatBlock; if (ao != null) aiOff.Add(ao);
var af = b as IMyFlightMovementBlock; if (af != null) { aiFly.Add(af); if (af.Enabled &amp;&amp; !handed) af.Enabled = false; }
var t = b as IMyThrust; if (t != null) { thr.Add(t); continue; }
var g = b as IMyGyro; if (g != null) { gyr.Add(g); continue; }
var c = b as IMyShipController;
if (c != null)
{
if (ctlTag.Length &gt; 0 ? b.CustomName.Contains(ctlTag) : c is IMyRemoteControl) ctl = c;
if (anyCtl == null) anyCtl = c;
continue;
}
var k = b as IMyShipConnector; if (k != null) { conns.Add(k); continue; }
var a = b as IMyRadioAntenna; if (a != null &amp;&amp; (ant == null || a.IsWorking)) ant = a;
}
if (ctl == null) ctl = anyCtl;
inFactory = false;
foreach (var b in blocks) if (b != Me &amp;&amp; b is IMyProgrammableBlock &amp;&amp; (b.CustomData.Contains("[Hub]") || b.CustomData.Contains("[Factory]"))) { inFactory = true; break; }
if (ctl != null) thr.RemoveAll(t =&gt; t.CubeGrid != ctl.CubeGrid);
foreach (var k in conns) if (connTag.Length == 0 || k.CustomName.Contains(connTag)) { conn = k; break; }
tel.Bind(blocks);
if (ctl != null) fl.Bind(ctl, thr, gyr);
if (combatIdleOff || combatOn) foreach (var b in combat) if (b.Enabled != combatOn) b.Enabled = combatOn;
var w = new StringBuilder();
if (cfg.Error.Length &gt; 0) w.Append(cfg.Error).Append('\n');
if (ctl == null) w.Append("ERROR: no remote control / cockpit.\n");
if (thr.Count == 0) w.Append("ERROR: no thrusters.\n");
if (gyr.Count == 0) w.Append("ERROR: no gyroscopes.\n");
if (conn == null) w.Append("WARN: no connector" + (connTag.Length &gt; 0 ? " tagged " + connTag : "") + ": cannot dock.\n");
if (ant == null) w.Append("WARN: no antenna: no hub link.\n");
if (cams.Count == 0 &amp;&amp; turrets.Count == 0) w.Append("WARN: no camera: cannot search for targets.\n");
else if (!ant.IsWorking || !ant.EnableBroadcasting) w.Append("WARN: antenna off or not broadcasting.\n");
if (engageMode == "AI" &amp;&amp; combat.Count == 0 &amp;&amp; tEng.Count == 0) w.Append("WARN: EngageMode=AI but no " + combatTag + " blocks or " + engTag + " timers.\n");
warn = w.ToString();
}
void Resume()
{
if (ctl == null) return;
if (Connected()) { Enter(Proto.S_DOCKED); return; }
switch (task)
{
case Proto.O_ESCORT: Enter(Proto.S_ESCORT); break;
case Proto.O_GOTO: Enter(Proto.S_GOTO); break;
case Proto.O_DOCK: Enter(Proto.S_APPROACH); break;
case Proto.O_HOLD: Enter(Proto.S_HOLD); break;
case Proto.O_SEARCH: wp = 0; reconBack = false; Enter(Proto.S_RECON); break;
case Proto.O_ATTACK: atkT = T; atkId = tId; Enter(Proto.S_ATTACK); SetCombat(true); break;
case Proto.O_LOITER: atkT = T; atkId = tId; ringT0 = T; Enter(Proto.S_LOITER); break;
case Proto.O_INTERCEPT: atkT = T; atkId = tId; handed = false; Enter(Proto.S_INTERCEPT); break;
case Proto.O_UNDOCK:
if (pTask != Proto.O_NONE) Enter(Proto.S_UNDOCKING);
else { CaptureHold(); Enter(Proto.S_HOLD); }
break;
default: Enter(Proto.S_IDLE); break;
}
}
public void Main(string arg, UpdateType src)
{
T += Runtime.TimeSinceLastRun.TotalSeconds;
perf.Tick(Runtime.LastRunTimeMs, T);
if (!string.IsNullOrEmpty(arg)) Command(arg.Trim().ToLower());
if ((src &amp; (UpdateType.Update1 | UpdateType.Update10 | UpdateType.Update100)) != 0) Tick();
Echo(echo);
}
void Command(string a)
{
if (a == "provision" || a == "reload")
{
LoadConfig(); Scan();
registered = false; nextHello = T;
}
else if (a == "reset")
{
registered = false; hubAddr = 0; epoch = -1; lastN = -1; task = Proto.O_NONE; pTask = Proto.O_NONE;
if (ctl != null) { fl.Release(true); Enter(Connected() ? Proto.S_DOCKED : Proto.S_IDLE); }
}
else if (a == "stop")
{
task = Proto.O_STOP; pTask = Proto.O_NONE;
if (ctl != null) { fl.Release(true); Enter(Connected() ? Proto.S_DOCKED : Proto.S_IDLE); }
}
else if (a == "rescan") Scan();
BuildEcho();
}
void Tick()
{
if (T &gt;= nextScan) { Scan(); nextScan = T + 10; }
if (inFactory)
{
if (controlling &amp;&amp; ctl != null) fl.Release(true);
controlling = false; state = Proto.S_BOOT;
if (T &gt;= nextEcho) { BuildEcho(); nextEcho = T + 1; }
nextScan = Math.Min(nextScan, T + 2);
return;
}
if (ctl == null || thr.Count == 0 || gyr.Count == 0 || !provisioned)
{
if (controlling &amp;&amp; ctl != null) fl.Release(true);
controlling = false;
state = provisioned ? Proto.S_ERROR : Proto.S_UNPROV;
SetFreq();
if (T &gt;= nextEcho) { BuildEcho(); nextEcho = T + 1; }
return;
}
if (state == Proto.S_UNPROV || state == Proto.S_ERROR || state == Proto.S_BOOT) Resume();
Receive();
double dt = T - lastFlightT;
lastFlightT = T;
if (dt &lt;= 0 || dt &gt; 1) dt = 1.0 / 60;
fl.Sense(dt);
if (T &gt;= nextTel) { tel.Read(); nextTel = T + 0.5; }
if (state == Proto.S_RECON || state == Proto.S_ATTACK || state == Proto.S_LOITER || state == Proto.S_INTERCEPT) Lidar();
Step();
if (registered) { if (T &gt;= nextSts) { SendStatus(); nextSts = T + 0.5; } if (T &gt;= nextCon) { ReportContact(); nextCon = T + 1; } }
else if (T &gt;= nextHello) { net.SendHello(role, 0, fl.MaxAccel, maxSpeed, Me.CubeGrid.CustomName); nextHello = T + 3; }
SetFreq();
if (T &gt;= nextEcho) { BuildEcho(); nextEcho = T + 0.5; }
}
void Receive()
{
while (navL.HasPendingMessage)
{
var m = navL.AcceptMessage();
if (!registered || m.Source != hubAddr) continue;
if (net.ReadNav(m, hub)) { hub.T = T; navT = T; }
}
while (uni.HasPendingMessage)
{
var m = uni.AcceptMessage();
long seq; int code; Vector3D a, b, c; long id; string text;
if (!net.ReadOrder(m, out seq, out code, out a, out b, out c, out id, out text)) continue;
if (code == Proto.O_REGISTER)
{
if (registered &amp;&amp; m.Source != hubAddr &amp;&amp; NavFresh()) continue;
hubAddr = m.Source; registered = true; call = text;
}
else if (!registered || m.Source != hubAddr) continue;
long ep = seq &gt;&gt; 32, n = seq &amp; 0xFFFFFFFFL;
if (ep != epoch) { epoch = ep; lastN = -1; }
if (n &lt;= lastN) continue;
lastN = n; ack = seq;
if (code != Proto.O_REGISTER) Apply(code, a, b, c, id);
nextSts = T;
}
}
void SendStatus()
{
bool docked = Connected();
int f = 0;
if (docked) f |= Proto.F_DOCKED;
if (!docked &amp;&amp; tel.Batt &gt;= 0 &amp;&amp; tel.Batt &lt; rtbBatt) f |= Proto.F_WANT_RTB;
if (state == Proto.S_LINKLOST) f |= Proto.F_LINKLOST;
if (!docked &amp;&amp; !fl.HasThrust) f |= Proto.F_NO_THRUST;
if (arrived) f |= Proto.F_ARRIVED;
if (combatOn) f |= Proto.F_ENGAGED;
if (!docked &amp;&amp; T - detT &lt; 3) f |= Proto.F_CONTACT;
long dockId = docked &amp;&amp; conn.OtherConnector != null ? conn.OtherConnector.EntityId : 0;
net.SendStatus(hubAddr, role, state, task, ack, dockId, fl.Pos, fl.Vel, tel.Batt, tel.H2, tel.Cargo, tel.Integ, tel.Ammo, f);
}
void Apply(int code, Vector3D a, Vector3D b, Vector3D c, long id)
{
bool connected = Connected();
switch (code)
{
case Proto.O_ESCORT:
case Proto.O_HOLD:
case Proto.O_GOTO:
case Proto.O_SEARCH:
case Proto.O_ATTACK:
case Proto.O_LOITER:
case Proto.O_INTERCEPT:
if (connected) { task = code; SetPending(code, a, b, c, id); BeginUndock(); }
else if (state == Proto.S_UNDOCKING) { task = code; SetPending(code, a, b, c, id); }
else Execute(code, a, b, c, id);
break;
case Proto.O_DOCK:
pTask = Proto.O_NONE;
if (connected)
{
if (conn.OtherConnector != null &amp;&amp; conn.OtherConnector.EntityId == id) { Store(code, a, b, c, id); Enter(Proto.S_DOCKED); }
else { task = code; SetPending(code, a, b, c, id); BeginUndock(); }
}
else Execute(code, a, b, c, id);
break;
case Proto.O_UNDOCK:
task = code; pTask = Proto.O_NONE;
if (connected) BeginUndock();
else if (state == Proto.S_APPROACH || state == Proto.S_FINAL) StationHere();
break;
case Proto.O_STOP:
task = code; pTask = Proto.O_NONE;
if (connected) Enter(Proto.S_DOCKED);
else { fl.Release(true); Enter(Proto.S_IDLE); }
break;
}
}
void Store(int code, Vector3D a, Vector3D b, Vector3D c, long id) { task = code; tA = a; tB = b; tC = c; tId = id; }
void SetPending(int code, Vector3D a, Vector3D b, Vector3D c, long id) { pTask = code; pA = a; pB = b; pC = c; pId = id; }
void Execute(int code, Vector3D a, Vector3D b, Vector3D c, long id)
{
Store(code, a, b, c, id);
arrived = false;
switch (code)
{
case Proto.O_ESCORT:
if (state != Proto.S_ESCORT &amp;&amp; state != Proto.S_PATROL &amp;&amp; state != Proto.S_ENGAGED) Enter(Proto.S_ESCORT);
break;
case Proto.O_HOLD: CaptureHold(); Enter(Proto.S_HOLD); break;
case Proto.O_GOTO: CaptureHold(); Enter(Proto.S_GOTO); break;
case Proto.O_DOCK: Enter(Proto.S_APPROACH); break;
case Proto.O_SEARCH: wp = 0; reconBack = false; Enter(Proto.S_RECON); break;
case Proto.O_ATTACK:
atkT = T; atkId = id;
if (state != Proto.S_ATTACK) { atkAz = Vector3D.Zero; Enter(Proto.S_ATTACK); }
if (!combatOn) SetCombat(true);
break;
case Proto.O_LOITER:
atkT = T;
if (state != Proto.S_LOITER || id != atkId) { atkId = id; ringT0 = T; atkAz = Vector3D.Zero; }
if (state != Proto.S_LOITER &amp;&amp; state != Proto.S_INTERCEPT) Enter(Proto.S_LOITER);
break;
case Proto.O_INTERCEPT:
atkT = T; atkId = id;
if (state != Proto.S_INTERCEPT) { handed = false; Enter(Proto.S_INTERCEPT); }
break;
}
}
void CaptureHold()
{
holdPos = fl.Pos;
holdFwd = ctl.WorldMatrix.Forward;
holdUp = ctl.WorldMatrix.Up;
}
void StationHere()
{
if (NavFresh())
{
MatrixD m = hub.Matrix(T);
Store(Proto.O_ESCORT, HubFrame.ToLocal(m, fl.Pos), HubFrame.DirToLocal(m, ctl.WorldMatrix.Forward), Vector3D.Zero, 0);
Enter(Proto.S_ESCORT);
}
else { CaptureHold(); Enter(Proto.S_HOLD); }
}
void BeginUndock()
{
var oc = conn != null ? conn.OtherConnector : null;
if (oc != null) { uF = oc.WorldMatrix.Forward; uP = oc.GetPosition(); }
else if (conn != null) { uF = -conn.WorldMatrix.Forward; uP = conn.GetPosition(); }
else { uF = -ctl.WorldMatrix.Forward; uP = fl.Pos; }
uLocal = NavFresh();
if (uLocal) { MatrixD m = hub.Matrix(T); uP = HubFrame.ToLocal(m, uP); uF = HubFrame.DirToLocal(m, uF); }
DockedPower(false);
if (conn != null) conn.Disconnect();
Enter(Proto.S_UNDOCKING);
}
void Enter(int s)
{
bool flying = s == Proto.S_HOLD || s == Proto.S_ESCORT || s == Proto.S_PATROL || s == Proto.S_GOTO || s == Proto.S_APPROACH ||
s == Proto.S_FINAL || s == Proto.S_UNDOCKING || s == Proto.S_LINKLOST || s == Proto.S_RECON || s == Proto.S_ATTACK ||
s == Proto.S_LOITER || s == Proto.S_INTERCEPT;
bool station = s == Proto.S_ESCORT || s == Proto.S_PATROL || s == Proto.S_ENGAGED;
if (!station) { leashBreak = false; if (combatOn) SetCombat(false); }
if (s == Proto.S_DOCKED) { fl.Release(true); DockedPower(true); controlling = false; }
else if (s == Proto.S_ENGAGED) { if (controlling) fl.Release(true); controlling = false; }
else if (!flying) { if (controlling) fl.Release(true); controlling = false; }
else if (!controlling) { fl.Engage(); controlling = true; }
fl.Freeze = s == Proto.S_FINAL;
if (s != Proto.S_ATTACK &amp;&amp; s != Proto.S_INTERCEPT) foreach (var w in heads) if (!w.Closed &amp;&amp; w.IsArmed) w.IsArmed = false;
if (s != Proto.S_INTERCEPT &amp;&amp; handed) { handed = false; foreach (var b in aiFly) if (!b.Closed) b.Enabled = false; }
state = s; stateT = T;
}
void Step()
{
bool fresh = NavFresh();
switch (state)
{
case Proto.S_IDLE:
if (Connected()) Enter(Proto.S_DOCKED);
break;
case Proto.S_HOLD:
if (Connected()) { Enter(Proto.S_DOCKED); break; }
FlyHoldAt(holdPos);
break;
case Proto.S_ESCORT:
case Proto.S_PATROL:
case Proto.S_ENGAGED:
if (!fresh) { LinkLost(); break; }
FlyStation();
break;
case Proto.S_GOTO:
FlyGoto();
break;
case Proto.S_APPROACH:
if (!fresh) { LinkLost(); break; }
FlyApproach();
break;
case Proto.S_FINAL:
if (!fresh) { LinkLost(); break; }
FlyFinal();
break;
case Proto.S_DOCKED:
if (conn != null &amp;&amp; conn.Status == MyShipConnectorStatus.Connectable) conn.Connect();
else if (!Connected()) { DockedPower(false); CaptureHold(); Enter(Proto.S_HOLD); }
break;
case Proto.S_UNDOCKING:
FlyUndock();
break;
case Proto.S_RECON:
FlyRecon();
break;
case Proto.S_ATTACK:
FlyAttack();
break;
case Proto.S_LOITER:
FlyLoiter();
break;
case Proto.S_INTERCEPT:
FlyIntercept();
break;
case Proto.S_LINKLOST:
FlyHoldAt(holdPos);
if (fresh) Enter(prevState);
else if (registered &amp;&amp; T - lostSince &gt; 60) { registered = false; nextHello = T; }
break;
}
}
void LinkLost()
{
prevState = state == Proto.S_ENGAGED ? Proto.S_ESCORT : state; lostSince = T;
CaptureHold();
Enter(Proto.S_LINKLOST);
}
void FlyHoldAt(Vector3D p)
{
fl.FlyTo(p, Vector3D.Zero, maxSpeed);
fl.Aim(ctl.WorldMatrix, holdFwd, UpRef(holdUp));
}
Vector3D UpRef(Vector3D fallback)
{
return fl.Grav.LengthSquared() &gt; 0.01 ? -Util.Norm(fl.Grav) : fallback;
}
void FlyStation()
{
MatrixD m = hub.Matrix(T);
Vector3D off = tA, face = tB.LengthSquared() &gt; 0.1 ? tB : new Vector3D(0, 0, -1);
bool patrol = tC.Z &gt; 0.5, engage = tC.X &gt; 0.5;
double leash = tC.Y &gt; 1 ? tC.Y : 600;
Vector3D center = hub.KeepOut(T);
if (patrol)
{
Vector3D lc = HubFrame.ToLocal(m, center);
double ph = hub.PhaseAt(T);
off = lc + HubFrame.RotY(tA - lc, ph);
face = HubFrame.RotY(face, ph);
}
Vector3D tgt = HubFrame.ToWorld(m, off);
Vector3D tv = hub.VelAt(tgt, m);
if (patrol) tv += Vector3D.Cross(m.Up * hub.Rate, tgt - center);
double away = (fl.Pos - tgt).Length();
if (engage &amp;&amp; engageMode == "AI" &amp;&amp; !leashBreak)
{
if (away &gt; leash) leashBreak = true;
else
{
if (state != Proto.S_ENGAGED) { SetCombat(true); Enter(Proto.S_ENGAGED); }
return;
}
}
if (leashBreak &amp;&amp; (!engage || away &lt; leash * 0.3)) leashBreak = false;
int want = patrol ? Proto.S_PATROL : Proto.S_ESCORT;
if (state != want) Enter(want);
bool combatWanted = engage &amp;&amp; engageMode != "AI";
if (combatOn != combatWanted) SetCombat(combatWanted);
fl.FlyTo(Avoid(tgt, m), tv, maxSpeed);
fl.Aim(ctl.WorldMatrix, HubFrame.DirToWorld(m, face), m.Up);
}
void FlyRecon()
{
double depth = tB.Length();
Vector3D f = Util.Norm(tB), u = UpRef(ctl.WorldMatrix.Up);
double along = Util.Clamp(Vector3D.Dot(fl.Pos - tA, f), 0, depth), look = Math.Max(300, reconSpeed * 6);
bool report = heldN &gt; 0 &amp;&amp; !InRange();
if (along &gt; depth - 150 || report) reconBack = true;
Vector3D dir = reconBack ? -f : f;
Vector3D dest = tA + f * Util.Clamp(along + (reconBack ? -look : look), 0, depth);
fl.FlyTo(Lift(dest), Vector3D.Zero, report ? maxSpeed : reconSpeed);
Vector3D h = dir - u * Vector3D.Dot(dir, u);
if (h.LengthSquared() &gt; 0.01) holdFwd = Util.Norm(h);
fl.Aim(ctl.WorldMatrix, holdFwd, u);
arrived = reconBack &amp;&amp; along &lt; 150;
}
bool InRange() { return NavFresh() &amp;&amp; (ant == null || (hub.Pos - fl.Pos).Length() &lt; ant.Radius - 300); }
bool Fix() { return det.EntityId == tId &amp;&amp; T - detT &lt; 2; }
Vector3D AtkPos() { return Fix() ? det.Position + (Vector3D)det.Velocity * (T - detT) : tA + tB * Math.Min(5, T - atkT); }
Vector3D AtkVel() { return Fix() ? (Vector3D)det.Velocity : tB; }
void FlyLoiter()
{
Vector3D tp = AtkPos(), tv = AtkVel(), u = UpRef(ctl.WorldMatrix.Up), e1 = Util.Norm(Util.Perp(u)), e2 = Vector3D.Cross(u, e1);
double R = tC.Z &gt; 1 ? tC.Z : standoff, th = cone * Math.PI / 180, w = ringRate * Math.PI / 180;
double a = 2 * Math.PI * tC.X / Math.Max(1, tC.Y) + w * (T - ringT0);
Vector3D rad = e1 * Math.Cos(a) + e2 * Math.Sin(a), tan = e2 * Math.Cos(a) - e1 * Math.Sin(a);
Vector3D slot = tp + (u * Math.Cos(th) + rad * Math.Sin(th)) * R;
fl.FlyTo(Lift(slot), tv + tan * (w * R * Math.Sin(th)), maxSpeed);
atkAz = rad;
AimLevel(tp - fl.Pos, u);
arrived = (slot - fl.Pos).Length() &lt; 100;
}
void FlyAttack()
{
Vector3D tp = AtkPos() + tC, tv = AtkVel(), u = UpRef(ctl.WorldMatrix.Up), to = tp - fl.Pos;
double dist = to.Length();
if (atkAz.LengthSquared() &lt; 0.5) { Vector3D h = -to - u * Vector3D.Dot(-to, u); atkAz = h.LengthSquared() &gt; 1 ? Util.Norm(h) : Util.Norm(Util.Perp(u)); }
double closing = Math.Max(20, Vector3D.Dot(fl.Vel - tv, Util.Norm(to)));
Vector3D aim = tp + tv * Math.Min(6, dist / closing), dir = Util.Norm(aim - fl.Pos);
Vector3D side = Util.Norm(Vector3D.Cross(dir, atkAz));
aim += side * (weave * Util.Clamp((dist - armDist) / Math.Max(1, standoff - armDist), 0, 1) * Math.Sin(T * 1.6 + tC.X * 0.01));
Terminal(aim, dir, tv, dist, u, Fix() ? detSize * 0.4 : 0);
}
void Terminal(Vector3D aim, Vector3D dir, Vector3D tv, double dist, Vector3D u, double size)
{
fl.FlyTo(aim + dir * 300, tv, maxSpeed);
AimLevel(dir, u);
bool arm = dist &lt; armDist;
foreach (var w in heads) if (!w.Closed &amp;&amp; w.IsArmed != arm) w.IsArmed = arm;
if (arm &amp;&amp; dist &lt; fuse + size) foreach (var w in heads) if (!w.Closed) w.Detonate();
}
void FlyIntercept()
{
if (handed) return;
Vector3D tp = AtkPos(), tv = AtkVel(), u = UpRef(ctl.WorldMatrix.Up), to = tp - fl.Pos;
double dist = to.Length();
if (atkAz.LengthSquared() &lt; 0.5) atkAz = Util.Norm(Util.Perp(u));
if (dist &lt; handoff &amp;&amp; aiFly.Count &gt; 0 &amp;&amp; aiOff.Count &gt; 0)
{
fl.Release(true); controlling = false; handed = true;
foreach (var b in aiFly) if (!b.Closed) b.Enabled = true;
foreach (var b in aiOff) if (!b.Closed &amp;&amp; !b.Enabled) b.Enabled = true;
foreach (var w in heads) if (!w.Closed) w.IsArmed = true;
return;
}
double closing = Math.Max(20, Vector3D.Dot(fl.Vel - tv, Util.Norm(to)));
Vector3D aim = tp + tv * Math.Min(6, dist / closing);
Terminal(aim, Util.Norm(aim - fl.Pos), tv, dist, u, Fix() ? detSize * 0.4 : 0);
}
void AimLevel(Vector3D dir, Vector3D u)
{
Vector3D h = dir - u * Vector3D.Dot(dir, u);
if (h.LengthSquared() &lt; 0.01) h = -atkAz;
if (h.LengthSquared() &gt; 0.01) holdFwd = Util.Norm(h);
fl.Aim(ctl.WorldMatrix, holdFwd, u);
}
static readonly float[] Pitches = { -6, -15, -28 };
void Lidar()
{
rays = Math.Min(lidarRate, rays + lidarRate * Math.Max(0, Math.Min(0.2, Runtime.TimeSinceLastRun.TotalSeconds)));
double e = 0;
bool ground = state == Proto.S_RECON &amp;&amp; fl.Grav.LengthSquared() &gt; 0.01
&amp;&amp; ctl.TryGetPlanetElevation(MyPlanetElevation.Surface, out e) &amp;&amp; e &lt; 1500;
Vector3D u = UpRef(ctl.WorldMatrix.Up), f = holdFwd, r = Vector3D.Cross(f, u);
double half = lidarSwath / 2, near = Math.Sqrt(half * half + e * e) + 60;
int cols = (int)(lidarSwath / lidarStep) + 1;
foreach (var c in cams)
{
if (c.Closed || !c.IsWorking || rays &lt; 1) continue;
Vector3D cp = c.GetPosition();
if (state != Proto.S_RECON)
{
if (handed) continue;
Vector3D tp = AtkPos();
double d = (tp - cp).Length() + 50;
if (d &lt; lidarRange * 2 &amp;&amp; c.CanScan(d)) { rays--; Seen(c.Raycast(tp)); }
continue;
}
if (ground &amp;&amp; Vector3D.Dot(c.WorldMatrix.Forward, u) &lt; -0.7)
{
int n = Math.Max(3, (int)(1.4 * e / lidarStep) + 1);
while (rays &gt;= 1)
{
int col = scanI % n, row = (scanI / n) % 2;
float yaw = (float)(-35 + 70.0 * col / (n - 1)), pitch = row == 0 ? 25 : 10;
double rng = e * 1.2 / (Math.Cos(yaw * Math.PI / 180) * Math.Cos(pitch * Math.PI / 180)) + 30;
if (!c.CanScan(rng)) break;
scanI++; rays--;
Seen(c.Raycast(rng, pitch, yaw));
}
continue;
}
if (ground)
{
while (rays &gt;= 1)
{
int col = scanI % cols;
Vector3D gp = fl.Pos - u * e + f * near + r * (-half + col * lidarStep);
Vector3D ray = (gp - cp) * 1.15;
if (!c.CanScan(ray.Length())) break;
scanI++; rays--;
Seen(c.Raycast(cp + ray));
}
continue;
}
if (!c.CanScan(lidarRange)) continue;
int yi = scanI % 9, pi = (scanI / 9) % Pitches.Length;
scanI++; rays--;
Seen(c.Raycast(lidarRange, Pitches[pi], -40 + yi * 10));
}
}
void Seen(MyDetectedEntityInfo e)
{
if (e.IsEmpty()) return;
var rel = e.Relationship;
if (rel != MyRelationsBetweenPlayerAndBlock.Enemies &amp;&amp; !(targetNeutral &amp;&amp; (rel == MyRelationsBetweenPlayerAndBlock.Neutral || rel == MyRelationsBetweenPlayerAndBlock.NoOwnership))) return;
if (e.Type != MyDetectedEntityType.SmallGrid &amp;&amp; e.Type != MyDetectedEntityType.LargeGrid) return;
double s = e.BoundingBox.Size.Length();
if (T - detT &gt; 3 || s &gt;= detSize || e.EntityId == det.EntityId || e.EntityId == tId) { det = e; detSize = s; detT = T; }
}
void ReportContact()
{
foreach (var t in turrets) if (!t.Closed &amp;&amp; t.IsWorking &amp;&amp; t.HasTarget) Seen(t.GetTargetedEntity());
if (wc.Ok) foreach (var kv in wc.Threats(Me)) Seen(kv.Key);
bool fresh = T - detT &lt; 2, near = InRange();
if (fresh &amp;&amp; !near) { held = det; heldSize = detSize; heldN = 5; }
if (fresh &amp;&amp; near) { net.SendContact(hubAddr, det.EntityId, (int)det.Type, detSize, det.Position, det.Velocity); heldN = 0; }
else if (heldN &gt; 0 &amp;&amp; near) { net.SendContact(hubAddr, held.EntityId, (int)held.Type, heldSize, held.Position, held.Velocity); heldN--; }
}
Vector3D Lift(Vector3D p)
{
double e;
if (fl.Grav.LengthSquared() &lt; 0.01 || !ctl.TryGetPlanetElevation(MyPlanetElevation.Surface, out e) || e &gt;= minAlt) return p;
Vector3D u = -Util.Norm(fl.Grav);
return p + u * (Vector3D.Dot(fl.Pos - p, u) + (minAlt - e));
}
void SetCombat(bool on)
{
if (on || combatIdleOff) foreach (var b in combat) if (!b.Closed &amp;&amp; b.Enabled != on) b.Enabled = on;
foreach (var t in on ? tEng : tDis) if (!t.Closed &amp;&amp; t.IsFunctional) t.Trigger();
combatOn = on;
}
void FlyGoto()
{
Vector3D wp = NavFresh() ? Avoid(tA, hub.Matrix(T)) : tA;
double dist = (tA - fl.Pos).Length();
fl.FlyTo(wp, Vector3D.Zero, maxSpeed);
if (dist &gt; 50) { holdFwd = Util.Norm(wp - fl.Pos); holdUp = ctl.WorldMatrix.Up; }
fl.Aim(ctl.WorldMatrix, holdFwd, UpRef(holdUp));
arrived = dist &lt; 3 &amp;&amp; fl.Vel.Length() &lt; 0.5;
}
void DockFrame(MatrixD m, out Vector3D P, out Vector3D F, out Vector3D U)
{
P = HubFrame.ToWorld(m, tA);
F = Util.Norm(HubFrame.DirToWorld(m, tB));
U = Util.Norm(HubFrame.DirToWorld(m, tC));
}
void FlyApproach()
{
if (conn == null) { CaptureHold(); Enter(Proto.S_HOLD); return; }
MatrixD m = hub.Matrix(T);
Vector3D P, F, U; DockFrame(m, out P, out F, out U);
Vector3D A = P + F * approach;
Vector3D cp = conn.GetPosition();
Vector3D off = cp - fl.Pos;
Vector3D tv = hub.VelAt(A, m);
fl.FlyTo(Avoid(A - off, m), tv, maxSpeed);
fl.Aim(conn.WorldMatrix, -F, U);
double posErr = (cp - A).Length();
double relV = (fl.Vel - tv).Length();
if (posErr &lt; 1.5 &amp;&amp; relV &lt; 1.0 &amp;&amp; Flight.AimError(conn.WorldMatrix, -F) &lt; 0.05) Enter(Proto.S_FINAL);
}
void FlyFinal()
{
MatrixD m = hub.Matrix(T);
Vector3D P, F, U; DockFrame(m, out P, out F, out U);
Vector3D cp = conn.GetPosition();
Vector3D rel = cp - P;
double axial = Vector3D.Dot(rel, F);
double lateral = (rel - F * axial).Length();
if (lateral &gt; 2.5 || axial &lt; -1 || T - stateT &gt; 60) { Enter(Proto.S_APPROACH); return; }
if (conn.Status == MyShipConnectorStatus.Connectable) conn.Connect();
if (conn.Status == MyShipConnectorStatus.Connected) { Enter(Proto.S_DOCKED); return; }
fl.FlyTo(P - (cp - fl.Pos), hub.VelAt(P, m), dockSpeed);
fl.Aim(conn.WorldMatrix, -F, U);
}
void FlyUndock()
{
Vector3D P, F, tv;
if (uLocal)
{
MatrixD m = hub.Matrix(T);
P = HubFrame.ToWorld(m, uP); F = Util.Norm(HubFrame.DirToWorld(m, uF)); tv = hub.VelAt(P, m);
}
else { P = uP; F = Util.Norm(uF); tv = Vector3D.Zero; }
Vector3D cp = conn != null ? conn.GetPosition() : fl.Pos;
fl.FlyTo(P + F * approach - (cp - fl.Pos), tv, Math.Max(dockSpeed * 3, 5));
if (conn != null) fl.Aim(conn.WorldMatrix, -F, conn.WorldMatrix.Up);
double outDist = Vector3D.Dot(cp - P, F);
if (outDist &gt; approach * 0.8 || T - stateT &gt; 30)
{
if (pTask != Proto.O_NONE)
{
int c = pTask; pTask = Proto.O_NONE;
Execute(c, pA, pB, pC, pId);
}
else StationHere();
}
}
Vector3D Avoid(Vector3D tgt, MatrixD m)
{
if (!hub.Valid || hub.BoxH.LengthSquared() &lt; 1) return tgt;
Vector3D h = hub.BoxH + new Vector3D(clearance), bc = hub.BoxC;
Vector3D p = HubFrame.ToLocal(m, fl.Pos) - bc, t = HubFrame.ToLocal(m, tgt) - bc;
if (InBox(p, h))
{
if (InBox(t, h) || (t - p).Length() &lt; clearance) return tgt;
return HubFrame.ToWorld(m, bc + OutOf(p, h, 1.1));
}
if (!SegHits(p, t, h)) return tgt;
Vector3D d = t - p;
Vector3D q = p + d * Util.Clamp(-Vector3D.Dot(p, d) / Math.Max(1e-6, d.LengthSquared()), 0, 1);
return HubFrame.ToWorld(m, bc + OutOf(q, h, 1.2));
}
static double Dim(Vector3D v, int i) { return i == 0 ? v.X : i == 1 ? v.Y : v.Z; }
static bool InBox(Vector3D v, Vector3D h) { return Math.Abs(v.X) &lt; h.X &amp;&amp; Math.Abs(v.Y) &lt; h.Y &amp;&amp; Math.Abs(v.Z) &lt; h.Z; }
static Vector3D OutOf(Vector3D v, Vector3D h, double k)
{
int ax = 0; double best = -1;
for (int i = 0; i &lt; 3; i++) { double r = Math.Abs(Dim(v, i)) / Math.Max(1, Dim(h, i)); if (r &gt; best) { best = r; ax = i; } }
double s = Dim(v, ax) &lt; 0 ? -1 : 1, e = s * Dim(h, ax) * k;
return new Vector3D(ax == 0 ? e : v.X, ax == 1 ? e : v.Y, ax == 2 ? e : v.Z);
}
static bool SegHits(Vector3D p, Vector3D t, Vector3D h)
{
double t0 = 0, t1 = 1;
for (int i = 0; i &lt; 3; i++)
{
double pi = Dim(p, i), di = Dim(t, i) - pi, hi = Dim(h, i);
if (Math.Abs(di) &lt; 1e-9) { if (pi &lt; -hi || pi &gt; hi) return false; continue; }
double a = (-hi - pi) / di, b = (hi - pi) / di;
if (a &gt; b) { double x = a; a = b; b = x; }
t0 = Math.Max(t0, a); t1 = Math.Min(t1, b);
if (t0 &gt; t1) return false;
}
return true;
}
bool Connected() { return conn != null &amp;&amp; conn.Status == MyShipConnectorStatus.Connected; }
bool NavFresh() { return hub.Valid &amp;&amp; T - navT &lt; linkTimeout; }
void DockedPower(bool docked)
{
fl.SetPower(!docked);
foreach (var b in tel.Bats)
{
if (!docked &amp;&amp; !b.Enabled) b.Enabled = true;
var mode = docked ? ChargeMode.Recharge : ChargeMode.Auto;
if (b.ChargeMode != mode) b.ChargeMode = mode;
}
}
void SetFreq()
{
bool active = controlling || state == Proto.S_UNDOCKING;
UpdateFrequency want = perfMode == "HIGH" ? UpdateFrequency.Update1
: perfMode == "LOW" ? UpdateFrequency.Update10
: (active ? UpdateFrequency.Update1 : UpdateFrequency.Update10);
if (Runtime.UpdateFrequency != want) Runtime.UpdateFrequency = want;
}
void BuildEcho()
{
var sb = new StringBuilder();
sb.Append("FLEET DRONE  ").Append(call.Length &gt; 0 ? call : Me.CubeGrid.CustomName).Append("  [").Append(role).Append("]\n");
if (inFactory) sb.Append("IN FACTORY BAY: waiting for release\n");
sb.Append("State: ").Append(Proto.StateName(state)).Append("   Order: ").Append(Proto.OrderName(task)).Append('\n');
if (!provisioned) sb.Append("NOT PROVISIONED\nDock to a hub (auto-provision) or set\nNetId + Key in Custom Data, then run 'provision'.\n");
else sb.Append("Net ").Append(netId).Append("   Hub: ").Append(registered ? (NavFresh() ? "linked" : "NO SIGNAL") : "searching...").Append('\n');
sb.Append("Battery ").Append(Util.Pct(tel.Batt)).Append("   Hull ").Append(Util.Pct(tel.Integ)).Append("   Speed ").Append((int)fl.Vel.Length()).Append(" m/s\n");
sb.Append("Engage mode ").Append(engageMode).Append("   Combat ").Append(combatOn ? "ON" : "off")
.Append("   (").Append(heads.Count).Append(" warheads, ").Append(cams.Count).Append(" cameras, ").Append(aiOff.Count + aiFly.Count).Append(" AI)").Append(handed ? "  AI FLYING" : "").Append("\n");
sb.Append(perf.Text()).Append('\n');
sb.Append(warn);
echo = sb.ToString();
}
class Flight
{
public IMyShipController Ctl;
readonly List&lt;IMyThrust&gt;[] grp = new List&lt;IMyThrust&gt;[6];
readonly List&lt;IMyGyro&gt; gyros = new List&lt;IMyGyro&gt;();
readonly double[] gMax = new double[6];
readonly Vector3D[] gDir = new Vector3D[6];
public Vector3D Pos, Vel, Grav, Dist;
public double Mass = 1, MaxAccel;
public bool HasThrust, UseObserver = true, Freeze;
public double Kv = 2.5, Kp = 0.8, BrakeSafety = 0.6, GyroGain = 3, GyroMax = 3, SpeedCap = 100;
public float GyroSign = -1;
Vector3D lastVel, lastCmdAccel;
bool haveLast, thrusting;
public Flight() { for (int i = 0; i &lt; 6; i++) grp[i] = new List&lt;IMyThrust&gt;(); }
public void Bind(IMyShipController ctl, List&lt;IMyThrust&gt; thr, List&lt;IMyGyro&gt; gy)
{
Ctl = ctl;
for (int i = 0; i &lt; 6; i++) grp[i].Clear();
foreach (var t in thr) grp[(int)t.Orientation.Forward].Add(t);
gyros.Clear();
gyros.AddRange(gy);
}
public void Sense(double dt)
{
Pos = Ctl.CenterOfMass;
Vel = Ctl.GetShipVelocities().LinearVelocity;
Grav = Ctl.GetNaturalGravity();
Mass = Math.Max(1, Ctl.CalculateShipMass().PhysicalMass);
MatrixD gm = Ctl.CubeGrid.WorldMatrix;
HasThrust = false; MaxAccel = 0;
for (int i = 0; i &lt; 6; i++)
{
Vector3D v = Base6Directions.GetVector((Base6Directions.Direction)i);
gDir[i] = -Vector3D.TransformNormal(v, gm);
double sum = 0;
foreach (var t in grp[i]) if (!t.Closed &amp;&amp; t.IsFunctional &amp;&amp; t.Enabled) sum += t.MaxEffectiveThrust;
gMax[i] = sum;
if (sum &gt; 0) { HasThrust = true; MaxAccel = Math.Max(MaxAccel, sum / Mass); }
}
if (thrusting &amp;&amp; haveLast &amp;&amp; UseObserver &amp;&amp; !Freeze &amp;&amp; dt &gt; 0)
{
Vector3D err = (Vel - lastVel) / dt - (lastCmdAccel + Grav);
Dist += (err - Dist) * (1 - Math.Exp(-dt / 0.8));
double l = Dist.Length();
if (l &gt; 6) Dist *= 6 / l;
}
lastVel = Vel; haveLast = true;
}
public double AccelAlong(Vector3D w)
{
double k = double.MaxValue; bool any = false;
for (int i = 0; i &lt; 6; i++)
{
double c = Vector3D.Dot(gDir[i], w);
if (c &lt; 0.2) continue;
any = true;
k = Math.Min(k, gMax[i] / Mass / c);
}
return any ? k : 0;
}
public void Engage()
{
if (Ctl.DampenersOverride) Ctl.DampenersOverride = false;
thrusting = true; haveLast = false; Dist = Vector3D.Zero;
}
public void Release(bool dampeners)
{
for (int i = 0; i &lt; 6; i++) foreach (var t in grp[i]) if (t.ThrustOverridePercentage != 0) t.ThrustOverridePercentage = 0;
foreach (var g in gyros) if (g.GyroOverride) { g.Pitch = 0; g.Yaw = 0; g.Roll = 0; g.GyroOverride = false; }
if (Ctl != null &amp;&amp; Ctl.DampenersOverride != dampeners) Ctl.DampenersOverride = dampeners;
thrusting = false; haveLast = false; Dist = Vector3D.Zero;
}
public void Thrust(Vector3D accel)
{
if (Ctl.DampenersOverride) Ctl.DampenersOverride = false;
Vector3D F = (accel - Grav - (UseObserver ? Dist : Vector3D.Zero)) * Mass;
Vector3D got = Vector3D.Zero;
for (int i = 0; i &lt; 6; i++)
{
double frac = 0;
if (gMax[i] &gt; 0)
{
double c = Vector3D.Dot(F, gDir[i]);
if (c &gt; 0) frac = Math.Min(1, c / gMax[i]);
}
got += gDir[i] * (frac * gMax[i]);
float f = (float)frac;
foreach (var t in grp[i]) if (Math.Abs(t.ThrustOverridePercentage - f) &gt; 0.002f) t.ThrustOverridePercentage = f;
}
lastCmdAccel = got / Mass;
}
public void FlyTo(Vector3D target, Vector3D tVel, double maxSpeed)
{
Vector3D err = target - Pos;
double d = err.Length();
Vector3D want = tVel;
if (d &gt; 0.01)
{
Vector3D dir = err / d;
double brake = Math.Max(0.3, (AccelAlong(-dir) + Vector3D.Dot(Grav, -dir)) * BrakeSafety);
double v = Math.Min(maxSpeed, Math.Min(Math.Sqrt(2 * brake * d), Kp * d));
want += dir * v;
}
double wl = want.Length();
if (wl &gt; SpeedCap) want *= SpeedCap / wl;
Thrust((want - Vel) * Kv);
}
public void Aim(MatrixD r, Vector3D fwd, Vector3D up)
{
fwd = Util.Norm(fwd);
if (fwd.LengthSquared() &lt; 0.5) return;
Vector3D f = r.Forward, u = r.Up;
Vector3D axis = Vector3D.Cross(f, fwd);
double s = axis.Length(), c = Vector3D.Dot(f, fwd);
Vector3D rot;
if (s &lt; 1e-6) rot = c &gt; 0 ? Vector3D.Zero : u * Math.PI;
else rot = axis / s * Math.Atan2(s, c);
if (up.LengthSquared() &gt; 0.01)
{
Vector3D upP = up - fwd * Vector3D.Dot(up, fwd);
if (upP.LengthSquared() &gt; 1e-4)
{
upP = Util.Norm(upP);
Vector3D ra = Vector3D.Cross(u, upP);
rot += f * (Math.Atan2(Vector3D.Dot(ra, f), Vector3D.Dot(u, upP)) * Math.Max(0, c));
}
}
Vector3D w = rot * GyroGain;
double wl = w.Length();
if (wl &gt; GyroMax) w *= GyroMax / wl;
foreach (var g in gyros)
{
if (g.Closed || !g.IsFunctional) continue;
Vector3D l = Vector3D.TransformNormal(w, MatrixD.Transpose(g.WorldMatrix));
float p = GyroSign * (float)l.X, y = GyroSign * (float)l.Y, ro = GyroSign * (float)l.Z;
if (Math.Abs(g.Pitch - p) &gt; 1e-3f) g.Pitch = p;
if (Math.Abs(g.Yaw - y) &gt; 1e-3f) g.Yaw = y;
if (Math.Abs(g.Roll - ro) &gt; 1e-3f) g.Roll = ro;
if (!g.GyroOverride) g.GyroOverride = true;
}
}
public static double AimError(MatrixD r, Vector3D fwd) { return Util.Angle(r.Forward, fwd); }
public void SetPower(bool on)
{
for (int i = 0; i &lt; 6; i++) foreach (var t in grp[i]) if (t.Enabled != on) t.Enabled = on;
foreach (var g in gyros) if (g.Enabled != on) g.Enabled = on;
}
}
static class Proto
{
public const int Version = 4;
public const int M_NAV = 1, M_HELLO = 2, M_STS = 3, M_ORD = 4, M_CON = 5, M_DES = 6;
public const int O_NONE = 0, O_REGISTER = 1, O_ESCORT = 2, O_HOLD = 3, O_GOTO = 4,
O_DOCK = 5, O_UNDOCK = 6, O_STOP = 7,
O_SEARCH = 8,
O_ATTACK = 9,
O_LOITER = 10,
O_INTERCEPT = 11;
public const int MODE_AUTO = 0, MODE_CARRIER = 1, MODE_BASE = 2;
public const int S_BOOT = 0, S_UNPROV = 1, S_REGISTERING = 2, S_IDLE = 3, S_HOLD = 4,
S_ESCORT = 5, S_GOTO = 6, S_APPROACH = 7, S_FINAL = 8, S_DOCKED = 9,
S_UNDOCKING = 10, S_LINKLOST = 11, S_ERROR = 12, S_PATROL = 13, S_ENGAGED = 14,
S_RECON = 15, S_ATTACK = 16, S_LOITER = 17, S_INTERCEPT = 18;
public const int F_DOCKED = 1, F_WANT_RTB = 2, F_LINKLOST = 4, F_NO_THRUST = 8, F_ARRIVED = 16,
F_ENGAGED = 32,
F_CONTACT = 64;
public const int ALERT_GREEN = 0, ALERT_YELLOW = 1, ALERT_RED = 2;
public const int JUMP_NONE = 0, JUMP_PREP = 1, JUMP_READY = 2;
public const int FAC_IDLE = 0, FAC_BUILDING = 1, FAC_SECURE = 2, FAC_RELEASE = 3, FAC_BAYBUSY = 4,
FAC_STALLED = 5, FAC_ERROR = 6, FAC_OFF = 7;
static readonly string[] facs = { "IDLE", "BUILDING", "SECURING", "RELEASING", "BAY BUSY", "WAITING PARTS", "ERROR", "OFF" };
public static string FactoryName(int s) { return s &gt;= 0 &amp;&amp; s &lt; facs.Length ? facs[s] : "?"; }
static readonly string[] states = { "BOOT", "UNPROV", "REGISTER", "IDLE", "HOLD", "ESCORT", "GOTO",
"APPROACH", "FINAL", "DOCKED", "UNDOCK", "NO LINK", "ERROR", "PATROL", "ENGAGED", "RECON", "ATTACK", "LOITER", "INTERCEPT" };
static readonly string[] orders = { "-", "REG", "ESCORT", "HOLD", "GOTO", "DOCK", "UNDOCK", "STOP", "SEARCH", "ATTACK", "LOITER", "INTERCEPT" };
static readonly string[] modes = { "AUTO", "CARRIER", "BASE" };
static readonly string[] alerts = { "GREEN", "YELLOW", "RED" };
public static string StateName(int s) { return s &gt;= 0 &amp;&amp; s &lt; states.Length ? states[s] : "?"; }
public static string OrderName(int o) { return o &gt;= 0 &amp;&amp; o &lt; orders.Length ? orders[o] : "?"; }
public static string ModeName(int m) { return m &gt;= 0 &amp;&amp; m &lt; modes.Length ? modes[m] : "?"; }
public static string AlertName(int a) { return a &gt;= 0 &amp;&amp; a &lt; alerts.Length ? alerts[a] : "?"; }
}
static class Util
{
public static int Hash(string s)
{
unchecked
{
uint h = 2166136261;
for (int i = 0; i &lt; s.Length; i++) { h ^= s[i]; h *= 16777619; }
return (int)h;
}
}
public static double Clamp(double v, double lo, double hi) { return v &lt; lo ? lo : (v &gt; hi ? hi : v); }
public static Vector3D Norm(Vector3D v)
{
double l = v.Length();
return l &gt; 1e-9 ? v / l : Vector3D.Zero;
}
public static Vector3D Perp(Vector3D v)
{
Vector3D p = Vector3D.Cross(v, Vector3D.Up);
if (p.LengthSquared() &lt; 1e-6) p = Vector3D.Cross(v, Vector3D.Right);
return Norm(p);
}
public static double Angle(Vector3D a, Vector3D b)
{
return Math.Acos(Clamp(Vector3D.Dot(Norm(a), Norm(b)), -1, 1));
}
public static bool ParseD(string s, out double v)
{
v = 0;
if (s == null) return false;
s = s.Trim();
if (s.Length == 0) return false;
int i = 0; bool neg = false;
if (s[0] == '-' || s[0] == '+') { neg = s[0] == '-'; i++; }
double ip = 0, fp = 0, scale = 1; bool digits = false, dot = false;
for (; i &lt; s.Length; i++)
{
char c = s[i];
if (c &gt;= '0' &amp;&amp; c &lt;= '9')
{
digits = true;
if (dot) { scale *= 0.1; fp += (c - '0') * scale; }
else ip = ip * 10 + (c - '0');
}
else if (c == '.' &amp;&amp; !dot) dot = true;
else return false;
}
if (!digits) return false;
v = neg ? -(ip + fp) : ip + fp;
return true;
}
public static bool ParseGps(string s, out Vector3D p, out string name)
{
p = Vector3D.Zero; name = "";
int i = s.IndexOf("GPS:");
if (i &lt; 0) return false;
string[] parts = s.Substring(i).Split(':');
if (parts.Length &lt; 5) return false;
double x, y, z;
if (!ParseD(parts[2], out x) || !ParseD(parts[3], out y) || !ParseD(parts[4], out z)) return false;
name = parts[1];
p = new Vector3D(x, y, z);
return true;
}
public static string Gps(string name, Vector3D p)
{
return "GPS:" + name + ":" + Num(p.X) + ":" + Num(p.Y) + ":" + Num(p.Z) + ":";
}
public static string Num(double v)
{
long cents = (long)Math.Round(v * 100);
string sign = cents &lt; 0 ? "-" : "";
cents = Math.Abs(cents);
return sign + (cents / 100) + "." + (cents % 100).ToString("00");
}
public static string Pct(float f) { return f &lt; 0 ? "--" : ((int)Math.Round(f * 100)) + "%"; }
public static string PctM(int milli) { return milli &lt; 0 ? "--" : ((milli + 5) / 10) + "%"; }
public static string Dist(double m)
{
if (m &lt; 1000) return ((int)m) + "m";
if (m &lt; 100000) return ((int)(m / 1000)) + "." + ((int)(m / 100) % 10) + "km";
return ((int)(m / 1000)) + "km";
}
public static string Age(int s)
{
if (s &lt; 60) return s + "s";
if (s &lt; 3600) return (s / 60) + "m";
return (s / 3600) + "h";
}
public static string Clean(string s) { return s == null ? "" : s.Replace('|', '/').Replace('\n', ' ').Replace('\r', ' '); }
public static int Milli(float f) { return f &lt; 0 ? -1 : (int)Math.Round(f * 1000); }
}
class Perf
{
public double Avg, Peak;
double peakT;
public void Tick(double ms, double now)
{
Avg += (ms - Avg) * 0.02;
if (ms &gt; Peak || now - peakT &gt; 10) { Peak = ms; peakT = now; }
}
public string Text()
{
return "Runtime avg " + Util.Num(Avg) + " ms (peak " + Util.Num(Peak) + ")" + (Avg &gt; 0.3 ? "  OVER BUDGET" : "");
}
}
class Cfg
{
readonly MyIni ini = new MyIni();
readonly IMyTerminalBlock blk;
readonly string sec;
bool dirty;
public string Error = "";
public Cfg(IMyTerminalBlock b, string section)
{
blk = b; sec = section;
MyIniParseResult r;
if (!ini.TryParse(b.CustomData, out r))
Error = "Custom Data error (line " + r.LineNo + "): " + r.Error + ". Fix it, then recompile.";
}
public string S(string k, string d)
{
if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
return ini.Get(sec, k).ToString(d);
}
public double D(string k, double d)
{
if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
return ini.Get(sec, k).ToDouble(d);
}
public int I(string k, int d)
{
if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
return ini.Get(sec, k).ToInt32(d);
}
public bool B(string k, bool d)
{
if (!ini.ContainsKey(sec, k)) { ini.Set(sec, k, d); dirty = true; }
return ini.Get(sec, k).ToBoolean(d);
}
public void Set(string k, string v)
{
MyIni fresh = new MyIni();
if (!fresh.TryParse(blk.CustomData)) return;
fresh.Set(sec, k, v);
blk.CustomData = fresh.ToString();
ini.Set(sec, k, v);
}
public void Save()
{
if (dirty &amp;&amp; Error.Length == 0) { blk.CustomData = ini.ToString(); dirty = false; }
}
}
class Net
{
public readonly IMyIntergridCommunicationSystem IGC;
public int NetId, KeyHash;
public string TNav = "", THello = "", TSts = "", TOrd = "", TCmd = "", TSnap = "", TFac = "", TFacSt = "", TCon = "", TDes = "";
public Net(IMyIntergridCommunicationSystem igc) { IGC = igc; }
public void Configure(int netId, string key)
{
NetId = netId;
KeyHash = Util.Hash(key ?? "");
string p = "FS" + netId + "/";
TNav = p + "nav"; THello = p + "hello"; TSts = p + "sts"; TOrd = p + "ord";
TCmd = p + "cmd"; TSnap = p + "snap"; TFac = p + "fac"; TFacSt = p + "facst"; TCon = p + "con"; TDes = p + "des";
}
MyTuple&lt;int, int, int, int, long&gt; Hdr(int type, long seq)
{
return new MyTuple&lt;int, int, int, int, long&gt;(Proto.Version, NetId, KeyHash, type, seq);
}
bool Ok(MyTuple&lt;int, int, int, int, long&gt; h, int type)
{
return h.Item1 == Proto.Version &amp;&amp; h.Item2 == NetId &amp;&amp; h.Item3 == KeyHash &amp;&amp; h.Item4 == type;
}
public void SendNav(Vector3D pos, Vector3D vel, Vector3D fwd, Vector3D up, Vector3D ang,
Vector3D koc, double kor, int mode, int alert, double phase, double rate, Vector3D boxC, Vector3D boxH)
{
IGC.SendBroadcastMessage(TNav,
new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;(
Hdr(Proto.M_NAV, 0),
new MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;(pos, vel, fwd, up, ang),
new MyTuple&lt;Vector3D, double, int, int, double, double&gt;(koc, kor, mode, alert, phase, rate),
new MyTuple&lt;Vector3D, Vector3D&gt;(boxC, boxH)));
}
public bool ReadNav(MyIGCMessage m, HubFrame f)
{
if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;)) return false;
var n = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;Vector3D, Vector3D, Vector3D, Vector3D, Vector3D&gt;, MyTuple&lt;Vector3D, double, int, int, double, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;)m.Data;
if (!Ok(n.Item1, Proto.M_NAV)) return false;
f.Pos = n.Item2.Item1; f.Vel = n.Item2.Item2; f.Fwd = n.Item2.Item3; f.Up = n.Item2.Item4; f.AngVel = n.Item2.Item5;
f.KoC = n.Item3.Item1; f.KoR = n.Item3.Item2; f.Mode = n.Item3.Item3; f.Alert = n.Item3.Item4;
f.Phase = n.Item3.Item5; f.Rate = n.Item3.Item6;
f.BoxC = n.Item4.Item1; f.BoxH = n.Item4.Item2;
f.Valid = true;
return true;
}
public void SendHello(string role, long caps, double maxAccel, double maxSpeed, string grid)
{
IGC.SendBroadcastMessage(THello,
new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;(
Hdr(Proto.M_HELLO, 0),
new MyTuple&lt;string, long, double, double, string&gt;(role, caps, maxAccel, maxSpeed, grid)));
}
public bool ReadHello(MyIGCMessage m, out string role, out long caps, out double maxAccel, out double maxSpeed, out string grid)
{
role = grid = ""; caps = 0; maxAccel = maxSpeed = 0;
if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;)) return false;
var h = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, long, double, double, string&gt;&gt;)m.Data;
if (!Ok(h.Item1, Proto.M_HELLO)) return false;
role = h.Item2.Item1; caps = h.Item2.Item2; maxAccel = h.Item2.Item3; maxSpeed = h.Item2.Item4; grid = h.Item2.Item5;
return true;
}
public bool SendStatus(long hub, string role, int state, int task, long ack, long dockId,
Vector3D pos, Vector3D vel, float batt, float h2, float cargo, float integ, float ammo, int flags)
{
return IGC.SendUnicastMessage(hub, TSts,
new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;(
Hdr(Proto.M_STS, 0),
new MyTuple&lt;string, int, int, long, long&gt;(role, state, task, ack, dockId),
new MyTuple&lt;Vector3D, Vector3D&gt;(pos, vel),
new MyTuple&lt;float, float, float, float, float, int&gt;(batt, h2, cargo, integ, ammo, flags)));
}
public bool ReadStatus(MyIGCMessage m, out MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt; s)
{
s = default(MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;);
if (m.Tag != TSts) return false;
if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;)) return false;
s = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;string, int, int, long, long&gt;, MyTuple&lt;Vector3D, Vector3D&gt;, MyTuple&lt;float, float, float, float, float, int&gt;&gt;)m.Data;
return Ok(s.Item1, Proto.M_STS);
}
public bool SendOrder(long to, long seq, int code, Vector3D a, Vector3D b, Vector3D c, long id, string text)
{
return IGC.SendUnicastMessage(to, TOrd,
new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;(
Hdr(Proto.M_ORD, seq),
new MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;(code, a, b, c, id, text ?? "")));
}
public bool ReadOrder(MyIGCMessage m, out long seq, out int code, out Vector3D a, out Vector3D b, out Vector3D c, out long id, out string text)
{
seq = 0; code = 0; a = b = c = Vector3D.Zero; id = 0; text = "";
if (m.Tag != TOrd) return false;
if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;)) return false;
var o = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;int, Vector3D, Vector3D, Vector3D, long, string&gt;&gt;)m.Data;
if (!Ok(o.Item1, Proto.M_ORD)) return false;
seq = o.Item1.Item5; code = o.Item2.Item1; a = o.Item2.Item2; b = o.Item2.Item3; c = o.Item2.Item4;
id = o.Item2.Item5; text = o.Item2.Item6;
return true;
}
public bool SendContact(long hub, long id, int type, double size, Vector3D pos, Vector3D vel)
{
return IGC.SendUnicastMessage(hub, TCon,
new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;long, int, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;(
Hdr(Proto.M_CON, 0), new MyTuple&lt;long, int, double&gt;(id, type, size), new MyTuple&lt;Vector3D, Vector3D&gt;(pos, vel)));
}
public bool ReadContact(MyIGCMessage m, out long id, out int type, out double size, out Vector3D pos, out Vector3D vel)
{
id = 0; type = 0; size = 0; pos = vel = Vector3D.Zero;
if (m.Tag != TCon || !(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;long, int, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;)) return false;
var c = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;long, int, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;)m.Data;
if (!Ok(c.Item1, Proto.M_CON)) return false;
id = c.Item2.Item1; type = c.Item2.Item2; size = c.Item2.Item3; pos = c.Item3.Item1; vel = c.Item3.Item2;
return true;
}
public void SendDesignation(long id, double size, Vector3D pos, Vector3D vel)
{
IGC.SendBroadcastMessage(TDes,
new MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;long, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;(
Hdr(Proto.M_DES, 0), new MyTuple&lt;long, double&gt;(id, size), new MyTuple&lt;Vector3D, Vector3D&gt;(pos, vel)));
}
public bool ReadDesignation(MyIGCMessage m, out long id, out double size, out Vector3D pos, out Vector3D vel)
{
id = 0; size = 0; pos = vel = Vector3D.Zero;
if (!(m.Data is MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;long, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;)) return false;
var d = (MyTuple&lt;MyTuple&lt;int, int, int, int, long&gt;, MyTuple&lt;long, double&gt;, MyTuple&lt;Vector3D, Vector3D&gt;&gt;)m.Data;
if (!Ok(d.Item1, Proto.M_DES)) return false;
id = d.Item2.Item1; size = d.Item2.Item2; pos = d.Item3.Item1; vel = d.Item3.Item2;
if (id == 0) id = -2;
return true;
}
}
class HubFrame
{
public Vector3D Pos, Vel, Fwd = Vector3D.Forward, Up = Vector3D.Up, AngVel, KoC;
public Vector3D BoxC, BoxH;
public double KoR, Phase, Rate;
public int Mode, Alert;
public double T = -1e9;
public bool Valid;
public MatrixD Matrix(double now)
{
double dt = Util.Clamp(now - T, 0, 2);
return MatrixD.CreateWorld(Pos + Vel * dt, Fwd, Up);
}
public Vector3D KeepOut(double now)
{
return KoC + Vel * Util.Clamp(now - T, 0, 2);
}
public double PhaseAt(double now) { return Phase + Rate * Util.Clamp(now - T, 0, 2); }
public static Vector3D RotY(Vector3D v, double a)
{
double c = Math.Cos(a), s = Math.Sin(a);
return new Vector3D(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c);
}
public Vector3D VelAt(Vector3D world, MatrixD m)
{
return Vel + Vector3D.Cross(AngVel, world - m.Translation);
}
public static Vector3D ToWorld(MatrixD m, Vector3D local) { return m.Translation + Vector3D.TransformNormal(local, m); }
public static Vector3D ToLocal(MatrixD m, Vector3D world) { return Vector3D.TransformNormal(world - m.Translation, MatrixD.Transpose(m)); }
public static Vector3D DirToWorld(MatrixD m, Vector3D d) { return Vector3D.TransformNormal(d, m); }
public static Vector3D DirToLocal(MatrixD m, Vector3D d) { return Vector3D.TransformNormal(d, MatrixD.Transpose(m)); }
}
class Telemetry
{
public readonly List&lt;IMyBatteryBlock&gt; Bats = new List&lt;IMyBatteryBlock&gt;();
readonly List&lt;IMyGasTank&gt; h2 = new List&lt;IMyGasTank&gt;();
readonly List&lt;IMyTerminalBlock&gt; inv = new List&lt;IMyTerminalBlock&gt;();
readonly List&lt;IMyTerminalBlock&gt; guns = new List&lt;IMyTerminalBlock&gt;();
readonly List&lt;IMyTerminalBlock&gt; all = new List&lt;IMyTerminalBlock&gt;();
public int Baseline;
public float Batt = -1, H2 = -1, Cargo = -1, Integ = 1, Ammo = -1;
public void Bind(List&lt;IMyTerminalBlock&gt; blocks)
{
Bats.Clear(); h2.Clear(); inv.Clear(); all.Clear(); guns.Clear();
foreach (var b in blocks)
{
all.Add(b);
var bat = b as IMyBatteryBlock;
if (bat != null) { Bats.Add(bat); continue; }
var tank = b as IMyGasTank;
if (tank != null)
{
if (b.BlockDefinition.SubtypeName.Contains("Hydrogen") || b.DefinitionDisplayNameText.Contains("Hydrogen")) h2.Add(tank);
continue;
}
if (b is IMyUserControllableGun &amp;&amp; b.HasInventory) { guns.Add(b); continue; }
if (b is IMyCargoContainer &amp;&amp; b.HasInventory) inv.Add(b);
}
if (all.Count &gt; Baseline) Baseline = all.Count;
}
public void Read()
{
double cur = 0, max = 0;
foreach (var b in Bats) if (!b.Closed &amp;&amp; b.IsFunctional) { cur += b.CurrentStoredPower; max += b.MaxStoredPower; }
Batt = max &gt; 0 ? (float)(cur / max) : -1;
cur = 0; max = 0;
foreach (var t in h2) if (!t.Closed &amp;&amp; t.IsFunctional) { cur += t.FilledRatio * t.Capacity; max += t.Capacity; }
H2 = max &gt; 0 ? (float)(cur / max) : -1;
cur = 0; max = 0;
foreach (var b in inv)
{
if (b.Closed) continue;
var i = b.GetInventory(0);
cur += (float)i.CurrentVolume; max += (float)i.MaxVolume;
}
Cargo = max &gt; 0 ? (float)(cur / max) : -1;
cur = 0; max = 0;
foreach (var b in guns)
{
if (b.Closed) continue;
var i = b.GetInventory(0);
cur += (float)i.CurrentVolume; max += (float)i.MaxVolume;
}
Ammo = max &gt; 0 ? (float)(cur / max) : -1;
int ok = 0;
foreach (var b in all) if (!b.Closed &amp;&amp; b.IsFunctional) ok++;
Integ = Baseline &gt; 0 ? (float)ok / Baseline : 1;
}
}
class Wc
{
Action&lt;IMyTerminalBlock, IDictionary&lt;MyDetectedEntityInfo, float&gt;&gt; threats;
Func&lt;long, int, MyDetectedEntityInfo&gt; focus;
public bool Ok;
readonly Dictionary&lt;MyDetectedEntityInfo, float&gt; buf = new Dictionary&lt;MyDetectedEntityInfo, float&gt;();
public void Init(IMyTerminalBlock me)
{
try
{
var p = me.GetProperty("WcPbAPI");
var d = p == null ? null : p.As&lt;IReadOnlyDictionary&lt;string, Delegate&gt;&gt;().GetValue(me);
if (d == null) return;
Delegate x;
if (d.TryGetValue("GetSortedThreats", out x)) threats = x as Action&lt;IMyTerminalBlock, IDictionary&lt;MyDetectedEntityInfo, float&gt;&gt;;
if (d.TryGetValue("GetAiFocus", out x)) focus = x as Func&lt;long, int, MyDetectedEntityInfo&gt;;
Ok = threats != null || focus != null;
}
catch { Ok = false; }
}
public Dictionary&lt;MyDetectedEntityInfo, float&gt; Threats(IMyTerminalBlock me)
{
buf.Clear();
if (threats != null) try { threats(me, buf); } catch { }
return buf;
}
public MyDetectedEntityInfo Focus(long grid)
{
if (focus != null) try { return focus(grid, 0); } catch { }
return new MyDetectedEntityInfo();
}
}
